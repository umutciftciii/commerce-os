// Faz 1B (ADR-067) — Attribute katalog cekirdegi. scope AttributeDefinition'in
// PLATFORM (tum magazalar, storeId null) mi yoksa STORE (tek magaza, storeId zorunlu)
// mu oldugunu belirler. Yetki: PLATFORM yalniz SUPER_ADMIN; STORE ilgili store admin.
enum AttributeScope {
  PLATFORM
  STORE
}

// Faz 1B (ADR-067) — Desteklenen attribute veri tipleri. dataType kullanim
// basladiktan sonra IMMUTABLE (service guard); value tablolari bu fazda YOK.
enum AttributeDataType {
  TEXT
  TEXTAREA
  RICH_TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  URL
  SELECT
  MULTI_SELECT
  COLOR
  IMAGE
  FILE
}

// Faz 1B (ADR-067) — AttributeDefinition + AttributeOption yasam durumu. ARCHIVED
// tanim/secenek yeni CategoryAttribute baglamasinda REDDEDILIR (ProductCategoryStatus
// deseniyle ayni). Silme YOK; arsivleme ile emekli edilir.
enum AttributeStatus {
  ACTIVE
  ARCHIVED
}

// ADR-065 — Site-geneli gorsel yonetimi. MediaAsset'in hangi baglamda uretildigini
// tutar; storageKey path segmenti de bundan turer (products/categories/hero/branding).
enum MediaContext {
  PRODUCT
  CATEGORY
  HERO
  BRANDING
  // TODO-169 (ADR-269) — Müşteri iade fotoğraf kanıtı. PRIVATE: bu context'teki asset'ler
  // public `/media/*` static handler'ından SUNULMAZ; yalnız auth-gate'li iade attachment
  // route'undan (sahip müşteri veya store admin) stream edilir. Non-enumerable storage key.
  RETURN_ATTACHMENT
  // TODO-177 (ADR-289) — Ürün Desteği ticket eki (foto/PDF). PRIVATE (RETURN_ATTACHMENT deseni):
  // public `/media/*`'ten SUNULMAZ; yalnız auth-gate'li support attachment route'undan
  // (sahip müşteri ya da store admin) stream edilir. PDF: sharp/webp pipeline'ı ATLANIR.
  SUPPORT_ATTACHMENT
  // TODO-178 — Store→Platform request eki (foto/PDF). PRIVATE (SUPPORT_ATTACHMENT deseni):
  // public `/media/*`'ten SUNULMAZ; yalnız auth-gate'li platform-request attachment route'undan
  // stream edilir. STORE_VISIBLE / INTERNAL görünürlük mesaj/ek düzeyinde uygulanır.
  PLATFORM_REQUEST_ATTACHMENT
}

