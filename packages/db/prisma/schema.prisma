// TODO-159F (ADR-095) — Order Payment Recovery state machine. Genişletilmiş sipariş
// ödeme durumu; tek otorite `payments/payment-state.ts` modülüdür.
//   UNPAID            : ödeme bekliyor (yeni tahsilat başlatılabilir).
//   PAYMENT_PENDING   : aktif online ödeme oturumu açık (link/session üretildi).
//   AUTHORIZED        : yetkilendirildi (capture bekliyor); shipment için ödenmiş sayılır.
//   PAID              : tam tahsil edildi (terminal; yeni tahsilat YOK).
//   PARTIALLY_REFUNDED: kısmen iade (kalan tahsilat mantığı MVP'de yok; iade tarafı).
//   REFUNDED          : tümü iade edildi (terminal; yeni tahsilat YOK).
//   PAYMENT_FAILED    : son deneme başarısız (yeniden tahsilat başlatılabilir).
//   CANCELLED         : ödeme iptal edildi (terminal; yeni tahsilat YOK).
enum PaymentStatus {
  UNPAID
  PAYMENT_PENDING
  AUTHORIZED
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  PAYMENT_FAILED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  CANCELLED
}

