  priceVisibility          ProductPriceVisibility @default(VISIBLE)
  primaryAction            ProductPrimaryAction   @default(ADD_TO_CART)
  inquiryEnabled           Boolean                @default(false)
  appointmentRequired      Boolean                @default(false)
  whatsappEnabled          Boolean                @default(false)
  purchasable              Boolean                @default(true)
  minOrderQuantity         Int                    @default(1)
  maxOrderQuantity         Int?
  callToActionLabel        String?
  whatsappMessageTemplate  String?
  inquiryFormTitle         String?
  appointmentNote          String?
  // F3C.2 — Kargo olcumu (desi/agirlik). Varyant uzerindeki ayni alanlar onceliklidir;
  // burasi urun-seviyesi fallback. DESI_TABLE/WEIGHT_TABLE tarifelerinde eksikse
  // hesaplama MISSING_SHIPPING_DIMENSIONS doner (admin UI TODO-110).
  shippingWeightKg         Decimal?               @db.Decimal(10, 3)
  shippingDesi             Decimal?               @db.Decimal(10, 2)
  // Faz 1A (ADR-067) — Urunun TEK ana kategorisi. Ileriki dinamik attribute
  // semasinin, breadcrumb'in ve kanonik kategori URL'inin KAYNAGIDIR. M:N
  // `assignments` (ikincil siniflandirma/merchandising) KORUNUR; ana kategori
  // mutlaka assignments'tan biri olmalidir (service transaction guard — DB tek
  // basina garanti edemez). Nullable: legacy/kategorisiz urun null kalir; ilk
  // migration'da NOT NULL YOK. onDelete: Restrict → ana kategori fiziksel silinemez.
  primaryCategoryId        String?
  // Faz 2C-7 (ADR-078) — Variant Media Engine. Bu urunun gorsellerini gruplayan TEK
  // media-tanimlayici eksen (genelde Renk). null = klasik urun galerisi (backward compat:
  // tum gorseller etiketsiz tek grup = bugunku davranis). Yalniz SELECT/COLOR variant-defining
  // eksen secilebilir (service guard). onDelete: SetNull → eksen tanimini silmek galeriyi
  // klasik moda dusurur (gorsel kaybi YOK; etiketler ProductImage'da Restrict ile korunur).
  mediaDefiningAttributeId String?
  // TODO-165A (ADR-254) — Governed marka (Brand) referansi. Nullable: legacy/markasiz urun null
  // kalir; eski serbest-metin `brand` sutunu KORUNUR (dormant, gostergesel — yeni yazma yolu
  // buradan gecmez). onDelete: SetNull → marka silinince urun markasiz kalir, urun SILINMEZ.
  // NOT: iliski alani `governedBrand` adiyla tutulur — mevcut skaler `brand String?` sutunuyla
  // Prisma alan adi cakismasini onlemek icin (ikisi de ayni modelde bulunamaz).
  brandId                  String?
  // TODO-177 (ADR-289) — Ürün Desteği garanti süresi (ay). Nullable = garanti gating YOK
  // (warranty/servis topic'i yine escalate edilebilir; dead-end yok). ProductVariant.warrantyMonths
  // override eder. warrantyEndsAt = teslim-ankoru + ay (ticket açılışında snapshot; ADR-289 §7).
  warrantyMonths           Int?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  store                  Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  primaryCategory        ProductCategory?            @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  mediaDefiningAttribute AttributeDefinition?        @relation("ProductMediaAxis", fields: [mediaDefiningAttributeId], references: [id], onDelete: SetNull)
  governedBrand          Brand?                      @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants               ProductVariant[]
  assignments            ProductCategoryAssignment[]
  orderLines             OrderLine[]
  campaignProducts       CampaignProduct[]
  images                 ProductImage[]
  // Faz 2A (ADR-068) — urun-seviyesi (non-variantDefining) attribute degerleri.
  attributeValues        ProductAttributeValue[]
  // Faz 2C-1 (ADR-070) — bu urun icin secilen variant-defining eksenler (henuz KOMBINASYON DEGIL).
  variantAttributes      ProductVariantAttribute[]
  // TODO-150 (ADR-073) — bu urunun varyantlarina uygulanan Identity Engine bulk-apply audit satirlari.
  identityChanges        VariantIdentityChange[]
  // TODO-151 (ADR-074) — bu urunun varyantlarina uygulanan Commercial Engine bulk-apply audit satirlari.
  commercialChanges      VariantCommercialChange[]
  // TODO-152 (ADR-076) — bu urunun varyantlarina uygulanan Inventory Engine duzeltme defteri satirlari.
  inventoryAdjustments   InventoryAdjustment[]
  // Faz 2C-8A (ADR-079) — Search read-model (turetilmis). Cascade → urun silinince dokuman + facet
  // satirlari otomatik temizlenir (worker remove-job'a ek DB-seviyesi guvence; orphan olmaz).
  searchDocument         ProductSearchDocument?
  searchFacetValues      ProductFacetValue[]
  // TODO-158A (ADR-086) — Home Experience: bu ürünü MANUEL showcase'te tutan girdiler
  // (onDelete: Cascade → ürün silinince manuel seçim otomatik kalkar).
  homeShowcaseIn         HomeShowcaseProduct[]
  // TODO-159D (ADR-093) — Customer Lists & Wishlist: bu ürünü içeren liste öğeleri.
  // onDelete: Cascade → ürün FİZİKSEL silinince öğe kalkar (soft-archive'de öğe KORUNUR,
  // liste detayı canlı hidrasyonla UNAVAILABLE gösterir). Bkz. ADR-093 §FK kararı.
  customerListItems      CustomerListItem[]
  // TODO-159E (ADR-094) — Ürün yorumları + rating aggregate projection (1-1).
  reviews                ProductReview[]
  ratingAggregate        ProductRatingAggregate?
  // TODO-160 (ADR-102) — Ürün hedefli takip linkleri (ürün silinince SetNull).
  trackingLinks          InfluencerTrackingLink[]
  // TODO-161 (ADR-114) — Sponsorlu yerleşim placement'ları + attribution (ürün silinince Cascade/SetNull).
  sponsoredPlacements    SponsoredProductPlacement[]
  // TODO-161B (ADR-137) — Recently Viewed geçmiş satırları (ürün FİZİKSEL silinince Cascade → orphan olmaz).
  recentlyViewedBy       RecentlyViewedProduct[]
  // TODO-165 Fashion Vertical (ADR-249) — urun scope'lu size chart atamalari.
  sizeChartAssignments   SizeChartAssignment[]       @relation("SizeChartProduct")
  // TODO-177 (ADR-289) — bu ürün için açılan destek ticket'ları (onDelete: Restrict → geçmiş
  // ticket ürünü pinler; ürün fiziksel silinemez).
  supportTickets         SupportTicket[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([status])
  @@index([salesMode])
  @@index([purchasable])
  // Faz 1A (ADR-067) — store-scoped ana-kategori sorgulari + FK restrict tarama.
  @@index([storeId, primaryCategoryId])
  // TODO-159A (ADR-089) — Admin Data Grid varsayilan yolu: store-scoped + createdAt
  // siralamasi + LIMIT/OFFSET. Bilesik index hem WHERE hem ORDER BY'i tek erisimle
  // karsilar (aksi halde her sayfa icin ayri sort adimi gerekir).
  @@index([storeId, createdAt])
  // TODO-165A (ADR-254) — marka-bazli store-scoped filtreleme/listeleme.
  @@index([storeId, brandId])
}

model ProductVariant {
  id               String                  @id @default(cuid())
  productId        String
  storeId          String
  title            String
  sku              String
  barcode          String?
  priceMinor       Int
  compareAtMinor   Int?
  // F4B — Maliyet (minor). Satis fiyati (priceMinor) DEGISMEZ; checkout bunu tahsil eder.
  // costMinor yalnizca ic marj/kar hesabi icindir, ASLA public API'ye sizmaz.
  // Kural: costMinor <= (compareAtMinor ?? priceMinor) (liste/showroom tavani).
  costMinor        Int?
  // F4C (ADR-063) — KDV alanlari. priceMinor KDV DAHIL brut satis fiyati olarak
  // KALIR (vitrin/sepet/checkout sifir-regresyon); admin artik KDV HARIC net
  // fiyati girer, sunucu vat = round(net*bps/10000), brut = net+vat hesaplar ve
  // priceMinor'a yazar. Backfill: net = round(brut*10000/(10000+bps)) — mevcut
  // brut GORUNEN fiyatlar birebir korunur. vatRateBps: 2000=%20, 1000=%10,
  // 100=%1, 0=%0.
  netPriceMinor    Int?
  vatRateBps       Int                     @default(2000)
  vatAmountMinor   Int?
  currency         String
  status           ProductVariantStatus    @default(ACTIVE)
  optionValues     Json?
  // Faz 2C-3 (ADR-072) — Varyant kaynagi + kalici kanonik kombinasyon kimligi + soft-archive damgasi.
  // generationSource: MANUAL (default; mevcut/legacy varyantlar) veya ATTRIBUTE_COMBINATION (uretilmis).
  // combinationKey: yalniz uretilmis varyantta dolu (v1|attrId:optId|...); manuel varyantta null.
  //   @@unique([productId, combinationKey]) — Postgres NULL-distinct: coklu manuel null cakismaz,
  //   uretilmis non-null key ayni urun altinda tektir (concurrency insert-conflict temeli).
  // archivedAt: recetede olmayan uretilmis varyant arsivlendiginde (status=ARCHIVED) set edilir; audit.
  generationSource VariantGenerationSource @default(MANUAL)
  // TODO-160A (ADR-110) — SKU governance kaynagi (AUTO/MANUAL/IMPORTED). Additive; default MANUAL
  // (mevcut satirlar icin guvenli — otomatik regenerate onlari EZMEZ). sku ile @@unique([storeId, sku])
  // DEGISMEDI; bu alan yalniz "kim yazdi" gozlemlenebilirligi + regenerate korumasi icindir.
  skuSource        SkuSource               @default(MANUAL)
  combinationKey   String?
  archivedAt       DateTime?
  // TODO-150 (ADR-073) — Identity Management Engine. titleIsCustom: baslik motor-yonetimli mi (false;
  // Identity Engine yeniden uretebilir) yoksa kullanici-yazimi/korumali mi (true). Varyant PATCH
  // `title` verilince true isaretler; Identity title-apply true'yu (regenerateCustomTitles olmadan)
  // ATLAR → "Title override edilirse yeniden generate edilmemeli". Default false: additive/geriye-uyumlu
  // (mevcut varyantlarin gorunen basligi degismez; yalnizca acik bir apply preview-gate'li yazar).
  titleIsCustom    Boolean                 @default(false)
  // F3C.2 — Kargo olcumu (desi/agirlik); urun-seviyesi degerleri override eder.
  shippingWeightKg Decimal?                @db.Decimal(10, 3)
  shippingDesi     Decimal?                @db.Decimal(10, 2)
  // TODO-177 (ADR-289) — Varyant-seviyesi garanti süresi (ay) override'ı. null → Product.warrantyMonths'a düşer.
  warrantyMonths   Int?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  product               Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  store                 Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventory             InventoryItem?
  movements             InventoryMovement[]
  orderLines            OrderLine[]
  reservations          InventoryReservation[]
  // Faz 2A (ADR-068) — variantDefining attribute degerleri (yalniz valueText/optionId).
  attributeValues       VariantAttributeValue[]
  // Faz 2C-3 (ADR-072) — uretilmis varyantin cozulmus eksen->option secimi (normalize; combinationKey ile
  // tutarli). Manuel varyantta bos kalir (attributeValues 2A ile karistirilmaz — ayri yazma otoritesi).
  optionValueSelections ProductVariantOptionValue[]
  // TODO-150 (ADR-073) — Identity Management Engine bulk-apply audit'i (append-only; undo metadata).
  identityChanges       VariantIdentityChange[]
  // TODO-151 (ADR-074) — Commercial Engine bulk-apply audit'i (append-only; undo metadata).
  commercialChanges     VariantCommercialChange[]
  // TODO-152 (ADR-076) — Inventory Engine: warehouse-aware bakiye + append-only duzeltme defteri.
  inventoryBalances     InventoryBalance[]
  inventoryAdjustments  InventoryAdjustment[]
  // TODO-159D (ADR-093) — Customer Lists & Wishlist: bu varyanti iceren varyant-ozel liste ogeleri.
  // onDelete: Cascade → varyant FIZIKSEL silinince oge kalkar (butun-urun ogesi variantId=NULL etkilenmez).
  customerListItems     CustomerListItem[]
  // TODO-159E (ADR-094) — bu varyant BAGLAMINDA yazilmis yorumlar (SetNull → varyant silinince yorum yasar).
  reviews               ProductReview[]
  // TODO-167 (ADR-266) — Persistent cart satirlari (onDelete: Cascade → varyant silinince cart satiri kalkar).
  cartLines             CartLine[]
  // TODO-177 (ADR-289) — bu varyant bağlamında açılan destek ticket'ları (onDelete: Restrict).
  supportTickets        SupportTicket[]

  @@unique([storeId, sku])
  // Faz 2C-3 (ADR-072) — ayni urunde ayni kombinasyon tek varyant (NULL-distinct: manuel null serbest).
  @@unique([productId, combinationKey])
  @@index([productId])
  @@index([storeId])
  @@index([status])
  // TODO-159C (ADR-092) — Inventory Matrix taramasinin birincil filtresi (storeId + status<>ARCHIVED).
  // 50k+ varyantta taranan kumeyi daraltir; additive (mevcut sorgular etkilenmez).
  @@index([storeId, status])
}

// F4B — Kampanya-disi fiyat/liste/maliyet degisikligi audit'i (append-only).
// EU Omnibus "son 30 gunun en dusuk fiyati" gosteriminin veri temeli.
// changedByPlatformUserId FK degil, dogrudan scalar: kullanici silinse bile
// tarihsel kayit korunur. storeId/variantId indexli sorgu icin tutulur.
enum PriceChangeSource {
  ADMIN_EDIT
  IMPORT
  API
}

model ProductPriceChange {
  id                      String            @id @default(cuid())
  storeId                 String
  productId               String
  variantId               String
  changedByPlatformUserId String?
  currency                String
  oldPriceMinor           Int?
  newPriceMinor           Int?
  oldCompareAtMinor       Int?
  newCompareAtMinor       Int?
  oldCostMinor            Int?
  newCostMinor            Int?
  source                  PriceChangeSource @default(ADMIN_EDIT)
  reason                  String?
  createdAt               DateTime          @default(now())

  @@index([storeId, variantId, createdAt])
  @@index([storeId, createdAt])
}

model ProductCategory {
  id        String                @id @default(cuid())
  storeId   String
  name      String
  slug      String
  parentId  String?
  sortOrder Int                   @default(0)
  status    ProductCategoryStatus @default(ACTIVE)
  imageId   String? // ADR-065 — opsiyonel tekil kategori gorseli
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  store                Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent               ProductCategory?            @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children             ProductCategory[]           @relation("ProductCategoryTree")
  assignments          ProductCategoryAssignment[]
  // Faz 1A (ADR-067) — bu kategoriyi ANA kategori olarak tutan urunler (Restrict).
  primaryProducts      Product[]                   @relation("ProductPrimaryCategory")
  campaignCategories   CampaignCategory[]
  image                MediaAsset?                 @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  // Faz 1B (ADR-067) — bu kategoriye bagli attribute davranislari (tek sahip).
  attributeLinks       CategoryAttribute[]
  // TODO-158A (ADR-086) — Home Experience: bu kategoriyi öne çıkaran section girdileri
  // (onDelete: Cascade → kategori silinince featured girdisi otomatik kalkar; ağaç bozulmaz).
  homeFeaturedIn       HomeFeaturedCategory[]
  // TODO-160 (ADR-102) — Kategori hedefli takip linkleri (kategori silinince SetNull).
  trackingLinks        InfluencerTrackingLink[]
  // TODO-161 (ADR-114) — Sponsorlu kampanya kategori hedefleri (kategori silinince SetNull).
  sponsoredCampaigns   SponsoredProductCampaign[]
  // TODO-165 Fashion Vertical (ADR-249) — kategori scope'lu size chart atamalari.
  sizeChartAssignments SizeChartAssignment[]       @relation("SizeChartCategory")

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
  @@index([status])
}

model ProductCategoryAssignment {
  productId  String
  categoryId String
  storeId    String
  createdAt  DateTime @default(now())

  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@unique([storeId, productId, categoryId])
  @@index([storeId])
  @@index([categoryId])
}

model InventoryItem {
  id                String   @id @default(cuid())
  storeId           String
  variantId         String   @unique
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int?
  updatedAt         DateTime @updatedAt

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([variantId])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  storeId       String
  variantId     String
  type          InventoryMovementType @default(ADJUSTMENT)
  quantityDelta Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorUserId   String?
  createdAt     DateTime              @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([variantId])
  @@index([type])
}

// TODO-152 (ADR-076) — Inventory Engine · Store-scoped depo. Bu faz store başına bir DEFAULT depo
// (migration backfill) kurar; ek depo CRUD UI TD-046. `isDefault` store başına TEK olmalıdır
// (migration'da partial unique index). Silme yerine INACTIVE tercih edilir (yeni stok işlemine kapalı).
model Warehouse {
  id        String          @id @default(cuid())
  storeId   String
  code      String
  name      String
  status    WarehouseStatus @default(ACTIVE)
  isDefault Boolean         @default(false)
  priority  Int             @default(0)
  // Opsiyonel adres (bilgi amaçlı; fulfillment/kargo yetkinliği bu fazda YOK).
  city      String?
  district  String?
  line1     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  balances    InventoryBalance[]
  adjustments InventoryAdjustment[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, status])
}

// TODO-152 (ADR-076) — Variant × Warehouse stok özeti. onHand/reserved DEFAULT depo için
// InventoryItem ile senkron tutulur (InventoryItem otorite; checkout/storefront sıfır regresyon);
// safetyStock/incoming/reorderPoint bu tabloda otoriterdir. `available` TÜRETİLİR (kolon YOK):
// available = onHand − reserved − safetyStock. Unique = varyant × depo tek bakiye.
model InventoryBalance {
  id           String   @id @default(cuid())
  storeId      String
  warehouseId  String
  variantId    String
  onHand       Int      @default(0)
  reserved     Int      @default(0)
  incoming     Int      @default(0)
  safetyStock  Int      @default(0)
  reorderPoint Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([storeId])
  @@index([variantId])
  @@index([storeId, warehouseId])
}

// TODO-152 (ADR-076) — Append-only stok düzeltme defteri (audit/ledger). Her DEĞİŞEN alan için bir
// satır; tek apply = tek batchId (undo/tanı temeli). oldValue/newValue/delta üçü de tutulur (Set
// Absolute + Adjust Delta ayrımı görünür). `reserved` kullanıcı-düzenlenmez → yalnız sistem
// kaynakları (ORDER_*) reserved yazabilir; bu fazda üretilmez. changedByPlatformUserId FK DEĞİL,
// scalar: kullanıcı silinse bile tarihsel kayıt korunur (ProductPriceChange deseni).
model InventoryAdjustment {
  id                      String                    @id @default(cuid())
  storeId                 String
  warehouseId             String
  productId               String
  variantId               String
  field                   InventoryAdjustmentField
  oldValue                Int
  newValue                Int
  delta                   Int
  reason                  String?
  source                  InventoryAdjustmentSource
  batchId                 String
  changedByPlatformUserId String?
  createdAt               DateTime                  @default(now())

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([batchId])
  @@index([storeId, variantId, createdAt])
}

// Storefront musteri kimligi (F3B.3). Tek kavram: hem store-admin CRM kaydi hem
// storefront uyelik hesabi ayni Customer satiridir (ADR-032). email/phone store
// scope'unda unique ve NULL'lanabilir (GSM-only ya da email-only kayit). Auth/
// profil alanlari burada; sifre/otp/session/iban/iletisim tercihi alt tablolarda.
model Customer {
  id              String          @id @default(cuid())
  storeId         String
  email           String?
  firstName       String?
  lastName        String?
  phone           String?
  birthDate       DateTime?
  gender          CustomerGender?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          CustomerStatus  @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // TD-131 (ADR-149) — Kişisel Verileri Sil (ERASE_PERSONAL_DATA) audit izleri.
  // status=ERASED ile birlikte set edilir; PII değil (yalnız zaman + admin id + neden).
  erasedAt        DateTime?
  erasedByUserId  String?
  eraseReason     String?

  store                   Store                            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses               CustomerAddress[]
  orders                  Order[]
  credential              CustomerCredential?
  credentialTokens        CustomerCredentialToken[]
  sessions                CustomerSession[]
  otpVerifications        CustomerOtpVerification[]
  ibans                   CustomerIban[]
  communicationPreference CustomerCommunicationPreference?
  campaignRedemptions     CampaignRedemption[]
  customerCoupons         CustomerCoupon[]
  // TODO-159D (ADR-093) — Customer Lists & Wishlist (favori + alisveris listeleri).
  customerLists           CustomerList[]
  // TODO-167 (ADR-266) — Persistent Cart & Cross-Device Foundation (customer-owned kalici sepet).
  carts                   Cart[]
  // TODO-159E (ADR-094) — Product Reviews & Ratings (musterinin yorumlari + faydali oylari).
  productReviews          ProductReview[]
  productReviewHelpfuls   ProductReviewHelpful[]
  // TODO-174A (ADR-279) — musterinin siparis deneyimi degerlendirmeleri.
  orderExperienceReviews  OrderExperienceReview[]
  // TODO-161B (ADR-137) — Recently Viewed geçmişi (müşteri silinince Cascade → KVKK otomatik).
  recentlyViewedProducts  RecentlyViewedProduct[]
  // TODO-169 (ADR-269) — Müşterinin iade talepleri (yalnız kendi siparişleri için).
  returnRequests          ReturnRequest[]
  // TODO-174B (ADR-281) — Customer Shopping Balance / Store Credit (hesap + lot + immutable ledger).
  creditAccounts          CustomerCreditAccount[]
  creditLots              CustomerCreditLot[]
  creditLedgerEntries     CustomerCreditLedgerEntry[]
  // TODO-174B (ADR-283) — müşteriye ait sipariş-deneyimi recovery case'leri.
  recoveryCases           OrderRecoveryCase[]
  // TODO-177 (ADR-289) — müşterinin açtığı destek ticket'ları (yalnız kendi sipariş/satırları için).
  supportTickets          SupportTicket[]

  @@unique([storeId, email])
  @@unique([storeId, phone])
  @@index([storeId])
  @@index([status])
}

// Sifre kimligi (F3B.3). Plain sifre ASLA saklanmaz; scrypt hash @commerce-os/auth.
model CustomerCredential {
  id                String   @id @default(cuid())
  storeId           String
  customerId        String   @unique
  passwordHash      String
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// Admin tetikli aktivasyon/parola-sifirlama token'i (TODO-087, ADR-035). Plain
// token ASLA saklanmaz/loglanmaz; yalnizca sha256 tokenHash (SESSION_SECRET ile).
// Raw token yalniz uretim response'unda tek seferlik doner. createdByUserId:
// token'i ureten platform-admin. Tek seferlik: consumedAt ile tuketilir.
model CustomerCredentialToken {
  id              String                         @id @default(cuid())
  storeId         String
  customerId      String
  purpose         CustomerCredentialTokenPurpose
  tokenHash       String                         @unique
  expiresAt       DateTime
  consumedAt      DateTime?
  createdByUserId String
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@index([expiresAt])
}

// Musteri oturumu (F3B.3). PlatformSession deseni: raw token DB'de tutulmaz,
// yalnizca sha256 tokenHash. Storefront httpOnly cookie -> gateway server-to-server.
model CustomerSession {
  id                   String    @id @default(cuid())
  storeId              String
  customerId           String
  tokenHash            String    @unique
  // ADR-271 (Unified Session Policy) — PlatformSession ile ORTAK iki-kapili omur.
  // `expiresAt` geri-uyumluluk icin korunur (ADR-271 sonrasi = absoluteExpiresAt).
  // Otoriter gecerlilik: now <= min(lastActivityAt + idleTimeout(rememberMe),
  // absoluteExpiresAt) && revokedAt == null. idle deadline HESAPLANIR, saklanmaz.
  expiresAt            DateTime
  lastActivityAt       DateTime  @default(now())
  // Guvenli-additive: nullable → validator `absoluteExpiresAt ?? expiresAt`.
  // Backfill: absoluteExpiresAt = expiresAt, lastActivityAt = updatedAt.
  absoluteExpiresAt    DateTime?
  rememberMe           Boolean   @default(false)
  rotatedFromSessionId String?
  // ADR-271 hardening (M1) — PlatformSession ile ORTAK legacy cutover marker.
  // 0 = grandfathered (absolute-only, idle collapse YOK) → ilk anlamli aktivitede 1'e terfi.
  policyVersion        Int       @default(1)
  revokedAt            DateTime?
  userAgent            String?
  ipAddress            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@index([expiresAt])
}

// OTP dogrulama (F3B.3). Plain kod ASLA saklanmaz/loglanmaz; yalnizca codeHash.
// destination, koda ait hedef (kullanicinin kendi email/telefonu) eslestirme icin.
model CustomerOtpVerification {
  id           String             @id @default(cuid())
  storeId      String
  customerId   String
  purpose      CustomerOtpPurpose
  channel      CustomerOtpChannel
  destination  String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@index([expiresAt])
}

// IBAN bilgisi (F3B.3). Iade/iptal sureci icin saklanir. DB'de tam IBAN tutulur;
// API response'larinda MASKELI doner. Event/log metadata'ya IBAN yazilmaz.
model CustomerIban {
  id                String    @id @default(cuid())
  storeId           String
  customerId        String
  accountHolderName String
  iban              String
  isDefault         Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
}

// Iletisim tercihleri (F3B.3, KVKK izin modeli). Musteri basina tek satir.
// smsEnabled = "Anlik / Kisa Mesaj"; phoneEnabled = telefon ile arama izni.
model CustomerCommunicationPreference {
  id           String   @id @default(cuid())
  storeId      String
  customerId   String   @unique
  smsEnabled   Boolean  @default(false)
  emailEnabled Boolean  @default(true)
  phoneEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// Adres defteri (F3B.3, F3B.2 fatura ile uyumlu). Bir adres hem teslimat hem
// fatura kimligi tasiyabilir. Bireysel: tckn (11 hane); Kurumsal: companyName +
// taxOffice + taxNumber (VKN 10 hane). TCKN/VKN response'ta maskeli; log'a yazilmaz.
// Soft delete: deletedAt set edilir, satir korunur (gecmis siparis butunlugu).
model CustomerAddress {
  id                String       @id @default(cuid())
  storeId           String
  customerId        String
  type              AddressType  @default(SHIPPING)
  addressName       String       @default("")
  fullName          String
  phone             String?
  countryCode       String       @default("TR")
  city              String
  district          String?
  addressLine1      String
  addressLine2      String?
  postalCode        String?
  isDefaultShipping Boolean      @default(false)
  isDefaultBilling  Boolean      @default(false)
  billingType       BillingType?
  tckn              String?
  companyName       String?
  taxOffice         String?
  taxNumber         String?
  deletedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([customerId])
  @@index([type])
}

model OrderNumberCounter {
  id        String   @id @default(cuid())
  storeId   String   @unique
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Order {
  id                         String                           @id @default(cuid())
  storeId                    String
  orderNumber                String
  customerId                 String?
  customerEmail              String
  currency                   String
  status                     OrderStatus                      @default(DRAFT)
  paymentStatus              PaymentStatus                    @default(UNPAID)
  fulfillmentStatus          FulfillmentStatus                @default(UNFULFILLED)
  subtotalAmount             Int                              @default(0)
  discountAmount             Int                              @default(0)
  shippingAmount             Int                              @default(0)
  // F3C.2 — Kargo ucreti SNAPSHOT'i (siparis aninda magaza tarifesinden hesaplanan
  // tutarin kaynagi ve plan kimligi). Tutar shippingAmount'tadir; bu alanlar
  // izlenebilirlik icindir. Provider canli quote DEGILDIR (bkz. ADR-036).
  shippingCurrency           String?
  shippingSource             ShippingRateSource?
  shippingRatePlanId         String?
  shippingRatePlanName       String?
  // TODO-125 (ADR-047) — Checkout'ta SEÇİLEN kargo sağlayıcı/seçenek SNAPSHOT'i.
  // Tarihsel sipariş, config sonradan değişse bile sabit kalsın diye sağlayıcı
  // görünüm bilgisi de yazılır. shippingProvider = taşıyıcı kimliği (enum),
  // shippingProviderName = görünen ad, shippingLogoUrl = public logo (secret DEĞİL),
  // shippingEtaText = tahmini teslim metni. ratePlanName service/method adıdır.
  shippingProvider           ShippingProviderType?
  shippingProviderName       String?
  shippingLogoUrl            String?
  shippingEtaText            String?
  taxAmount                  Int                              @default(0)
  totalAmount                Int                              @default(0)
  // TODO-174B (ADR-282) — Store Credit ödeme SNAPSHOT'ı (denormalize; finansal source-of-truth
  // DEĞİL — otorite STORE_CREDIT PaymentAttempt + credit ledger). shoppingCreditUsedMinor: bu
  // siparişte alışveriş bakiyesinden düşülen tutar. externalPaymentAmountMinor = totalAmount −
  // shoppingCreditUsedMinor (PSP/manuel ile tahsil edilecek/edilen kısım). BigInt: credit ledger
  // minor-money kontratıyla tutarlı (Int Order tutarları dokunulmaz; sınırda kanonik string).
  shoppingCreditUsedMinor    BigInt                           @default(0)
  externalPaymentAmountMinor BigInt                           @default(0)
  placedAt                   DateTime?
  cancelledAt                DateTime?
  cancelReason               String?
  // TODO-174 (ADR-275/ADR-278) — İptal provenance'i (additive; legacy `cancelReason` serbest metin
  // geriye-dönük görüntüleme için KORUNUR). `cancelSource` iptali başlatan aktör; `cancelReasonCode`/
  // `cancelReasonCategory` platform-tanımlı taksonomi (contracts registry doğrular); `cancelReasonNote`
  // müşteri açıklaması (OTHER'da zorunlu). Hepsi iptal edilmemiş siparişte null.
  cancelSource               OrderCancellationSource?
  cancelReasonCode           OrderCancellationReason?
  cancelReasonCategory       OrderCancellationReasonCategory?
  cancelReasonNote           String?
  // TODO-174 (ADR-275) — Optimistic concurrency (self-servis iptal ↔ admin handoff yarışı). updateMany
  // version guard: yalnız bir operasyon kazanır. Sipariş ömrü boyunca placeOrder sonrası bump edilir.
  version                    Int                              @default(0)
  // Fatura kimlik bilgileri (F3B.2). Fatura ADRESI OrderAddress(type=BILLING)
  // kaydinda tutulur; burada yalnizca fatura tipi + vergi/kimlik kimlik alanlari
  // bulunur. Bireysel: billingTaxId = T.C. Kimlik No (11 hane). Kurumsal: firma
  // unvani + vergi dairesi + vergi no. PII gereksiz log/event metadata'ya yazilmaz.
  billingType                BillingType?
  billingName                String?
  billingTaxId               String?
  billingCompanyName         String?
  billingTaxOffice           String?
  billingTaxNumber           String?
  billingEmail               String?
  createdAt                  DateTime                         @default(now())
  updatedAt                  DateTime                         @updatedAt

  store                 Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer              Customer?                   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines                 OrderLine[]
  addresses             OrderAddress[]
  events                OrderEvent[]
  reservations          InventoryReservation[]
  paymentAttempts       PaymentAttempt[]
  paymentEvents         PaymentProviderEvent[]
  shipments             Shipment[]
  shipmentQuotes        ShipmentQuote[]
  // F4A — Siparis indirim snapshot'lari + kampanya kullanim kayitlari.
  discounts             OrderDiscount[]
  redemptions           CampaignRedemption[]
  customerCoupons       CustomerCoupon[]
  // TODO-159E (ADR-094) — bu siparisten dogan urun yorumlari (uygunluk provenance'i).
  reviews               ProductReview[]
  // TODO-174A (ADR-279) — bu siparise ait deneyim degerlendirmesi (en fazla bir; iptal sonrasi).
  experienceReviews     OrderExperienceReview[]
  // TODO-160 (ADR-103) — siparis attribution snapshot'i (varsa TEK; influencer kaynakli).
  attribution           OrderAttribution?
  // TODO-161 (ADR-118) — sponsorlu urun attribution'lari (siparis basina N; urun-satiri kaynakli).
  // Influencer attribution'dan BAGIMSIZ + BIRLIKTE var olabilir (ADR-120 coexistence).
  sponsoredAttributions OrderSponsoredAttribution[]
  // TODO-169 (ADR-269) — Returns Management Foundation. Bir sipariş zamanla N iade talebi içerebilir.
  returnRequests        ReturnRequest[]
  refundIntents         RefundIntent[]
  // TODO-170 (ADR-272) — Refund Ledger. Bir sipariş zamanla N refund (partial/çoklu) içerebilir.
  orderRefunds          OrderRefund[]
  // TODO-174B (ADR-283) — bu siparişe bağlı sipariş-deneyimi recovery case'leri (deneyim başına en fazla bir).
  recoveryCases         OrderRecoveryCase[]
  // TODO-177 (ADR-289) — bu siparişten açılan destek ticket'ları (onDelete: Restrict → sipariş pinlenir).
  supportTickets        SupportTicket[]

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  // TODO-159A (ADR-089) — Siparis listesinin varsayilan yolu (store + createdAt DESC).
  @@index([storeId, createdAt])
}

model OrderLine {
  id                     String   @id @default(cuid())
  storeId                String
  orderId                String
  productId              String
  variantId              String
  sku                    String
  title                  String
  variantTitle           String
  quantity               Int
  unitPriceAmount        Int
  totalAmount            Int
  currency               String
  // F4C (ADR-063/ADR-064) — Siparis ani KDV/maliyet/liste SNAPSHOT'lari
  // (fatura/yasal belge + kar analizi temeli). unitPriceAmount/totalAmount
  // KDV DAHIL brut olarak KALIR (geri uyum); asagidaki alanlar additive'dir ve
  // ESKI siparislerde NULL kalir (legacy — yeniden HESAPLANMAZ, yaniltici sifir
  // gosterilmez). unitGross/lineGross bilincli acik yazilir (fatura semantigi).
  // unitListPriceMinor = siparis anindaki liste fiyati (compareAt ?? brut satis).
  unitNetPriceMinor      Int?
  unitVatRateBps         Int?
  unitVatAmountMinor     Int?
  unitGrossPriceMinor    Int?
  unitListPriceMinor     Int?
  unitCostMinor          Int?
  lineNetAmountMinor     Int?
  lineVatAmountMinor     Int?
  lineGrossAmountMinor   Int?
  lineCostMinor          Int?
  // TD-FR-7 — Bu kaleme siparis aninda FIILEN dusen order-level indirim (KDV DAHIL).
  // Kaynak dogrusu = kampanya/checkout motoru (scope'u bilir; DiscountEngineResult
  // .lineDiscounts). Snapshot IMMUTABLE'dir. Iade hesabi (returns/refund-calc) bu
  // degeri kullanarak kalemin FIILEN odedigi tutari iade eder; oransal (gross-agirlikli)
  // dagitim resmi/finansal olarak YANLIS oldugundan terk edilmistir. Kampanya YOKSA
  // (checkout) 0 yazilir. Admin manuel siparis / ESKI kalemlerde NULL → refund-calc
  // legacy oransal fallback'e duser (geri uyum; backfill YAPILMADI). Client etkileyemez.
  discountAllocatedMinor Int?
  // TODO-165 Fashion Vertical (ADR-252) — moda varyant SNAPSHOT'lari (additive, nullable).
  // Yalniz FASHION_VERTICAL acik magazalarda + fashion eksenli varyantlarda server-side
  // doldurulur (createOrder/addOrderLine); ProductVariantOptionValue ⋈ AttributeOption'dan
  // TURETILIR ve IMMUTABLE'dir (urun/varyant sonradan degisse bile snapshot sabit kalir).
  // ESKI/fashion-disi kalemlerde NULL. Client manipule EDEMEZ (variantId'den turetilir).
  selectedColor          String? // secili renk display adi (AttributeOption.label)
  selectedColorHex       String? // secili renk hex swatch (#rrggbb) — sunum
  selectedSize           String? // secili beden display etiketi
  sizeSystem             String? // beden sistemi anahtari (SizeSystemKey) — snapshot
  swatchLabel            String? // swatch etiketi (renk ailesi / desen ozeti)
  materialSummary        String? // kisa materyal/kompozisyon ozeti
  variantDisplayName     String? // insan-okur varyant adi ("Kirmizi / M")
  // BUG-CART-005 (Variant Media Engine / ADR-078 reuse) — SATIN ALMA ANI kapak medyasi
  // SNAPSHOT'i (additive, nullable). Sipariş geçmişi tarihsel kayıttır: kapak thumbnail'i
  // checkout anında varyantin EFEKTIF medya ekseninden (renk) cozulen ProductImage'in
  // storageKey'idir. Urun/varyant medyasi SONRADAN degisse bile gecmis siparisin gorseli
  // SABIT kalir (IMMUTABLE). Server-side turetilir (createOrder), client manipule EDEMEZ.
  // ESKI (backfill YOK) veya gorselsiz kalemde NULL → projeksiyon guvenli fallback'e duser
  // (once mevcut efektif varyant medyasi, sonra urun birincil kapagi). storageKey ic alandir;
  // DTO'ya SIZMAZ (imageUrl'e cevrilip atilir — Dilim 6b allowlist deseni).
  mediaStorageKey        String?
  createdAt              DateTime @default(now())

  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant        ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations   InventoryReservation[]
  // TODO-159E (ADR-094) — bir sipariş kalemi en fazla bir yoruma kaynak (orderLineId UNIQUE).
  review         ProductReview?
  // TODO-169 (ADR-269) — bu satırdan doğan iade kalemleri (kısmi/tekrarlı iade adet hesabı).
  returnItems    ReturnItem[]
  // TODO-177 (ADR-289) — bu sipariş satırından açılan destek ticket'ları (onDelete: Restrict).
  supportTickets SupportTicket[]

  @@index([storeId])
  @@index([orderId])
  @@index([variantId])
}

model OrderAddress {
  id           String      @id @default(cuid())
  storeId      String
  orderId      String
  type         AddressType
  fullName     String
  phone        String?
  countryCode  String
  city         String
  district     String?
  addressLine1 String
  addressLine2 String?
  postalCode   String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
  @@index([type])
}

model OrderEvent {
  id          String   @id @default(cuid())
  storeId     String
  orderId     String
  type        String
  message     String?
  metadata    Json?
  actorUserId String?
  createdAt   DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
  @@index([type])
}

model InventoryReservation {
  id            String                     @id @default(cuid())
  storeId       String
  orderId       String
  orderLineId   String
  variantId     String
  quantity      Int
  status        InventoryReservationStatus @default(ACTIVE)
  expiresAt     DateTime?
  releasedAt    DateTime?
  consumedAt    DateTime?
  // H-3 (ADR-189/190) — RELEASED/EXPIRED nedeni (audit). PII taşımaz; sabit kodlar:
  // ORDER_CANCELLED · PAYMENT_CANCELLED · RESERVATION_EXPIRED · ORPHAN_DRAFT · MANUAL.
  releaseReason String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine OrderLine      @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([orderId])
  @@index([orderLineId])
  @@index([variantId])
  @@index([status])
  // H-3 (ADR-187/188) — Süpürücü aday sorgusu (status+expiresAt cutoff) + read-time expiry add-back.
  @@index([storeId, status, expiresAt])
  @@index([variantId, status, expiresAt])
}

// F3B.2 Payment Operations Foundation.
// Saglayici credential'lari yalniz ciphertext (apiKeyCipher/secretKeyCipher/
// webhookSecretCipher) olarak saklanir; duz metin DB'ye asla yazilmaz, client'a
// asla maskesiz donmez. Canli odeme bu fazda YOK; provider-ready operasyon katmani.
model PaymentProviderConfig {
  id                  String                @id @default(cuid())
  storeId             String
  provider            PaymentProviderType
  displayName         String
  status              PaymentProviderStatus @default(DISABLED)
  mode                PaymentProviderMode   @default(TEST)
  priority            Int                   @default(100)
  supportedMethods    PaymentMethodType[]
  supportedCurrencies String[]
  minAmount           Int?
  maxAmount           Int?
  threeDsMode         ThreeDsMode           @default(DISABLED)
  installmentEnabled  Boolean               @default(false)
  fallbackEnabled     Boolean               @default(false)
  merchantId          String?
  callbackUrl         String?
  apiKeyCipher        String?
  secretKeyCipher     String?
  webhookSecretCipher String?
  // PB-1 (ADR-156) — Public webhook kimlik parcasi (opak `whk_…`). URL'de config cozer;
  // YETKI vermez (yetki = HMAC imza). Yalniz rotate ile uretilir; secret webhookSecretCipher'da.
  webhookToken        String?               @unique
  lastTestStatus      String?
  lastTestMessage     String?
  lastTestAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  store    Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]
  events   PaymentProviderEvent[]

  @@unique([storeId, provider, mode])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, priority])
}

model PaymentAttempt {
  id                   String               @id @default(cuid())
  storeId              String
  orderId              String
  // TODO-159F (ADR-098) — MANUAL tahsilatta provider yoktur → nullable. ONLINE
  // attempt'lerde her zaman set edilir. Config silinmez; SetNull ile korunur.
  providerConfigId     String?
  // TODO-159F (ADR-098) — Deneme kökeni. Eski (F3B.2) online attempt'ler için ONLINE.
  type                 PaymentAttemptType   @default(ONLINE)
  provider             PaymentProviderType?
  mode                 PaymentProviderMode?
  method               PaymentMethodType
  amount               Int
  currency             String
  status               PaymentAttemptStatus @default(CREATED)
  threeDsApplied       Boolean              @default(false)
  scenario             String?
  // Odeme gozlemlenebilirligi (F3B.2). Full PAN/CVC ASLA saklanmaz; yalniz
  // turetilmis guvenli alanlar: kart markasi + son 4 hane + taksit sayisi.
  installmentCount     Int                  @default(1)
  cardBrand            String?
  cardLast4            String?
  // providerReference = saglayici islem (transaction) referansi.
  providerReference    String?
  failureCode          String?
  failureMessage       String?
  paidAt               DateTime?
  failedAt             DateTime?
  // Kisa omurlu public odeme erisim token'inin hash'i; plain token DB'ye yazilmaz.
  accessTokenHash      String?
  accessTokenExpiresAt DateTime?
  // TODO-159F (ADR-097/099) — Idempotency + ödeme bağlantısı alanları.
  //   idempotencyKey : aynı sipariş için çift oturum/istek koruması (store-scoped unique).
  //   expiresAt      : ödeme bağlantısı/oturum geçerlilik penceresi (accessToken'dan ayrı semantik).
  //   initiatedBy    : aksiyonu başlatan platformUserId (admin-initiated/MANUAL için).
  idempotencyKey       String?
  expiresAt            DateTime?
  initiatedBy          String?
  // Paylaşılabilir müşteri ödeme yolu (/pay/:token). Bearer link; secret DEĞİL ama
  // AuditLog/event metadata'sına YAZILMAZ (spec §10). Yalnız aktif online link'te dışa verilir.
  paymentUrl           String?
  // TODO-159F (ADR-098) — MANUAL (offline) tahsilat alanları. ONLINE attempt'lerde null.
  manualMethod         PaymentManualMethod?
  manualReference      String?
  manualNote           String?
  collectedAt          DateTime?
  // TODO-174B (ADR-282) — STORE_CREDIT attempt'i, harcamayı oluşturan credit ledger DEBIT
  // hareket(ler)ine bağlar (çok-lot FEFO harcaması tek groupKey ile gruplanır). İptal/iade
  // allocation'ında hangi lot'a ne kadar iade edileceğini deterministik çözmek için okunur.
  creditLedgerGroupKey String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerConfig PaymentProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  events         PaymentProviderEvent[]
  // TODO-169 (ADR-269) — Bu attempt'e referans veren iade niyetleri (orijinal ödeme yöntemine iade).
  refundIntents  RefundIntent[]
  // TODO-170 (ADR-272) — Bu attempt'ten gerçekleşen/denenen para iadeleri (ledger).
  orderRefunds   OrderRefund[]

  @@unique([storeId, idempotencyKey], map: "payment_attempt_store_idempotency_key")
  @@index([storeId])
  @@index([orderId])
  @@index([providerConfigId])
  @@index([status])
  @@index([accessTokenHash])
  // PB-1 (ADR-158) — Webhook, attempt'i DOGRULANMIS provider reference'tan cozer (client
  // body.storeId/attemptId DEGIL). Store-scoped providerReference aramasi icin additive index.
  @@index([storeId, providerReference])
}

model PaymentProviderEvent {
  id               String                   @id @default(cuid())
  storeId          String
  providerConfigId String?
  attemptId        String?
  orderId          String?
  provider         PaymentProviderType
  type             PaymentProviderEventType
  // Provider/webhook external event id varsa set edilir; internal eventlerde null.
  eventId          String?
  message          String?
  metadata         Json?
  createdAt        DateTime                 @default(now())

  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  providerConfig PaymentProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)
  attempt        PaymentAttempt?        @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  order          Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([storeId, provider, eventId], map: "payment_provider_event_unique_external_event")
  @@index([storeId])
  @@index([providerConfigId])
  @@index([attemptId])
  @@index([orderId])
  @@index([type])
}

// ─────────────────────── F3C.1 Shipping provider foundation ───────────────────────

model ShippingProviderConfig {
  id                     String                 @id @default(cuid())
  storeId                String
  provider               ShippingProviderType
  mode                   ShippingProviderMode   @default(TEST)
  status                 ShippingProviderStatus @default(DISABLED)
  displayName            String
  // F3C.5 (TODO-121) — Provider logo (public, secret DEGIL). UI'da liste/detay/ozet
  // kartinda gosterilir; bozuk/eksik URL'de provider initials fallback uygulanir.
  // logoStorageKey ileride object-store entegrasyonu icin TODO (su an dis URL).
  logoUrl                String?
  logoAlt                String?
  // Destructive/costly operasyon guard'lari. Hepsi varsayilan KAPALI; canli
  // createOrder/createbarcode/acceptOffer ancak ilgili env flag + bu alan + request
  // explicitConfirm uclusu saglaninca calisir (aksi halde 409).
  // Plus Command / createRecipient guard'i (paketleme öncesi varış şube tespiti).
  allowRecipientCreate   Boolean                @default(false)
  allowOrderCreate       Boolean                @default(false)
  allowBarcodeCreate     Boolean                @default(false)
  allowLabelPurchase     Boolean                @default(false)
  // TODO-094B — son test "durumu". connectionStatus degerleri: OK/FAILED/HTTP_DISABLED/
  // SKIPPED (null => UNTESTED). HTTP transport kapaliyken test ASLA OK yazmaz.
  lastTestedAt           DateTime?
  lastTestStatus         String?
  lastErrorCode          String?
  // Son GERCEK provider HTTP testinin meta'si. Transport kapaliyken httpStatus null kalir.
  lastProviderHttpStatus Int?
  lastProviderTestType   String?
  // TODO-104 — provider webhook guvenligi. webhookToken URL yol parcasidir (config
  // cozumleme kimligi; TEK BASINA YETKI VERMEZ — HMAC imza her istekte zorunlu).
  // Secret AES-256-GCM ciphertext olarak saklanir (SHIPPING_ENCRYPTION_KEY);
  // response'a ASLA donmez, yalniz rotate aninda BIR KEZ plain doner (ADR-035 deseni).
  webhookToken           String?                @unique
  webhookSecretCipher    String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  store        Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  credentials  ShippingProviderCredential[]
  shipments    Shipment[]
  quotes       ShipmentQuote[]
  webhookInbox ShipmentWebhookInbox[]

  @@unique([storeId, provider, mode])
  @@index([storeId])
  @@index([storeId, status])
}

model ShippingProviderCredential {
  id                        String                 @id @default(cuid())
  providerConfigId          String
  type                      ShippingCredentialType @default(DEFAULT)
  // Secret alanlar AES-256-GCM ciphertext olarak saklanir; duz metin ASLA yazilmaz.
  // DHL IDENTITY tipi ayrica customerNumber/customerPassword tutar.
  encryptedKey              String?
  encryptedSecret           String?
  encryptedCustomerNumber   String?
  encryptedCustomerPassword String?
  identityType              Int?
  // maskedKey yalnizca son-4 gosterimi icin; tam secret degildir.
  maskedKey                 String?
  configured                Boolean                @default(false)
  lastTestedAt              DateTime?
  lastTestStatus            String?
  lastErrorCode             String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  providerConfig ShippingProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([providerConfigId, type])
  @@index([providerConfigId])
}

model Shipment {
  id                        String               @id @default(cuid())
  storeId                   String
  orderId                   String
  // TODO-173 (ADR-274) — Kargo yönü. Mevcut kayıtlar default OUTBOUND_TO_CUSTOMER. Tüm duplicate
  // guard / fulfillment / tracking / KPI projeksiyonları bu alanla direction-aware'dir.
  direction                 ShipmentDirection    @default(OUTBOUND_TO_CUSTOMER)
  // TODO-173 (ADR-274) — Reverse shipment (STORE_RETURN_TO_CUSTOMER) MANUELDIR: gerçek carrier
  // entegrasyonu yoktur → provider/providerConfigId, siparişin mevcut OUTBOUND gönderisinin config'ini
  // REUSE eder (kolonlar NOT NULL kalır; tip sürtünmesi yok). Reverse gönderiler sync/webhook/barcode
  // worker'larından `direction` filtreleriyle DIŞLANIR (provider çağrısı hiç yapılmaz).
  providerConfigId          String
  provider                  ShippingProviderType
  // TODO-173 (ADR-274) — Reverse shipment bağları (yalnız STORE_RETURN_TO_CUSTOMER'da dolu; outbound'da null).
  // returnQuantity = bu ters gönderiyle müşteriye geri gönderilen adet (cap invariant'a girer).
  // sourceShipmentId = orijinal outbound gönderiye zayıf referans (izlenebilirlik). reverseShipmentReason =
  // zorunlu operasyonel gerekçe (internal; müşteriye sızmaz). createdByPlatformUserId = audit aktörü.
  returnRequestId           String?
  returnItemId              String?
  returnQuantity            Int?
  sourceShipmentId          String?
  reverseShipmentReason     String?
  createdByPlatformUserId   String?
  // TODO-173 (ADR-274) — Reverse shipment MANUEL taşıyıcı SERBEST-METNİ (provider enum'u
  // MOCK/GELIVER/DHL taşımaz; ör. "Yurtiçi Kargo"). Yalnız STORE_RETURN_TO_CUSTOMER'da dolu.
  carrierName               String?
  // TODO-173 (ADR-274) — Müşteriye gösterilen tahmini teslim tarihi (opsiyonel; admin girer).
  estimatedDeliveryAt       DateTime?
  externalOrderId           String?
  externalShipmentId        String?
  externalInvoiceId         String?
  referenceId               String
  status                    ShipmentStatus       @default(DRAFT)
  shipmentStatusCode        Int?
  trackingNumber            String?
  trackingUrl               String?
  labelUrl                  String?
  // Yalnizca sanitize edilmis barkod ozeti (pieceNumber + value); JWT/secret icermez.
  barcodeJsonSafe           Json?
  pieceCount                Int                  @default(1)
  totalKg                   Float                @default(0)
  totalDesi                 Float                @default(0)
  packagingType             Int?
  shipmentServiceType       Int?
  paymentType               Int?
  deliveryType              Int?
  recipientName             String?
  recipientEmail            String?
  recipientPhone            String?
  recipientCityCode         Int?
  recipientDistrictCode     Int?
  recipientCityName         String?
  recipientDistrictName     String?
  recipientAddress          String?
  // TODO-129 — zamanlanmis shipment sync worker metadata'si (provider-agnostic).
  // lastSyncAt = son sync DENEMESI (basari/hata farketmez; stale-after secimi bunu esas alir).
  // nextSyncAt = hata backoff'u (null => hemen secilebilir). syncAttempts = ARDISIK hata
  // sayaci (basarida sifirlanir; MAX_ATTEMPTS ustunu worker SECMEZ, manuel sync calisir).
  // lastSyncErrorCode = sanitize hata kodu (or. PROVIDER_QUERY_FAILED,
  // PROVIDER_SYNC_UNSUPPORTED, PROVIDER_DISABLED); raw payload/secret ASLA yazilmaz.
  lastSyncAt                DateTime?
  nextSyncAt                DateTime?
  syncAttempts              Int                  @default(0)
  lastSyncErrorCode         String?
  // TODO-124 — son barkod denemesinin SINIFLANDIRILMIS hata kodu (or.
  // DESTINATION_BRANCH_NOT_FOUND, PROVIDER_ERROR). Basarili barkod/pending ve
  // varis eslemesi onarimi (repair-destination) bunu SIFIRLAR. TODO-123 retry
  // worker'i DESTINATION_BRANCH_NOT_FOUND'u admin duzeltmesine kadar SKIP etmelidir.
  // Raw saglayici mesaji/secret ASLA yazilmaz; yalniz kisa sanitize kod.
  lastBarcodeErrorCode      String?
  // TODO-123 — barkod retry/backoff metadata'si (TODO-129 sync alanlarindan AYRIDIR;
  // barkod olusturma ile durum senkronu farkli yasam donguleridir). barcodeRetryCount =
  // ardisik TRANSIENT (retryable) hata sayaci; basarili barkod/pending SIFIRLAR.
  // barcodeNextRetryAt = backoff (null => zamanlanmadi; worker SECMEZ). barcodeLastAttemptAt =
  // son barkod DENEMESI ani. barcodeRetryBlockedReason = otomatik retry BLOK nedeni:
  // "DATA_FIX" (adres/varis eslemesi duzeltilmeli — TODO-124/139), "TERMINAL" (kalici/
  // desteklenmeyen), "MAX_ATTEMPTS" (transient limit doldu). null => bloklu degil.
  // lastBarcodeErrorCode ("ne oldu") ile barcodeRetryBlockedReason ("neden otomatik
  // denenmiyor") AYRIDIR. Adres/varis onarimi (TODO-124/139) bu alanlari sifirlar.
  barcodeRetryCount         Int                  @default(0)
  barcodeNextRetryAt        DateTime?
  barcodeLastAttemptAt      DateTime?
  barcodeRetryBlockedReason String?
  // TODO-169 (ADR-269) — İade penceresi için STABIL teslim tarihi ankoru. status → DELIVERED
  // geçişinde (manuel durum route + provider-sync eşlemesi) set edilir. Migration mevcut
  // DELIVERED gönderileri `updatedAt` ile backfill eder (mevcut en iyi yaklaşım; dokümante).
  // Eligibility, siparişin teslim edilmiş gönderileri üzerinden MAX(deliveredAt) alır.
  deliveredAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerConfig   ShippingProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Restrict)
  events           ShipmentEvent[]
  // TODO-173 (ADR-274) — Reverse shipment bağları (nullable; yalnız STORE_RETURN_TO_CUSTOMER).
  returnRequest    ReturnRequest?         @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  returnItem       ReturnItem?            @relation(fields: [returnItemId], references: [id], onDelete: SetNull)
  sourceShipment   Shipment?              @relation("ReverseShipmentSource", fields: [sourceShipmentId], references: [id], onDelete: SetNull)
  reverseShipments Shipment[]             @relation("ReverseShipmentSource")

  @@unique([storeId, referenceId])
  @@index([storeId])
  @@index([orderId])
  @@index([providerConfigId])
  @@index([status])
  // TODO-129 — worker uygun gonderi secimi (status taramasi + backoff/stale siralamasi).
  @@index([status, nextSyncAt])
  @@index([status, lastSyncAt])
  // TODO-123 — barkod retry worker'inin uygun gonderi secimi (status + backoff siralamasi).
  @@index([status, barcodeNextRetryAt])
  @@index([lastBarcodeErrorCode, barcodeNextRetryAt])
  // TODO-173 (ADR-274) — direction-aware projeksiyon/guard/liste sorguları için.
  @@index([storeId, direction])
  @@index([direction, status])
  @@index([returnRequestId])
  @@index([returnItemId])
  @@index([sourceShipmentId])
  @@index([trackingNumber])
}

model ShipmentEvent {
  id          String               @id @default(cuid())
  storeId     String
  shipmentId  String
  provider    ShippingProviderType
  eventType   ShipmentEventType
  statusCode  Int?
  statusText  String?
  location    String?
  occurredAt  DateTime?
  trackingUrl String?
  // Yalnizca sanitize edilmis saglayici payload ozeti; secret/JWT/Authorization icermez.
  rawSafeJson Json?
  createdAt   DateTime             @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([shipmentId])
  @@index([eventType])
}

// TODO-104 — Webhook idempotency/replay inbox'i. Imzasi GECERLI her teslimat
// (providerConfigId, eventKey) ile BIR KEZ kaydedilir; unique ihlali = duplicate →
// yeni ShipmentEvent YAZILMAZ (idempotent). Gecersiz imzali istekler buraya
// YAZILMAZ (DB flood/DoS onlemi; yalniz log). statusText sanitize ozet tasir;
// secret/imza/raw payload ASLA saklanmaz (payloadHash sha256 ozetidir).
model ShipmentWebhookInbox {
  id               String                 @id @default(cuid())
  storeId          String
  providerConfigId String
  provider         ShippingProviderType
  eventKey         String
  payloadHash      String
  outcome          ShipmentWebhookOutcome @default(ACCEPTED)
  shipmentId       String?
  statusCode       Int?
  statusText       String?
  createdAt        DateTime               @default(now())

  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  providerConfig ShippingProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([providerConfigId, eventKey])
  @@index([storeId])
  @@index([shipmentId])
}

model ShipmentQuote {
  id               String               @id @default(cuid())
  storeId          String
  orderId          String?
  providerConfigId String
  provider         ShippingProviderType
  amountMinor      Int
  currency         String               @default("TRY")
  // Yalnizca sanitize edilmis ucret kalemleri ozeti; secret icermez.
  rawSafeJson      Json?
  createdAt        DateTime             @default(now())

  store          Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  providerConfig ShippingProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderId])
  @@index([providerConfigId])
}

// ─────────────────────── F3C.2 Shipping price engine (store tarife) ───────────────────────
// Magaza bazli kargo tarife plani. Kargo ucreti bu plan + kurallar uzerinden
// hesaplanir; SAGLAYICI canli quote DEGILDIR (bkz. ADR-036). Tek default guard
// uygulama katmanindadir (Prisma partial unique olmadigi icin set-default
// transaction'inda digerleri kapatilir).
model ShippingRatePlan {
  id                         String                  @id @default(cuid())
  storeId                    String
  // Operasyon sağlayıcısıyla gevsek iliskilendirme (UI/rapor icin); fiyat etkisi YOK.
  provider                   ShippingProviderType?
  name                       String
  status                     ShippingRatePlanStatus  @default(ACTIVE)
  isDefault                  Boolean                 @default(false)
  pricingMode                ShippingRatePricingMode @default(FIXED)
  currency                   String                  @default("TRY")
  fixedAmountMinor           Int?
  freeShippingThresholdMinor Int?
  // TODO-125 (ADR-047) — Checkout kargo seçeneği kartında gösterilecek tahmini
  // teslim metni (ör. "2-3 iş günü"). PUBLIC, opsiyonel; sipariş snapshot'ına yazılır.
  deliveryEstimate           String?
  validFrom                  DateTime?
  validTo                    DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rules      ShippingRateRule[]
  tiers      ShippingRateTier[]
  zones      ShippingRateZone[]
  surcharges ShippingSurcharge[]

  @@index([storeId])
  @@index([storeId, status])
}

// F3C.2 revizyon — Aylik gonderi hacmi segmenti / sozlesme grubu (DHL Tarife I/II/III).
// Bir kural tierId ile bu segmente baglanir; tier secimi monthlyShipmentCount'a gore
// yapilir (bilinmiyorsa en kucuk sortOrder; ADR-044). storeId yok — plan'a kapsali.
model ShippingRateTier {
  id                 String   @id @default(cuid())
  ratePlanId         String
  name               String
  monthlyShipmentMin Int?
  monthlyShipmentMax Int?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ratePlan ShippingRatePlan   @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  rules    ShippingRateRule[]

  @@index([ratePlanId])
}

// F3C.2 revizyon — Mesafe/bolge zonu (Aras sehir-ici/yakin/kisa/orta/uzak/KKTC/MOBILE).
// code plan icinde unique. Kural zoneId ile baglanir; ince geo (city/district) ayrica
// ShippingRateRule uzerinde korunur. minDistanceKm/maxDistanceKm ilerideki firma bolge
// tablolari icin opsiyonel.
model ShippingRateZone {
  id            String   @id @default(cuid())
  ratePlanId    String
  code          String
  name          String
  minDistanceKm Decimal? @db.Decimal(10, 2)
  maxDistanceKm Decimal? @db.Decimal(10, 2)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ratePlan ShippingRatePlan   @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  rules    ShippingRateRule[]

  @@unique([ratePlanId, code])
  @@index([ratePlanId])
}

// F3C.2 revizyon — Ek hizmet bedelleri (SMS bildirim, taşıma güvencesi, mobil alan,
// hamaliye, agir gonderi, kapida odeme farki). chargeType FLAT/PER_KG/PER_DESI/...
// olabilir. isOptional=false ise her quote'a eklenir; true ise conditionJsonSafe
// degerlendirilir (SQL-injection riski yok; saf JSON, sadece engine tarafindan okunur).
model ShippingSurcharge {
  id                String             @id @default(cuid())
  ratePlanId        String
  code              String
  name              String
  chargeType        ShippingChargeType @default(FLAT)
  amountMinor       Int?
  unitAmountMinor   Int?
  conditionJsonSafe Json?
  isOptional        Boolean            @default(false)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  ratePlan ShippingRatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, code])
  @@index([ratePlanId])
}

model ShippingRateRule {
  id               String             @id @default(cuid())
  ratePlanId       String
  storeId          String
  tierId           String?
  zoneId           String?
  minDesi          Decimal?           @db.Decimal(10, 2)
  maxDesi          Decimal?           @db.Decimal(10, 2)
  minWeightKg      Decimal?           @db.Decimal(10, 3)
  maxWeightKg      Decimal?           @db.Decimal(10, 3)
  cityCode         String?
  districtCode     String?
  regionCode       String?
  // chargeType FLAT (varsayilan) mevcut amountMinor yolunu birebir korur. Yeni
  // tipler unitAmountMinor / baseAmountMinor / baseThreshold kullanir. amountMinor
  // artik nullable (FLAT disinda zorunlu degil); mevcut veriler backfill ile korunur.
  chargeType       ShippingChargeType @default(FLAT)
  amountMinor      Int?
  unitAmountMinor  Int?
  baseAmountMinor  Int?
  baseThreshold    Decimal?           @db.Decimal(10, 2)
  // Legacy/simple-extra: yeni gelismis hesabin merkezi DEGIL; ek ucretler
  // ShippingSurcharge ile yonetilir (ADR-044 revizyon). Geriye uyumluluk icin korunur.
  extraAmountMinor Int?
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ratePlan ShippingRatePlan  @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  tier     ShippingRateTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  zone     ShippingRateZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  @@index([ratePlanId])
  @@index([cityCode, districtCode])
  @@index([storeId])
  @@index([tierId])
  @@index([zoneId])
}

// ─────────────────────── F4A Campaigns & Coupons MVP ───────────────────────
// Kampanya: magaza-scoped indirim tanimi. discountValue PERCENT'te 1-100 tam
// sayi yuzdedir; FIXED_AMOUNT'ta minor unit (kurus) tutardir. usageCount toplam
// kullanim limiti icin ATOMIK sayactir (siparis transaction'inda kosullu
// UPDATE ile artirilir; limit asilirsa siparis reddedilir — ADR-058).
model Campaign {
  id                     String                @id @default(cuid())
  storeId                String
  name                   String
  description            String?
  status                 CampaignStatus        @default(DRAFT)
  type                   CampaignType
  discountType           CampaignDiscountType
  discountValue          Int
  maxDiscountAmountMinor Int?
  minOrderAmountMinor    Int?
  startsAt               DateTime?
  endsAt                 DateTime?
  totalUsageLimit        Int?
  perCustomerUsageLimit  Int?
  usageCount             Int                   @default(0)
  stackable              Boolean               @default(false)
  priority               Int                   @default(0)
  isPublic               Boolean               @default(true)
  // F4A.4 — SUNUM alanlari (ADR-061). Yalnizca kupon kart/rozet gorunumu;
  // indirim hesaplamasini ETKILEMEZ. Mevcut kampanyalar null ile calisir
  // (UI fallback uretilmis etiketlere doner).
  displayTitle           String?
  shortDescription       String?
  terms                  String?
  badgeLabel             String?
  badgeVariant           CampaignBadgeVariant?
  cardStyle              CampaignCardStyle     @default(STANDARD)
  accessModel            CampaignAccessModel   @default(AUTO_VISIBLE)
  // Sunum siralamasi (calc `priority`den AYRI; motor bunu kullanmaz).
  displayPriority        Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  coupons         Coupon[]
  products        CampaignProduct[]
  categories      CampaignCategory[]
  redemptions     CampaignRedemption[]
  orderDiscounts  OrderDiscount[]
  customerCoupons CustomerCoupon[]

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, type])
}

// Kupon kodu: store scope'unda normalizedCode UNIQUE (farkli magazalar ayni
// kodu kullanabilir). normalizedCode = trim + locale-BAGIMSIZ uppercase
// (TR-I tuzagina karsi izinli karakterler [A-Z0-9_-]). startsAt/endsAt
// kampanya penceresini DARALTAN opsiyonel override'dir.
model Coupon {
  id                    String       @id @default(cuid())
  storeId               String
  campaignId            String
  code                  String
  normalizedCode        String
  status                CouponStatus @default(ACTIVE)
  totalUsageLimit       Int?
  perCustomerUsageLimit Int?
  usageCount            Int          @default(0)
  startsAt              DateTime?
  endsAt                DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign        Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  redemptions     CampaignRedemption[]
  orderDiscounts  OrderDiscount[]
  customerCoupons CustomerCoupon[]

  @@unique([storeId, normalizedCode])
  @@index([storeId])
  @@index([campaignId])
}

// Kampanya urun kapsami. Bos kapsam = tum sepet. Scope id'leri ayni store'a
// ait olmalidir (uygulama katmaninda dogrulanir; storeId kolonu izolasyon
// sorgulari icindir).
model CampaignProduct {
  campaignId String
  productId  String
  storeId    String
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([storeId])
  @@index([productId])
}

model CampaignCategory {
  campaignId String
  categoryId String
  storeId    String
  createdAt  DateTime @default(now())

  campaign Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([campaignId, categoryId])
  @@index([storeId])
  @@index([categoryId])
}

// Kullanim kaydi: siparis olusturma transaction'inda yazilir; siparis basina
// kampanya BIR KEZ (unique). Siparis sonradan iptal/refund olsa da kayit
// TARIHSEL kalir (kompanzasyon deseni yok — ADR-058'de dokumante sinirlama).
// email: misafir checkout'ta per-customer limit dayanagi (customerId yoksa).
model CampaignRedemption {
  id                  String   @id @default(cuid())
  storeId             String
  campaignId          String
  couponId            String?
  orderId             String
  customerId          String?
  email               String?
  discountAmountMinor Int
  createdAt           DateTime @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  coupon   Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([campaignId, orderId])
  @@index([storeId])
  @@index([couponId])
  @@index([campaignId, customerId])
  @@index([campaignId, email])
  @@index([orderId])
}

// Siparis indirim SNAPSHOT satiri (immutable; siparis olusturulduktan sonra
// degistirilmez — ADR-058). Kampanya/kupon sonradan silinse/degisse bile
// siparis gecmisi sabit kalir; bu yuzden label/code/discountType kopyalanir.
model OrderDiscount {
  id                  String               @id @default(cuid())
  storeId             String
  orderId             String
  campaignId          String?
  couponId            String?
  code                String?
  label               String
  discountType        CampaignDiscountType
  discountValue       Int
  discountAmountMinor Int
  scopeSummary        Json?
  createdAt           DateTime             @default(now())

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  coupon   Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([orderId])
  @@index([campaignId])
}

// F4A.3 — Musteri kupon cuzdani (ADR-060). Bir kupon satiri BIR musteri
// (customerId) VEYA bir email icin tutulur. status yasam dongusu:
// AVAILABLE -> APPLIED (sepette "Kullan") -> USED (siparis basarili) / geri
// AVAILABLE ("Kaldir"); REVOKED admin geri-alimidir. KAYNAK DOGRUSU indirim
// tutari icin DEGILDIR — indirim yine couponCode + motordan gelir; bu tablo
// yalnizca cuzdan/atama/claim state'idir. Store-scoped; cross-store gorunmez.
model CustomerCoupon {
  id         String               @id @default(cuid())
  storeId    String
  couponId   String
  campaignId String
  customerId String?
  email      String?
  status     CustomerCouponStatus @default(AVAILABLE)
  source     CustomerCouponSource
  claimedAt  DateTime             @default(now())
  appliedAt  DateTime?
  usedAt     DateTime?
  orderId    String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  coupon   Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Ayni kupon ayni musteri/email icin TEK satir (lifecycle in-place gunceller).
  // Postgres NULL-distinct oldugundan customerId=null satirlar email kisitiyla,
  // email=null satirlar customerId kisitiyla korunur; uygulama katmani da dedup yapar.
  @@unique([storeId, couponId, customerId])
  @@unique([storeId, couponId, email])
  @@index([storeId])
  @@index([couponId])
  @@index([campaignId])
  @@index([storeId, customerId, status])
  @@index([storeId, email, status])
}

// ============================================================================
// TODO-159D (ADR-093) — Customer Lists & Wishlist.
// Favori (wishlist) ve alisveris listeleri AYRI iki sistem DEGIL; ortak bir
// `CustomerList` altyapisidir. Wishlist = type=WISHLIST olan TEK varsayilan liste
// (isDefault=true, lazy-create, silinemez/yeniden-adlandirilamaz). Alisveris
// listeleri = type=SHOPPING_LIST olan kullanici-tanimli listeler.
// Tenant izolasyonu mevcut desenle: storeId FK + Cascade + @@index([storeId]).
// ============================================================================
enum CustomerListType {
  WISHLIST
  SHOPPING_LIST
}

// MVP yalniz PRIVATE. Alan ileri faz (paylasimli/public liste) icin hazir tutulur.
enum CustomerListVisibility {
  PRIVATE
}

model CustomerList {
  id         String                 @id @default(cuid())
  storeId    String
  customerId String
  name       String
  type       CustomerListType       @default(SHOPPING_LIST)
  visibility CustomerListVisibility @default(PRIVATE)
  isDefault  Boolean                @default(false)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  store    Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CustomerListItem[]
  // "Her (store, customer) icin TAM bir default WISHLIST" invariant'i migration'daki
  // KISMI unique index ile zorlanir: UNIQUE(storeId, customerId)
  //   WHERE isDefault = true AND type = 'WISHLIST'. (Prisma partial index'i sema
  //   dilinde ifade edemez; migration.sql'de tanimli — bkz. ADR-093.)

  @@index([storeId])
  @@index([storeId, customerId])
}

model CustomerListItem {
  id        String   @id @default(cuid())
  storeId   String
  listId    String
  productId String
  // NULL = butun-urun ogesi (wishlist favorisi her zaman urun-seviyesi → PLP/PDP
  // durum tutarliligi). Dolu = varyant-ozel oge (alisveris listeleri).
  variantId String?
  note      String?
  quantity  Int      @default(1)
  sortOrder Int      @default(0)
  addedAt   DateTime @default(now())

  store   Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  list    CustomerList    @relation(fields: [listId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Ayni urun/varyant ayni listeye iki kez eklenemez. Bu 4'lu unique varyant-DOLU
  // durumu Prisma-native kapatir; butun-urun (variantId=NULL) durumu Postgres
  // NULL-distinct oldugundan migration'daki KISMI unique ile kapatilir:
  //   UNIQUE(listId, productId) WHERE variantId IS NULL. Servis katmani ayrica
  //   check-then-insert + P2002 yutma ile idempotent davranir (bkz. ADR-093).
  @@unique([listId, productId, variantId])
  @@index([storeId])
  @@index([listId, addedAt])
  @@index([productId])
  @@index([variantId])
}

// ============================================================================
// TODO-167 (ADR-266) — Persistent Cart & Cross-Device Foundation.
//
// Authenticated musterinin KALICI, cross-device sepeti. Anonim sepet DB'ye GIRMEZ
// (mevcut commerce_os_cart HMAC cookie'de kalir). Cart yalniz REFERANS tutar
// (variant + quantity); fiyat/liste/indirim SAKLANMAZ — her okumada assemblePublicCart
// ile sunucu-otoriter TAZE hesaplanir. Snapshot/ack alanlari BU FAZDA YOK (TODO-168).
// Her (store, customer) icin TEK ACTIVE cart: migration'daki KISMI unique index ile
// zorlanir — UNIQUE(storeId, customerId) WHERE status='ACTIVE' (Prisma partial index'i
// sema dilinde ifade edemez; bkz. migration.sql + ADR-266). version optimistic-
// concurrency icin atomik artar (stale mutation → 409 CART_STALE).
// ============================================================================

enum CartStatus {
  ACTIVE
  CONVERTED
  MERGED
  EXPIRED
}

model Cart {
  id             String     @id @default(cuid())
  storeId        String
  customerId     String
  status         CartStatus @default(ACTIVE)
  // Optimistic-concurrency + checkout tazelik token'i. Her anlamli mutation'da +1.
  version        Int        @default(1)
  // Sepetin yerlesik para birimi (tek-para invariant'i; satirlar yalniz referans tutar).
  currency       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastActivityAt DateTime   @default(now())
  convertedAt    DateTime?
  mergedAt       DateTime?
  expiredAt      DateTime?

  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines      CartLine[]
  // TODO-168 (ADR-267) — cross-device acknowledgement kayitlari (cart CONVERTED olsa da audit kalir).
  changeAcks CartChangeAck[]

  @@index([storeId])
  @@index([storeId, customerId, status])
  // Expiry sweep taramasi (ACTIVE cart'lar lastActivityAt esigine gore).
  @@index([status, lastActivityAt])
}

model CartLine {
  id        String   @id @default(cuid())
  storeId   String
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // TODO-168 (ADR-267) — Cart Change Awareness REFERANS snapshot'i (additive, nullable).
  // add/replace'te veya ilk guvenilir resolve'da baseline yazilir; ack'te yeniden-baseline edilir.
  // ASLA siparis fiyati DEGIL — yalniz "neyin degistigini" acikladigi karsilastirma referansi.
  // quantity DEGISIMI snapshot'a DOKUNMAZ (kullanicinin bilincli adet degisikligi fiyat olayi degildir).
  addedUnitPriceMinor           Int?
  addedListPriceMinor           Int?
  addedDiscountedUnitPriceMinor Int?
  addedCurrency                 String?
  addedInStock                  Boolean?
  addedOrderable                Boolean?
  addedAt                       DateTime?

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Bir varyant bir cart'ta TEK satir; merge quantity toplar.
  @@unique([cartId, variantId])
  @@index([storeId])
  @@index([cartId])
  @@index([variantId])
}

// ============================================================================
// TODO-168 (ADR-267) — Cart Change Awareness.
//
// Snapshot otoritesi kimlik-bazli AYRILIR: authenticated → DB (CartLine snapshot kolonlari +
// bu CartChangeAck tablosu, gercek cross-device ack); anonim → HMAC-imzali commerce_os_cart_meta
// cookie (storefront). ORTAK saf change-engine (cart-changes/change-engine.ts) ikisinde de calisir.
// Fiyat/stok DEGISIKLIGI her okumada assemblePublicCart ile TAZE turetilir; bu tablolar yalniz
// ack durumu (checkout WARN gate) + best-effort analytics tutar — UI'nin dogruluk kaynagi DEGIL.
// ============================================================================

// Per-fingerprint cross-device acknowledgement (checkout WARN gate + INFO surface kapatma).
// Yeni fiyat degisikligi YENI fingerprint uretir → eski ack yeni degisikligi gizlemez (ADR-267 §6).
model CartChangeAck {
  id             String   @id @default(cuid())
  storeId        String
  cartId         String
  // Hangi satir (opsiyonel baglam; satir silinirse ack yasamaya devam eder — audit).
  cartLineId     String?
  // Ack'i kimin verdigi (audit; FK'siz plain — musteri silinse de ack tarihi korunur).
  customerId     String?
  fingerprint    String
  changeType     String
  acknowledgedAt DateTime @default(now())

  cart  Cart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Per-fingerprint ack idempotency (ayni degisiklik iki kez ack edilmez).
  @@unique([cartId, fingerprint])
  @@index([storeId, cartId])
}

// Best-effort analytics/audit (RecommendationEvent deseni; FK-minimal, KVKK-hash kimlik, dedupeKey
// idempotent). Read side-effect-FREE — satir yalniz acik analytics ingest ucundan yazilir. UI'nin
// degisiklik listesi DETERMINISTIK olarak okumada turetilir; bu tablo yalniz "oldu" bilgisini kaydeder.
model CartChangeEvent {
  id             String   @id @default(cuid())
  storeId        String
  // KVKK: ham cart id/musteri DEGIL — HMAC hash (SESSION_SECRET). Cross-store cakisma yok (storeId ayri).
  cartIdHash     String
  customerIdHash String?
  productId      String?
  variantId      String?
  changeType     String
  // detected | viewed | acknowledged | checkout_blocked | item_removed
  eventType      String
  severity       String?
  oldMinor       Int?
  newMinor       Int?
  currency       String?
  fingerprint    String
  placement      String? // CART_BAR | CART_LINE | CHECKOUT
  // = hash(eventType, fingerprint) → (storeId, dedupeKey) idempotent upsert; re-render 0 yeni satir.
  dedupeKey      String
  occurredAt     DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dedupeKey])
  @@index([storeId, occurredAt])
  @@index([storeId, changeType, occurredAt])
  @@index([storeId, cartIdHash, occurredAt])
}

// ============================================================================
// TODO-159E (ADR-094) — Product Reviews & Ratings.
//
// Gerçek, tenant-safe, moderasyonlu ve DOĞRULANMIŞ ALIŞVERİŞ temelli yorum sistemi.
// Yorum ÜRÜN seviyesinde yayınlanır/toplanır; variantId yalnız bağlam olarak saklanır.
// Uygunluk SUNUCU-otoriter (satın alma kanıtı gateway'de doğrulanır; UI'ya güvenilmez).
// Product/Variant modeline JSON yorum alanı EKLENMEZ (ayrı normalize tablo).
// ============================================================================

model ProductReview {
  id               String              @id @default(cuid())
  storeId          String
  productId        String
  // Hangi varyant satın alındı (sipariş kaleminden türetilir) — yalnız BAĞLAM.
  // Ürün-seviyesi yayın/aggregate; varyant silinince SetNull (yorum yaşamaya devam).
  variantId        String?
  customerId       String
  // Uygunluk kanıtı + provenance (public projeksiyonda ASLA sızmaz).
  orderId          String
  orderLineId      String
  rating           Int
  title            String?
  body             String
  status           ProductReviewStatus @default(PENDING)
  // Uygunluk zaten teslim edilmiş + ödenmiş sipariş ister → oluşturulan her yorum
  // doğrulanmış alışverişten doğar. İade/iptal sonrası KORUNUR (bkz. ADR-094 §1.6).
  verifiedPurchase Boolean             @default(true)
  // Denormalize sayaç (liste N+1'i önler; helpful add/remove ile aynı tx'te güncellenir).
  helpfulCount     Int                 @default(0)
  moderationNote   String?
  publishedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  store        Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customer     Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine    OrderLine              @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  helpfulVotes ProductReviewHelpful[]

  // Bir sipariş kalemi en fazla bir yoruma kaynak (§14). Bir müşteri bir ürüne en
  // fazla bir yorum (roadmap kabul kriteri). İkisi de servis check-then-insert + P2002.
  @@unique([orderLineId])
  @@unique([storeId, productId, customerId])
  // Admin Data Grid: store-scoped + durum + tarih sıralama (tek erişimde WHERE+ORDER BY).
  @@index([storeId, status, createdAt])
  // Public liste: ürün-scoped + APPROVED + tarih.
  @@index([productId, status, createdAt])
  // Aggregate yeniden hesap: store+ürün+durum groupBy.
  @@index([storeId, productId, status])
  // Account "Değerlendirmelerim".
  @@index([customerId])
}

// Faydalı buldum oyu. Bir müşteri bir yoruma en fazla bir oy (unique). Guest YOK.
// Kendi yorumuna oy servis katmanında engellenir. Toplam sayaç ProductReview.helpfulCount.
model ProductReviewHelpful {
  id         String   @id @default(cuid())
  storeId    String
  reviewId   String
  customerId String
  createdAt  DateTime @default(now())

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([reviewId, customerId])
  @@index([storeId])
  @@index([customerId])
}

// Rating aggregate PROJECTION (ürün başına tek satır). TEK yazma yolu:
// recomputeAggregate(tx, storeId, productId) — APPROVED yorumları sıfırdan sayar.
// Yalnız APPROVED dâhil. Float drift'e karşı TAMSAYI toplamlar; ortalama okuma anında
// türetilir (averageTimes100 = round(sumRating*100/reviewCount)). Bkz. ADR-094 §aggregate.
model ProductRatingAggregate {
  productId       String   @id
  storeId         String
  reviewCount     Int      @default(0)
  sumRating       Int      @default(0)
  count1          Int      @default(0)
  count2          Int      @default(0)
  count3          Int      @default(0)
  count4          Int      @default(0)
  count5          Int      @default(0)
  averageTimes100 Int      @default(0)
  updatedAt       DateTime @updatedAt

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

// ============================================================================
// TODO-174A (ADR-279) — Sipariş Deneyimi Değerlendirmesi.
//
// ProductReview'DAN TAMAMEN AYRIK: bu değerlendirme ÜRÜN puanına, PDP/PLP rating'lerine
// veya ProductRatingAggregate'e HİÇBİR ŞEKİLDE yansımaz (verifiedPurchase kavramı YOK;
// "ürünü kullandım" anlamı üretmez). İptal edilmiş ve teslim EDİLMEMİŞ siparişte müşterinin
// sipariş/iptal deneyimini (1-5 + opsiyonel yorum) tutar. İleride admin raporlamasında
// sipariş deneyimi metriği olarak kullanılabilir. Bir müşteri bir sipariş için EN FAZLA bir
// değerlendirme (duplicate koruması @@unique([storeId, orderId, customerId])).
// ============================================================================
model OrderExperienceReview {
  id         String   @id @default(cuid())
  storeId    String
  orderId    String
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store        Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // TODO-174B (ADR-283) — bu değerlendirmeden doğan recovery case (1-2★ otomatik / 3★ manuel; en fazla bir).
  recoveryCase OrderRecoveryCase?

  // Sipariş başına müşteri başına en fazla bir değerlendirme (servis check-then-insert + P2002).
  @@unique([storeId, orderId, customerId])
  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([orderId])
}

// ============================================================================
// TODO-174B (ADR-281/282/284) — Customer Shopping Balance / Store Credit.
//
// GERÇEK değer-taşıyan, IMMUTABLE, lot-tabanlı FEFO ledger. Kupon "wallet"ından (state tablosu)
// AYRIDIR — bu finansal bir defterdir. Şablon: OrderRefund+OrderRefundEvent (append-only head+event,
// advisory-lock + version guard + idempotency). Para minor-unit BigInt; API sınırında kanonik string
// (@commerce-os/utils), float YOK. Bakiye OTORİTESİ = Σ canlı lot remaining (status=ACTIVE ∧
// expiresAt > now). cachedAvailableMinor yalnız perf; deterministik doğrulanabilir.
//
// GIFT CARD SATIN ALMA / KOD REDEEM bu kapsamda YOKTUR (FUTURE: "Gift Card Purchase / Code Redemption").
// ============================================================================

enum CreditLotStatus {
  ACTIVE
  CONSUMED
  EXPIRED
}

enum CreditDirection {
  CREDIT
  DEBIT
}

enum CreditActorType {
  PLATFORM_USER
  CUSTOMER
  SYSTEM
}

enum CreditSourceType {
  ADMIN_GOODWILL
  RECOVERY_GOODWILL
  ADMIN_ADJUSTMENT
  ORDER_PAYMENT
  ORDER_CANCELLATION
  ORDER_REFUND
  EXPIRY
  SYSTEM
  ORDER_RETURN // TODO-175 — return-context credit hareketi (restore/reissue/refund-to-balance)
}

enum CreditLedgerType {
  ADMIN_GOODWILL_CREDIT
  RECOVERY_GOODWILL_CREDIT
  ORDER_PAYMENT_DEBIT
  ORDER_CANCELLATION_RESTORE
  REFUND_RESTORE
  ADMIN_ADJUSTMENT_CREDIT
  ADMIN_ADJUSTMENT_DEBIT
  EXPIRE
  RETURN_CREDIT_RESTORE // TODO-175 — onaylı return credit-origin restore (expired lot → non-expiring reissue)
}

// Müşteri başına (store, currency) bakiye çıpası + perf cache. Otorite lot toplamıdır.
model CustomerCreditAccount {
  id                   String   @id @default(cuid())
  storeId              String
  customerId           String
  currency             String
  cachedAvailableMinor BigInt   @default(0)
  version              Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store    Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lots     CustomerCreditLot[]
  entries  CustomerCreditLedgerEntry[]

  @@unique([storeId, customerId, currency])
  @@index([storeId])
  @@index([customerId])
}

// Bir grant = spendable "lot" (mutable head; remaining lock altında azalır). Goodwill lot'ta expiresAt
// ZORUNLU (30/60/120/180 günden biri). TODO-175: refund-origin lot NON-EXPIRING (expiresAt = null).
// FEFO: expiresAt ASC (null en sona), createdAt ASC tüketilir.
model CustomerCreditLot {
  id                   String           @id @default(cuid())
  storeId              String
  customerId           String
  accountId            String
  currency             String
  originalAmountMinor  BigInt
  remainingAmountMinor BigInt
  expiresAt            DateTime? // null = non-expiring (TODO-175 refund-origin credit)
  status               CreditLotStatus  @default(ACTIVE)
  sourceType           CreditSourceType
  sourceId             String?
  issuedByType         CreditActorType  @default(PLATFORM_USER)
  issuedById           String?
  version              Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  store    Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account  CustomerCreditAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  entries  CustomerCreditLedgerEntry[]

  @@index([storeId, customerId, status, expiresAt])
  @@index([storeId, status, expiresAt])
  @@index([accountId])
}

// Append-only, IMMUTABLE. Her hareket bir satır; lot'a bağlı (EXPIRE/DEBIT/CREDIT/RESTORE). Çok-lot'lu
// tek mantıksal hareket ortak groupKey ile gruplanır. orderId SCALAR (FK yok; audit resilience). UPDATE/DELETE YOK.
model CustomerCreditLedgerEntry {
  id                String           @id @default(cuid())
  storeId           String
  customerId        String
  accountId         String
  lotId             String?
  type              CreditLedgerType
  direction         CreditDirection
  amountMinor       BigInt
  balanceAfterMinor BigInt
  currency          String
  sourceType        CreditSourceType
  sourceId          String?
  orderId           String?
  groupKey          String?
  description       String
  createdByType     CreditActorType  @default(SYSTEM)
  createdById       String?
  idempotencyKey    String
  createdAt         DateTime         @default(now())

  store    Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  account  CustomerCreditAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lot      CustomerCreditLot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, customerId, createdAt])
  @@index([accountId, createdAt])
  @@index([lotId])
  @@index([orderId])
  @@index([groupKey])
}

// ============================================================================
// TODO-174B (ADR-283) — Order Experience Recovery Operations.
//
// 1-2★ OrderExperienceReview → otomatik recovery case. 3★ → yalnız manuel. 4-5★ → case yok.
// Review başına en fazla bir case (orderExperienceReviewId @unique). Append-only activity/history;
// internal note'lar storefront'a ASLA sızmaz. ProductReview/ProductRatingAggregate'e sıfır dokunuş.
// ============================================================================

enum RecoveryCaseStatus {
  OPEN
  ASSIGNED
  CONTACT_ATTEMPTED
  CUSTOMER_REACHED
  ACTION_REQUIRED
  RESOLVED
  CLOSED
  UNREACHABLE
  NO_ACTION_REQUIRED
}

enum RecoveryPriority {
  LOW
  MEDIUM
  HIGH
}

enum RecoveryActivityType {
  ASSIGNED
  CONTACT_CALL
  CONTACT_EMAIL
  UNREACHABLE
  ISSUE_HEARD
  ACTION_REQUIRED
  GOODWILL_CREDIT
  RESOLVED
  CLOSED
  NOTE
}

enum RecoveryOutcome {
  ISSUE_RESOLVED
  APOLOGY_ACCEPTED
  REFUND_QUESTION
  DELIVERY_COMPLAINT
  PRICE_COMPLAINT
  PRODUCT_EXPECTATION_MISMATCH
  CUSTOMER_UNREACHABLE
  CUSTOMER_DECLINED
  OTHER
}

enum RecoveryResolutionType {
  GOODWILL_CREDIT
  APOLOGY
  REFUND_FOLLOWUP
  NO_ACTION
  OTHER
}

model OrderRecoveryCase {
  id                      String                  @id @default(cuid())
  storeId                 String
  orderExperienceReviewId String                  @unique
  customerId              String
  orderId                 String
  status                  RecoveryCaseStatus      @default(OPEN)
  priority                RecoveryPriority        @default(MEDIUM)
  assigneePlatformUserId  String?
  openedAt                DateTime                @default(now())
  firstContactAt          DateTime?
  dueAt                   DateTime
  resolvedAt              DateTime?
  closedAt                DateTime?
  resolutionType          RecoveryResolutionType?
  resolutionNote          String?
  createdByPlatformUserId String?
  updatedByPlatformUserId String?
  version                 Int                     @default(0)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  store      Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  review     OrderExperienceReview   @relation(fields: [orderExperienceReviewId], references: [id], onDelete: Cascade)
  customer   Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  activities OrderRecoveryActivity[]

  @@index([storeId, status, dueAt])
  @@index([storeId, assigneePlatformUserId, status])
  @@index([customerId])
  @@index([orderId])
}

// Append-only recovery aktivite/geçmişi. actorId SCALAR (FK yok; aktör silinse bile korunur).
// note internal — storefront'a sızmaz. creditLedgerEntryId: goodwill kredi verildiyse ledger'a idempotent bağ.
model OrderRecoveryActivity {
  id                  String               @id @default(cuid())
  storeId             String
  recoveryCaseId      String
  type                RecoveryActivityType
  actorType           CreditActorType      @default(PLATFORM_USER)
  actorId             String?
  outcome             RecoveryOutcome?
  note                String?
  creditLedgerEntryId String?
  metadata            Json?
  createdAt           DateTime             @default(now())

  store        Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  recoveryCase OrderRecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([storeId, recoveryCaseId, createdAt])
  @@index([recoveryCaseId])
}

// ============================================================================
// ADR-065 — Site-geneli gorsel yonetimi (Faz 1: sema + storage + upload API).
// Ilke: "storage key sakla, URL turet" — DB'ye tam URL YAZILMAZ; yalniz goreli
// storageKey saklanir, public URL runtime'da MEDIA_PUBLIC_BASE_URL + storageKey
// ile uretilir (CDN-hazir, migration'siz gecis). Multi-tenant izolasyon mevcut
// desenle: storeId FK + onDelete Cascade + @@index([storeId]).
// ============================================================================

// Merkezi/polimorfik yukleme kaydi. storageKey formati (entityId ICERMEZ; entity
// baglama tamamen DB iliskisiyle yapilir, dosya tasima gerekmez):
//   stores/{storeId}/{context}/{uuid}.webp
// context = products | categories | hero | branding. Tum gorseller yuklemede
// sunucuda webp'e normalize edilir (sharp), bu yuzden mimeType daima image/webp.
model MediaAsset {
  id         String       @id @default(cuid())
  storeId    String
  context    MediaContext
  storageKey String       @unique
  mimeType   String
  byteSize   Int
  width      Int?
  height     Int?
  altText    String?
  checksum   String? // sha256; dedup/butunluk (dedup mantigi Faz 4)
  createdBy  String? // yukleyen actorUserId (audit)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  store                      Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productImages              ProductImage[]
  categoryLinks              ProductCategory[]           @relation("CategoryImage")
  heroSlides                 HeroSlide[]
  logoSettings               StoreSettings[]             @relation("StoreLogo")
  faviconSettings            StoreSettings[]             @relation("StoreFavicon")
  // TODO-158A (ADR-086) — Home Experience: hero slide masaüstü/mobil görseli + featured
  // kategori kapak override'ı. onDelete: Restrict/SetNull → kullanımdaki media MEDIA_IN_USE ile korunur.
  homeHeroMedia              HomeHeroSlide[]             @relation("HomeHeroMedia")
  homeHeroMobileMedia        HomeHeroSlide[]             @relation("HomeHeroMobileMedia")
  homeFeaturedImages         HomeFeaturedCategory[]      @relation("HomeFeaturedCategoryImage")
  // Faz 2A (ADR-068) — IMAGE/FILE attribute degeri olarak kullanan urun satirlari
  // (onDelete: Restrict; media silme ucu MEDIA_IN_USE guard'i ile korunur).
  productAttributeValues     ProductAttributeValue[]
  // TODO-165A (ADR-253) — Brand logo/kapak gorseli (onDelete: SetNull; media silinince marka
  // gorselsiz kalir, marka SILINMEZ).
  brandLogoFor               Brand[]                     @relation("BrandLogo")
  brandCoverFor              Brand[]                     @relation("BrandCover")
  // TODO-169 (ADR-269) — İade fotoğraf kanıtı bağları (private; MEDIA_IN_USE guard'ına dahil).
  returnAttachments          ReturnAttachment[]
  // TODO-177 (ADR-289) — Destek ticket eki bağları (private; MEDIA_IN_USE guard'ına dahil; Restrict).
  supportTicketAttachments   SupportTicketAttachment[]
  // TODO-178 — Store→Platform request eki bağları (private; MEDIA_IN_USE guard'ına dahil; Restrict).
  platformRequestAttachments PlatformRequestAttachment[]

  @@index([storeId])
  @@index([storeId, context])
  // TODO-159B (ADR-090) — Medya kutuphanesinin VARSAYILAN yolu "store-scoped +
  // createdAt DESC + LIMIT/OFFSET"tir. Bilesik index hem WHERE hem ORDER BY'i
  // tek erisimle karsilar; 60k satirlik olcumde plan Seq Scan + top-N sort'tan
  // (7.5 ms / 1549 buffer) Index Scan Backward'a (0.07 ms / 11 buffer) dondu.
  @@index([storeId, createdAt])
}

// Urun galerisi (coklu, sirali). position=0 kapak. storeId denormalize tenant
// sutunudur (FK degil) — ProductCategoryAssignment deseniyle tutarli.
model ProductImage {
  id                    String   @id @default(cuid())
  storeId               String
  productId             String
  mediaId               String
  position              Int      @default(0)
  // Faz 2C-7 (ADR-078) — Variant Media Engine. Bu gorselin ait oldugu media-tanimlayici
  // eksen degeri (genelde Renk option'i). Ikisi de null = "Tum varyantlar" (paylasilan gorsel,
  // her varyant grubuyla birlikte gosterilir). attributeDefinitionId denormalize: optionId'nin
  // hangi eksende oldugunu tasir + Product.mediaDefiningAttributeId ile tutarlilik dogrulamasi
  // (service). Bu faz tek-option (1 gorsel -> en fazla 1 renk); coklu-option/coklu-eksen gerekince
  // ProductImageOption join tablosuna yukseltme yolu acik (yalniz persistence degisir, is kurallari
  // degismez). onDelete: Restrict → kullanimdaki option/eksen silinemez (MEDIA_IN_USE deseniyle tutarli).
  attributeDefinitionId String?
  optionId              String?
  createdAt             DateTime @default(now())

  product             Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  media               MediaAsset           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition? @relation("ProductImageMediaAxis", fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  option              AttributeOption?     @relation("ProductImageMediaOption", fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([productId, mediaId])
  @@index([storeId])
  @@index([productId])
  // Faz 2C-7 (ADR-078) — varyant renk grubu filtreleme (galeri projeksiyonu, N+1-siz).
  @@index([productId, optionId])
}

// Ana sayfa hero/slider (coklu slide). Model cokludur; UI tek slide ile baslar,
// CampaignBar'in coklu-slide UX mantigi (auto-gecis/ok/nokta) referans alinir.
model HeroSlide {
  id        String        @id @default(cuid())
  storeId   String
  mediaId   String
  position  Int           @default(0)
  status    ContentStatus @default(DRAFT)
  headline  String?
  subtext   String?
  ctaLabel  String?
  ctaHref   String?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
}

// Magaza ayarlari (1-1; repoda ilk 1-1 iliski). Logo/favicon MediaAsset'e opsiyonel
// FK. Ileride tema/renk/SEO default'lari da buraya eklenir. PK = FK (storeId).
model StoreSettings {
  storeId                           String   @id
  logoMediaId                       String?
  faviconMediaId                    String?
  // TODO-161A (ADR-124) — ADDITIVE. false (varsayilan): ticari olarak UYGUN olmayan `SPONSORED`
  // kampanya ne yayina alinabilir ne de teslim edilir. true: teslim engellenmez, ekranlarda
  // yalnizca gorunur risk gostergesi kalir.
  allowUnpaidSponsoredCampaigns     Boolean  @default(false)
  // TODO-161A.1 (ADR-132) — ADDITIVE. Store timezone; settlement scheduler donem sinirlarinin
  // (weekly/monthly) OTORITESIDIR. Bos/satir yoksa COMMERCIAL_AUTOMATION_DEFAULT_TIMEZONE'a duser.
  // IANA tz adi (or. "Europe/Istanbul"). Yalniz zamanlanmis settlement donem hesabinda kullanilir.
  timezone                          String   @default("Europe/Istanbul")
  // TODO-169 (ADR-269) — Mağaza iade politikası (additive). Satır yoksa AYNI default'lar
  // resolver'da uygulanır. returnWindowDays=14: TR mesafeli satış cayma hakkı (yasal temel).
  // requiresApproval: talep önce incelenir. customerPaysReturnShipping: ilk faz manuel iade
  // kargosu müşteri sorumluluğu. allowReplacement/allowOriginalPaymentRefund: sunulan çözümler.
  returnWindowDays                  Int      @default(14)
  returnsRequireApproval            Boolean  @default(true)
  returnsCustomerPaysShipping       Boolean  @default(true)
  returnsAllowReplacement           Boolean  @default(true)
  returnsAllowOriginalPaymentRefund Boolean  @default(true)
  // TODO-172 (ADR-273) — Fast Refund Controls (additive; hepsi default kapalı). Teslim alma +
  // inceleme adımları atlanarak doğrudan para iadesi başlatan kontrollü akış. fastRefundEnabled=false
  // (varsayılan): UI gizli + backend reddeder. fastRefundMaxAmountMinor null: hızlı iade KAPALI
  // (sınırsız DEĞİL). fastRefundCurrency null: limit sipariş para biriminde yorumlanır; set edilirse
  // sipariş para birimiyle birebir eşleşmeli (aksi FAST_REFUND_CURRENCY_MISMATCH). Limit minor-unit;
  // client'ta hesaplanmaz. Ayrı return-config tablosu YOK. BigInt: para alanı konvansiyonu (Int) dışı
  // ilk BigInt kolonu; serileştirme sınırında Number'a çevrilir (limit güvenli-tamsayı aralığında).
  fastRefundEnabled                 Boolean  @default(false)
  fastRefundMaxAmountMinor          BigInt?
  fastRefundCurrency                String?
  // TODO-174B (ADR-281) — Goodwill / Store Credit compensation policy (additive; default kapalı).
  // maxGoodwillCreditPerActionMinor null: özellik KAPALI (normal operatör kredi VEREMEZ; SUPER_ADMIN
  // ayrı yetkiyle override eder). Değer: tek aksiyonda verilebilecek üst sınır (minor). null=kapalı
  // deseni fastRefundMaxAmountMinor ile birebir (sınırsız DEĞİL). goodwillCreditCurrency null: limit
  // mağaza para biriminde yorumlanır. BigInt para konvansiyonu; serileştirmede kanonik string.
  maxGoodwillCreditPerActionMinor   BigInt?
  goodwillCreditCurrency            String?
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  logo    MediaAsset? @relation("StoreLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  favicon MediaAsset? @relation("StoreFavicon", fields: [faviconMediaId], references: [id], onDelete: SetNull)

  @@index([logoMediaId])
  @@index([faviconMediaId])
}

// ───────────────────── TODO-158A (ADR-086) — Home Experience Platform ─────────────────────
// Yönetilebilir ana sayfa "section" altyapısı. Mevcut store-scoped HeroSlide/StoreSettings
// (ADR-065) DOKUNULMAZ — bu katman tümüyle ADDITIVE ve geriye-uyumludur.
//
// Genişleyebilirlik ilkesi: `HomeSection.type` bir Prisma enum DEĞİL String'tir ve tip-özel
// ayarlar `config` (Json) içinde tutulur. Böylece yeni section tipi (Banner, RichContent,
// CampaignBlock, BrandShowcase, Video, Collection, HTML) eklemek MIGRATION GEREKTİRMEZ;
// yalnızca contract-katmanı allowlist'i + storefront renderer'ı genişler. Üç somut tip
// (HERO_SLIDER / FEATURED_CATEGORIES / PRODUCT_SHOWCASE) ilişkisel butunluk isteyen alt
// varlıkları için çocuk tablolara sahiptir; diğerleri yalnız `config` ile yaşayabilir.

// Ana sayfa aggregate kökü (1-1 mağaza; StoreSettings deseni: PK = FK). Section'lar buna
// bağlıdır. İleride sayfa-seviyesi ayarlar (SEO/tema/yayın) buraya eklenebilir.
model HomePage {
  storeId   String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sections HomeSection[]
}

// Polimorfik ana sayfa bölümü. Ortak alanlar her section tipinde ortaktır; tip-özel veri
// `config` (Json) + ilişkisel çocuk tablolardadır. storeId denormalize tenant sütunudur;
// FK HomePage.storeId'ye bağlanır (Store -> HomePage -> HomeSection cascade zinciri).
model HomeSection {
  id             String    @id @default(cuid())
  storeId        String
  // "HERO_SLIDER" | "FEATURED_CATEGORIES" | "PRODUCT_SHOWCASE" | (ileride yeni tipler).
  // String — enum DEĞİL: yeni tip = migration'sız. Geçerli set contract katmanında allowlist'lenir.
  type           String
  title          String?
  subtitle       String?
  enabled        Boolean   @default(true)
  sortOrder      Int       @default(0)
  desktopVisible Boolean   @default(true)
  mobileVisible  Boolean   @default(true)
  publishStart   DateTime?
  publishEnd     DateTime?
  // Tip-özel ayarlar (showcase: {layout, maxItems, source:{kind, rule, params}}; hero: {autoplayMs}).
  // Şema-katmanında serbest; contract katmanı tip-bazlı doğrular (discriminated union).
  config         Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  homePage           HomePage               @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  heroSlides         HomeHeroSlide[]
  featuredCategories HomeFeaturedCategory[]
  showcaseProducts   HomeShowcaseProduct[]

  @@index([storeId])
  @@index([storeId, enabled])
  @@index([storeId, sortOrder])
}

// HERO_SLIDER section slide'ı. Mevcut HeroSlide'dan (ADR-065) AYRI ve daha zengindir:
// mobil görsel, hedef ürün/kategori/kampanya ve video alanı (ayrılmış; bu faz implement
// edilmez). Hedef id'leri düz String'tir (FK DEĞİL) — Product/Category/Campaign modellerine
// dokunmamak için; var-olma doğrulaması servis katmanındadır (server-authoritative).
model HomeHeroSlide {
  id               String    @id @default(cuid())
  storeId          String
  sectionId        String
  mediaId          String
  mobileMediaId    String?
  // Video desteği için ayrılmış alan; bu fazda storefront render ETMEZ (forward-compat).
  videoUrl         String?
  headline         String?
  subtext          String?
  ctaLabel         String?
  ctaHref          String?
  targetProductId  String?
  targetCategoryId String?
  targetCampaignId String?
  enabled          Boolean   @default(true)
  sortOrder        Int       @default(0)
  publishStart     DateTime?
  publishEnd       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  section     HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  media       MediaAsset  @relation("HomeHeroMedia", fields: [mediaId], references: [id], onDelete: Restrict)
  mobileMedia MediaAsset? @relation("HomeHeroMobileMedia", fields: [mobileMediaId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([sectionId])
}

// FEATURED_CATEGORIES section girdisi. Admin seçili kategoriyi kapak/başlık/açıklama
// override'ı ve sıra ile öne çıkarır. categoryId FK (Cascade): kategori silinince girdi kalkar.
model HomeFeaturedCategory {
  id                  String   @id @default(cuid())
  storeId             String
  sectionId           String
  categoryId          String
  imageMediaId        String?
  titleOverride       String?
  descriptionOverride String?
  enabled             Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  section  HomeSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  image    MediaAsset?     @relation("HomeFeaturedCategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@unique([sectionId, categoryId])
  @@index([storeId])
  @@index([sectionId])
}

// PRODUCT_SHOWCASE (MANUAL kaynak) girdisi. DYNAMIC kaynakta bu tablo boştur; kural
// HomeSection.config.source içinde tutulur ve render-zamanı canlı katalogtan çözülür.
model HomeShowcaseProduct {
  id        String   @id @default(cuid())
  storeId   String
  sectionId String
  productId String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  section HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sectionId, productId])
  @@index([storeId])
  @@index([sectionId])
}

// ───────────────────── TODO-158B (ADR-087) — Enterprise Theme Engine ─────────────────────
// Store'un görsel kimliğini KODDAN ayıran tenant-bazlı Design Token altyapısı.
// Tüm görsel değerler tek bir VERSİYONLU JSON belgesinde (ThemeDocument) yaşar:
// design → semantic → component token katmanları + CSS Variable motoru
// (bkz. packages/theme @commerce-os/theme). Migration ADDITIVE ve geriye-uyumlu:
// temasız mağaza vitrini AYNEN çalışır (paketlenmiş varsayılan tema).
//
// Genişleyebilirlik ilkesi (ADR-086 deseninin devamı): token'lar ENUM/kolon
// DEĞİL `document` (JSONB) içinde tutulur → yeni token grubu/anahtarı eklemek
// MIGRATION GEREKTİRMEZ; yalnız @commerce-os/theme şeması büyür. `status`
// alanları da enum değil String'tir.

// Bir mağazanın birden çok teması olabilir; store seviyesinde YALNIZ biri
// "PUBLISHED" olur (vitrin onu kullanır). Servis katmanı tekilliği uygular.
model Theme {
  id                 String   @id @default(cuid())
  storeId            String
  name               String
  description        String?
  // "DRAFT" | "PUBLISHED" | "ARCHIVED" | "INCOMPATIBLE" | "DISABLED"
  // (String — enum değil; migration'sız genişler; TODO-164 INCOMPATIBLE/DISABLED ekler)
  status             String   @default("DRAFT")
  // Türetildiği preset id'si ("modern" vb.) ya da "import" / "custom".
  source             String?
  // TODO-164 (ADR-217/ADR-219) — additive tenant theme alanları. Registry theme-key
  // (BASE / layout preset / custom package). Backfill BASE_COMMERCE → görünüm korunur.
  themeKey           String   @default("BASE_COMMERCE")
  layoutPreset       String   @default("BASE_COMMERCE")
  themeApiVersion    Int      @default(1)
  // TODO-164A (ADR-225/ADR-229) — Custom Theme Builder kimlik alanları (additive,
  // nullable). Kopyalama config+document snapshot'ı kopyalar, YENİ kimlik üretir,
  // history/audit KOPYALAMAZ; kaynak temayı `duplicatedFrom` ile işaretler.
  // createdBy/updatedBy = platform kullanıcı id (audit; PII taşımaz).
  duplicatedFrom     String?
  createdBy          String?
  updatedBy          String?
  // TODO-164B (ADR-232/233/234) — Theme Productization & Role Separation (additive,
  // nullable → mevcut satırlar korunur).
  //   ownerScope        "STORE" (mağaza teması) | "PLATFORM" (kütüphane template'i).
  //   overridePolicy    Store Admin'in hangi alanları değiştirebileceği (editable/
  //                     locked/inherited/required/hidden) + izinli font/palet/düzen.
  //                     Null → geriye uyum (defaultOverridePolicy = hepsi editable).
  //   sourceThemeId     Bu mağaza teması hangi PLATFORM template'inden türetildi.
  //   sourceThemeVersion Türetildiği template published sürümü → update-available.
  ownerScope         String   @default("STORE")
  overridePolicy     Json?
  sourceThemeId      String?
  sourceThemeVersion Int?
  // TODO-164B Dilim 2 (ADR-238/244) — override policy revizyon sayacı. Her policy
  // değişikliğinde artar (audit + "policy değişti" before/after özeti; mevcut veriyi
  // SİLMEZ). 0 = policy hiç değişmedi. Additive, güvenli default.
  policyRevision     Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  versions ThemeVersion[]

  @@index([storeId])
  @@index([storeId, status])
  @@index([ownerScope])
}

// Tema versiyonu (immutable snapshot). Her publish YENİ versiyon üretir; tema
// içinde yalnız biri "DRAFT" (üzerinde çalışılan) ve yalnız biri "PUBLISHED"
// (yayında) olur — rollback mevcut bir arşiv versiyonundan yeni draft/publish
// üretir. `document` tam ThemeDocument'i (design+semantic+component+assets+
// customCss) taşır; `schemaVersion` @commerce-os/theme belge sürümüdür.
// storeId denormalize tenant sütunudur (hızlı izolasyon + savunma).
model ThemeVersion {
  id                   String    @id @default(cuid())
  themeId              String
  storeId              String
  version              Int
  // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  status               String    @default("DRAFT")
  schemaVersion        Int       @default(1)
  label                String?
  notes                String?
  document             Json
  // TODO-164 (ADR-223) — layout/slot yapılandırması (draftConfig = DRAFT sürüm,
  // publishedConfig = PUBLISHED sürüm; token `document` ile AYNI versiyonlama).
  // Typed schema (@commerce-os/theme themeConfigSchema) ile doğrulanır.
  config               Json      @default("{}")
  // Sürüm anındaki theme-key/layout preset snapshot'ı (audit + rollback bütünlüğü).
  themeKey             String?
  layoutPreset         String?
  // TODO-164B Dilim 2 (ADR-243) — TD-162 logo/favicon DRAFT staging. Kalıcı OTORİTE
  // StoreSettings olarak kalır; bunlar YALNIZ draft sürecinde sahnelenen (staged)
  // referanslardır. Publish anında ATOMİK olarak StoreSettings'e yazılır ve o anki
  // StoreSettings değeri `assetSnapshot`'a alınır (rollback için). Production görünümü
  // publish'e kadar DEĞİŞMEZ. ThemeDocument içinde ikinci kalıcı logo kaynağı DEĞİL.
  stagedLogoMediaId    String?
  stagedFaviconMediaId String?
  // Publish anında yakalanan önceki StoreSettings asset görünümü ({logoMediaId,
  // faviconMediaId}) — rollback bu snapshot'a döner. Null = asset publish edilmedi.
  assetSnapshot        Json?
  // Publish eden platform kullanıcı id'si (audit; PII taşımaz — yalnız id).
  publishedBy          String?
  createdAt            DateTime  @default(now())
  publishedAt          DateTime?

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([themeId, version])
  @@index([themeId])
  @@index([themeId, status])
  @@index([storeId])
}

// ─────────────────────── Faz 1B (ADR-067) — Attribute katalog cekirdegi ───────────────────────
// Kategoriye-bagli dinamik urun ozelliklerinin KATALOG temeli. Bu faz yalniz TANIM
// katmanidir: urun/varyant deger tablolari (ProductAttributeValue vb.) KAPSAM DISI.
// Kategori mirasi ve overrideMode UYGULANMAZ (ADR-067 md.7, YAGNI).

// Attribute TANIMI. scope=PLATFORM (tum magazalar, storeId null, yalniz SUPER_ADMIN)
// veya scope=STORE (tek magaza, storeId zorunlu, ilgili store admin). `code` immutable
// (service guard); `dataType` kullanim basladiktan sonra immutable (service guard).
// Davranis TASIMAZ — davranis yalniz CategoryAttribute'ta tutulur (tek sahip).
model AttributeDefinition {
  id          String            @id @default(cuid())
  scope       AttributeScope
  // PLATFORM => null; STORE => zorunlu (route katmani doldurur). Composite unique
  // ([storeId, code]) STORE cakismasini DB'de yakalar; PLATFORM (null storeId) icin
  // Postgres NULL'lari distinct saydigindan duplicate-code route katmaninda kontrol
  // edilir (kategori slug deseniyle ayni).
  storeId     String?
  code        String
  name        String
  description String?
  dataType    AttributeDataType
  unit        String?
  status      AttributeStatus   @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  store                 Store?                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  options               AttributeOption[]
  categoryLinks         CategoryAttribute[]
  // Faz 2A (ADR-068) — bu tanimi DEGER olarak kullanan urun/varyant satirlari (onDelete: Restrict).
  productValues         ProductAttributeValue[]
  variantValues         VariantAttributeValue[]
  // Faz 2C-1 (ADR-070) — bu tanimi variant-defining EKSEN olarak secen urun satirlari (onDelete: Restrict).
  variantSelectionLinks ProductVariantAttribute[]
  // Faz 2C-3 (ADR-072) — bu tanimi uretilmis varyant eksen degeri olarak kullanan satirlar (onDelete: Restrict).
  variantOptionValues   ProductVariantOptionValue[]
  // Faz 2C-7 (ADR-078) — bu tanimi media-tanimlayici EKSEN olarak secen urunler (onDelete: SetNull).
  mediaAxisProducts     Product[]                   @relation("ProductMediaAxis")
  // Faz 2C-7 (ADR-078) — bu eksene etiketli varyant-media gorselleri (onDelete: Restrict).
  productImageLinks     ProductImage[]              @relation("ProductImageMediaAxis")

  @@unique([storeId, code])
  @@index([storeId])
  @@index([scope])
  @@index([status])
}

// Attribute GRUBU — store-scoped sunum/organizasyon kabi ( or. "Teknik ozellikler").
// CategoryAttribute opsiyonel olarak bir gruba baglanir (groupId). Davranis tasimaz.
model AttributeGroup {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryLinks CategoryAttribute[]

  @@index([storeId])
}

// SELECT / MULTI_SELECT / COLOR tipli attribute'larin secenekleri. definition'a bagli
// (silinirse Cascade). storeId: STORE attribute seceneginde ilgili magaza, PLATFORM
// attribute seceneginde null. `value` bir tanim icinde benzersiz (duplicate option
// value DB'de yakalanir). colorHex yalniz COLOR icin anlamli (opsiyonel).
model AttributeOption {
  id                    String          @id @default(cuid())
  attributeDefinitionId String
  storeId               String?
  value                 String
  label                 String
  colorHex              String?
  sortOrder             Int             @default(0)
  status                AttributeStatus @default(ACTIVE)
  // TODO-165A (ADR-255) — Governed taksonomi + genel amacli serbest metadata (ör. taksonomi
  // sunum alanlari, harici kaynak referansi). Prisma tarafinda serbest; sema dogrulamasi
  // service katmaninda yapilir.
  metadata              Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  definition              AttributeDefinition             @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  store                   Store?                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Faz 2A (ADR-068) — bu secenegi DEGER olarak kullanan satirlar (onDelete: Restrict).
  productValues           ProductAttributeValue[]
  variantValues           VariantAttributeValue[]
  productValueLinks       ProductAttributeValueOption[]
  // Faz 2C-1 (ADR-070) — bu secenegi variant eksen option'i olarak secen satirlar (onDelete: Restrict).
  variantOptionSelections ProductVariantOptionSelection[]
  // Faz 2C-3 (ADR-072) — bu secenegi uretilmis varyant eksen degeri olarak kullanan satirlar (onDelete: Restrict).
  variantOptionValues     ProductVariantOptionValue[]
  // Faz 2C-7 (ADR-078) — bu option'a (renk) etiketli varyant-media gorselleri (onDelete: Restrict).
  productImages           ProductImage[]                  @relation("ProductImageMediaOption")
  // TODO-165A (ADR-255) — bu secenegi DESTEKLEYEN governed taksonomi degeri (1:1 ters iliski;
  // varligi "bu AttributeOption governed" isaretidir). onDelete davranisi ProductTaxonomyValue
  // tarafinda tanimlidir (Cascade — taksonomi degeri silinince destekledigi option KALIR,
  // ProductTaxonomyValue satiri kalkar).
  taxonomyValue           ProductTaxonomyValue?           @relation("TaxonomyBackingOption")

  // uniqueness enforced by two PARTIAL unique indexes in migration 20260801120000 (Prisma cannot express partial unique)
  @@index([attributeDefinitionId])
  @@index([storeId])
}

// Bir attribute'un bir KATEGORI kapsamindaki davranisinin TEK SAHIBI. AttributeDefinition
// (PLATFORM veya STORE) tek bir kategoriye en fazla bir kez baglanir. Tum davranis
// bayraklari + validationRules burada; AttributeDefinition davranis tasimaz. Kategori
// mirasi/overrideMode YOK (ADR-067 md.7).
model CategoryAttribute {
  id                    String  @id @default(cuid())
  storeId               String
  categoryId            String
  attributeDefinitionId String
  groupId               String?

  required             Boolean @default(false)
  filterable           Boolean @default(false)
  searchable           Boolean @default(false)
  comparable           Boolean @default(false)
  variantDefining      Boolean @default(false)
  visibleOnProductPage Boolean @default(true)
  visibleOnListing     Boolean @default(false)

  displayOrder    Int  @default(0)
  validationRules Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)
  group      AttributeGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([categoryId, attributeDefinitionId])
  @@index([storeId])
  @@index([categoryId])
  @@index([attributeDefinitionId])
  @@index([groupId])
}

// ─────────────────────── Faz 2A (ADR-068) — Urun/varyant attribute DEGER tablolari ───────────────────────
// Faz 1B katalog TANIMINI (AttributeDefinition + CategoryAttribute davranisi) tuketip
// urun ve varyantlarin gercek attribute DEGERLERINI saklar. TUM yazimlar tek nokta olan
// `attributeValueService`'ten gecer (route dogrudan Prisma'ya yazmaz). Tip guvenli
// saklama: her dataType icin AYRI kolon (JSON kullanilmaz); bir satirda EN FAZLA bir
// deger kolonu dolu olabilir (DB CHECK + servis). MULTI_SELECT degeri junction tabloda
// (deger kolonlari bos kalir). combinationKey / otomatik varyant / order snapshot Faz 2B+.

// Bir urunun bir attribute icin DEGERI. dataType -> kolon eslemesi (servis otoritesi):
//  TEXT/TEXTAREA/RICH_TEXT/URL -> valueText, INTEGER -> valueInteger, DECIMAL -> valueDecimal,
//  BOOLEAN -> valueBoolean, DATE -> valueDate, SELECT/COLOR -> optionId, IMAGE/FILE -> mediaId,
//  MULTI_SELECT -> ProductAttributeValueOption (junction; tum deger kolonlari bos).
// storeId denormalize tenant sutunudur. definition/option/media onDelete: Restrict
// (kullanimda olan tanim/secenek/gorsel silinemez — katalog usage-guard felsefesi).
model ProductAttributeValue {
  id                    String @id @default(cuid())
  storeId               String
  productId             String
  attributeDefinitionId String

  // Tip guvenli deger kolonlari — bir satirda EN FAZLA biri dolu (DB CHECK + servis).
  valueText    String?
  valueInteger Int?
  valueDecimal Decimal?  @db.Decimal(20, 6)
  valueBoolean Boolean?
  valueDate    DateTime?
  optionId     String? // SELECT / COLOR
  mediaId      String? // IMAGE / FILE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store       Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition  AttributeDefinition           @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  option      AttributeOption?              @relation(fields: [optionId], references: [id], onDelete: Restrict)
  media       MediaAsset?                   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  optionLinks ProductAttributeValueOption[]

  // Bir urun + attribute en fazla bir kez (deger tekildir; MULTI_SELECT'te coklu secenek
  // junction'da tutulur, parent yine tekildir).
  @@unique([productId, attributeDefinitionId])
  @@index([storeId])
  @@index([productId])
  @@index([attributeDefinitionId])
  @@index([optionId])
  @@index([mediaId])
}

// Bir varyantin bir attribute icin DEGERI. YALNIZ variantDefining attribute'lar burada
// tutulur (servis guard). Deger yalnizca metin (valueText) veya secenek (optionId)
// olabilir — MULTI_SELECT/IMAGE/FILE variant tablosuna yazilmaz. combinationKey UYGULANMAZ.
model VariantAttributeValue {
  id                    String @id @default(cuid())
  storeId               String
  variantId             String
  attributeDefinitionId String

  valueText String? // TEXT/TEXTAREA/RICH_TEXT/URL
  optionId  String? // SELECT / COLOR

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  option     AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeDefinitionId])
  @@index([storeId])
  @@index([variantId])
  @@index([attributeDefinitionId])
  @@index([optionId])
}

// MULTI_SELECT icin junction: bir ProductAttributeValue (parent) <-> secilen AttributeOption'lar.
// JSON KULLANILMAZ (iliskisel butunluk + gelecekte faceted-filtre icin sorgulanabilir).
// parent silinince Cascade; secenek Restrict (kullanimdaki secenek silinemez).
model ProductAttributeValueOption {
  id                      String @id @default(cuid())
  storeId                 String
  productAttributeValueId String
  optionId                String

  createdAt DateTime @default(now())

  store  Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  value  ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id], onDelete: Cascade)
  option AttributeOption       @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([productAttributeValueId, optionId])
  @@index([storeId])
  @@index([productAttributeValueId])
  @@index([optionId])
}

// ─────────────────────── Faz 2C-1 (ADR-070) — Varyant motoru TEMELI (eksen secimi) ───────────────────────
// Bir urunun hangi variant-defining attribute'lari EKSEN (axis) olarak kullanacagini ve her
// eksen altinda hangi AttributeOption'lari kapsayacagini NORMALIZE saklar (JSON YOK). Bu faz
// KOMBINASYON URETMEZ: ProductVariant / combinationKey / Cartesian / SKU matris OLUSTURULMAZ.
// Gelecekteki Combination Engine bu iki tabloyu (eksenler × secilen option'lar) okuyup Cartesian
// carpimini uretecek. Yazimlar TEK NOKTA olan `variantSelectionService`'ten gecer (route dogrudan
// Prisma'ya yazmaz — Faz 2A attributeValueService deseni). Yalniz option-tabanli (SELECT/COLOR)
// variantDefining=true CategoryAttribute eksen olabilir (VariantAttributeValue tek option tasir →
// eksen tek-secimli olmali); dogrulama servistedir.

// Bir urunde EKSEN olarak secilen variant-defining attribute. Bir urun + attribute en fazla bir kez.
// definition onDelete: Restrict (eksen olarak kullanilan tanim silinemez — katalog usage-guard
// felsefesi, Faz 2A ile tutarli); product/store Cascade. storeId denormalize tenant sutunu.
model ProductVariantAttribute {
  id                    String @id @default(cuid())
  storeId               String
  productId             String
  attributeDefinitionId String
  // Eksenlerin admin-tanimli sirasi (UI displayOrder; ileride kombinasyon ekseni sirasi).
  position              Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store                           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product                         @relation(fields: [productId], references: [id], onDelete: Cascade)
  definition AttributeDefinition             @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  options    ProductVariantOptionSelection[]

  @@unique([productId, attributeDefinitionId])
  @@index([storeId])
  @@index([productId])
  @@index([attributeDefinitionId])
}

// Bir varyant ekseni (ProductVariantAttribute) altinda KAPSANAN AttributeOption. Bir eksen +
// option en fazla bir kez. option onDelete: Restrict (kullanimdaki secenek silinemez); parent/store
// Cascade. En az bir option zorunlulugu servistedir (DB CHECK ile ifade edilemez — cross-row).
model ProductVariantOptionSelection {
  id                        String @id @default(cuid())
  storeId                   String
  productVariantAttributeId String
  optionId                  String
  // Option'larin admin-tanimli sirasi (UI displayOrder).
  position                  Int    @default(0)

  createdAt DateTime @default(now())

  store     Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attribute ProductVariantAttribute @relation(fields: [productVariantAttributeId], references: [id], onDelete: Cascade)
  option    AttributeOption         @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([productVariantAttributeId, optionId])
  @@index([storeId])
  @@index([productVariantAttributeId])
  @@index([optionId])
}

// ─────────────────────── Faz 2C-3 (ADR-072) — Uretilmis varyantin cozulmus eksen->option secimi ───────────────────────
// Bir ATTRIBUTE_COMBINATION varyantinin hangi eksen (attributeDefinitionId) icin hangi AttributeOption'i
// temsil ettigini NORMALIZE saklar (JSON YOK; optionValues authoritative DEGIL). combinationKey ile
// tutarlidir (ayni pairlar). Bir varyant + attribute en fazla bir kez (@@unique) → cift deger onlenir.
// YAZMA OTORITESI variant-generation persistence-service'tir (2A VariantAttributeValue'dan AYRIDIR —
// oranin tek yazicisi attributeValueService; single-writer invariantlari karismasin diye ayri tablo).
// definition/option onDelete: Restrict (kullanimdaki tanim/secenek silinemez — katalog usage-guard);
// variant/store Cascade. archive/restore bu satirlara DOKUNMAZ (yalniz create yazar, cascade delete siler).
model ProductVariantOptionValue {
  id                    String @id @default(cuid())
  storeId               String
  variantId             String
  attributeDefinitionId String
  optionId              String

  createdAt DateTime @default(now())

  store      Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant    ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  definition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)
  option     AttributeOption     @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([variantId, attributeDefinitionId])
  @@index([storeId])
  @@index([variantId])
  @@index([attributeDefinitionId])
  @@index([optionId])
}

// ─────────────────────── TODO-165 Fashion Vertical (ADR-249) — Size Chart ───────────────────────
// Magaza-ozel BEDEN OLCU TABLOSU. Store/kategori/urun scope; publish/rollback icin IMMUTABLE
// revizyon snapshot'lari. `sizeSystemKey` serbest DEGIL — kod-seviyesi SIZE_SYSTEM_REGISTRY'ye
// (@commerce-os/contracts/size-systems) karsi dogrulanir. columns/rows PLAIN-TEXT sunum verisidir
// (raw HTML/CSS/JS YOK; server-side sema dogrulamasi). Tenant-scoped (cross-store erisim yok).
enum SizeChartStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SizeChart {
  id                  String          @id @default(cuid())
  storeId             String
  name                String
  // SizeSystemKey (kod registry ile dogrulanir; DB'de string). Ornek: "INTERNATIONAL","SHOES_EU".
  sizeSystemKey       String
  // "CM" | "IN" | "NONE" (SizeMeasurementUnit). Olcu kolonlarinin birimi.
  measurementUnit     String          @default("CM")
  // Opsiyonel cinsiyet/kategori uyum ipucu (SizeCategoryKind ya da gender etiketi).
  gender              String?
  locale              String?
  status              SizeChartStatus @default(DRAFT)
  // Yayinlanan aktif revizyon (SizeChartRevision.id). NULL → henuz yayinlanmadi.
  publishedRevisionId String?
  // DRAFT calisma kopyasi (yayinlanmamis duzenleme). Publish aninda bir SizeChartRevision
  // snapshot'ina donusur. columns: [{key,label,unit?}], rows: [{size,cells}].
  draftColumns        Json            @default("[]")
  draftRows           Json            @default("[]")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  store       Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  revisions   SizeChartRevision[]
  assignments SizeChartAssignment[]

  @@index([storeId])
  @@index([storeId, status])
}

// Yayinlanmis/rollback icin IMMUTABLE snapshot. Her publish revision +1 uretir; eski
// revizyonlar korunur (rollback bu snapshot'a doner). columns/rows JSON = dogrulanmis
// sunum verisi (plain-text hucreler).
model SizeChartRevision {
  id          String   @id @default(cuid())
  storeId     String
  sizeChartId String
  revision    Int
  // columns: [{ key, label, unit? }] — olcu kolonlari ( or. "Gogus","Bel").
  columns     Json
  // rows: [{ size, cells: { <colKey>: string|number } }] — her beden icin olculer.
  rows        Json
  locale      String?
  createdAt   DateTime @default(now())

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sizeChart SizeChart @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)

  @@unique([sizeChartId, revision])
  @@index([storeId])
  @@index([sizeChartId])
}

enum SizeChartScope {
  STORE
  CATEGORY
  PRODUCT
}

// Bir size chart'in baglandigi kapsam. PDP cozumu: PRODUCT > CATEGORY > STORE onceligi.
// categoryId/productId scope'a gore doldurulur (STORE scope'ta ikisi de NULL).
model SizeChartAssignment {
  id          String         @id @default(cuid())
  storeId     String
  sizeChartId String
  scope       SizeChartScope
  categoryId  String?
  productId   String?
  createdAt   DateTime       @default(now())

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sizeChart SizeChart        @relation(fields: [sizeChartId], references: [id], onDelete: Cascade)
  category  ProductCategory? @relation("SizeChartCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  product   Product?         @relation("SizeChartProduct", fields: [productId], references: [id], onDelete: Cascade)

  // Ayni scope-hedefi icin tek atama (cakisma engeli).
  @@unique([storeId, scope, categoryId, productId])
  @@index([storeId])
  @@index([sizeChartId])
  @@index([categoryId])
  @@index([productId])
}

// ─────────────────────── TODO-150 (ADR-073) — Identity Management Engine ───────────────────────
// Bir bulk-apply'da degistirilebilen kimlik alani. Bu faz SKU|BARCODE|TITLE aktif; GTIN/EAN/UPC/
// ERP/marketplace ileride bu enum'a EKLENEREK (alan-agnostik motor) genisler.
enum VariantIdentityField {
  SKU
  BARCODE
  TITLE
}

// Identity Engine bulk-apply audit'i (APPEND-ONLY). Her degisen alan icin bir satir; hepsi tek bir
// batchId paylasir (apply basina bir cuid, tek transaction) → UNDO metadata temeli (bir batch'i yukle,
// oldValue'lari geri yaz). changedByPlatformUserId FK DEGIL, dogrudan scalar: kullanici silinse bile
// tarihsel kayit korunur (ProductPriceChange deseni). pattern: uygulanan ham kural (echo/tani).
// store/product/variant onDelete Cascade (varyant silinirse audit de gider — tarihsel referans yok).
model VariantIdentityChange {
  id                      String               @id @default(cuid())
  storeId                 String
  productId               String
  variantId               String
  batchId                 String
  field                   VariantIdentityField
  oldValue                String?
  newValue                String?
  pattern                 String?
  changedByPlatformUserId String?
  createdAt               DateTime             @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
  @@index([variantId])
  @@index([batchId])
}

// TODO-151 (ADR-074) — Commercial Engine yonetilen ticari alanlar (rule hedefi + audit alan enum'u).
enum CommercialField {
  PRICE
  COMPARE_AT_PRICE
  COST
  VAT_RATE
}

// Commercial apply kaynagi: kullanicinin dogrudan hucre duzenlemesi mi, toplu kural mi.
enum CommercialChangeSource {
  DIRECT_EDIT
  BULK_RULE
}

// Commercial Engine bulk-apply audit'i (APPEND-ONLY). Her degisen alan icin bir satir; hepsi tek bir
// batchId paylasir (apply basina bir cuid, tek transaction) → UNDO metadata temeli. oldValue/newValue
// money alanlarinda minor (kurus), VAT_RATE'te bps; currency birlikte tutulur. ruleSnapshot: BULK_RULE
// apply'inin uygulanan yapisal kurali (echo/tani; secret icermez). changedByPlatformUserId FK DEGIL,
// dogrudan scalar: kullanici silinse bile tarihsel kayit korunur (ProductPriceChange/VariantIdentityChange
// deseni). store/product/variant onDelete Cascade. Mevcut ProductVariant fiyat kolonlari DEGISMEZ;
// ProductPriceChange (F4B) da BOZULMAZ — bu ayri, alan-bazli ticari izdir.
model VariantCommercialChange {
  id                      String                 @id @default(cuid())
  storeId                 String
  productId               String
  variantId               String
  batchId                 String
  field                   CommercialField
  oldValue                Int?
  newValue                Int?
  currency                String
  source                  CommercialChangeSource
  ruleSnapshot            Json?
  changedByPlatformUserId String?
  createdAt               DateTime               @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([productId])
  @@index([variantId])
  @@index([batchId])
  @@index([storeId, variantId, createdAt])
}

// ─────────────────────── Faz 2C-8A (ADR-079) — Search Read-Model ───────────────────────
// Turetilmis, DENORMALIZE arama okuma-modeli. SOURCE-OF-TRUTH DEGILDIR — otorite hala normal
// Product/ProductVariant/EAV/Inventory tablolaridir; bu iki tablo yalniz SearchProvider (worker/
// backfill) tarafindan turetilir ve yazilir. Hicbir public uc bu satirlari DOGRUDAN dondurmez
// (public allowlist projeksiyonu bozulmaz). Bu fazda public search/facet UCU YOKTUR — yalniz temel.
//
// Store/Product onDelete: Cascade → magaza/urun silinince read-model otomatik temizlenir (worker
// remove-job'a ek DB-seviyesi guvence; orphan kalmaz). costMinor/netPriceMinor/storageKey/mediaId
// gibi ic alanlar bu tablolara BILINCLI olarak TASINMAZ.

enum SearchAvailabilityState {
  IN_STOCK
  OUT_OF_STOCK
  // PRE_ORDER / COMING_SOON: kaynak urun/varyant bayraklari henuz YOK (Faz sonrasi). Enum bilincli
  // olarak ileriye acik birakildi — eklendiginde builder projeksiyonu genisler, migration gerekmez.
}

// Bir PUBLIC-GORUNUR (status=ACTIVE) urun basina BIR arama dokumani. Urun ACTIVE degilse dokuman
// TUTULMAZ (indexProduct remove'a duser) → gelecekteki facet count'lari kirletmez. minPrice/maxPrice
// yalniz gorunur-fiyatli ACTIVE varyantlar uzerinden; hasStock/availability Inventory Engine'den turer.
model ProductSearchDocument {
  id                        String                   @id @default(cuid())
  storeId                   String
  productId                 String                   @unique
  // primaryCategoryId YALNIZ breadcrumb/canonical navigation icindir (URL, ekmek kirintisi).
  // PLP/kategori gorunurlugu ARTIK categoryIds/categorySlugs uzerinden calisir (TODO-165B).
  primaryCategoryId         String?
  // TODO-165B — Cok-kategori indexleme. Urunun bagli oldugu TUM kategoriler (primary + secondary
  // ProductCategoryAssignment). Kategori subtree sorgusu categoryIds ile (id containment), slug
  // dogrudan erisim categorySlugs ile eslenir. Urun bagli oldugu HER kategoride gorunur; PLP
  // duplicate DONMEZ (tek dokuman/urun). Tenant isolation storeId ile korunur.
  categoryIds               String[]                 @default([])
  categorySlugs             String[]                 @default([])
  title                     String
  slug                      String
  brand                     String?
  // TODO-165A (ADR-254) — Governed Brand snapshot (turetilmis; product.brandId varsa doldurulur).
  // brand (yukarida, legacy serbest-metin) ile birlikte YASAR — reindex ikisini de bagimsiz yazar.
  brandId                   String?
  brandSlug                 String?
  brandName                 String?
  // Normalize edilmis aranabilir metin (title + brand + searchable attribute degerleri + aciklama).
  // `searchVector` tsvector generated STORED kolon bundan turer (migration SQL); GIN indeks orada.
  searchText                String
  // Postgres FTS vektoru — GENERATED ALWAYS (migration). Prisma Client'ta okunmaz/yazilmaz (DB uretir).
  searchVector              Unsupported("tsvector")?
  status                    ProductStatus
  minPriceMinor             Int?
  maxPriceMinor             Int?
  currency                  String?
  hasStock                  Boolean                  @default(false)
  availability              SearchAvailabilityState  @default(OUT_OF_STOCK)
  variantCount              Int                      @default(0)
  // ── TODO-155.1 (ADR-079) — Faz 2C-9 · Listing Projection Enrichment (ADDITIVE) ──
  // Kart gosterimi icin INDEX ANINDA deterministik snapshot'lanan TURETILMIS ticari alanlar.
  // Source-of-truth DEGIL (checkout fiyat otoritesi canli tablolardir); yalniz kart gorunumu.
  // compareAtMinor: en ucuz gorunur (numerik fiyatli) ACTIVE varyantin compareAt'i (yalniz > satis fiyati).
  // discountPercent: tek server-side formul round((compareAt-price)/compareAt*100); indirim yoksa null.
  // omnibusPreviousPriceMinor: EU Omnibus son 30 gun en dusuk SATIS fiyati (yalniz indirim aktifken); yoksa null.
  compareAtMinor            Int?
  discountPercent           Int?
  omnibusPreviousPriceMinor Int?
  // BOUNDED kart medya/swatch projection'i (SADECE kart; genel EAV/facet verisi DEGIL — o ProductFacetValue'da
  // relational kalir). storageKey'ler IC alandir (public url runtime'da turetilir; DTO'ya SIZMAZ). OpenSearch'e
  // gecis serialize'inda dogal nested doc olur. Bicim: { primaryImage, secondaryImage, swatches[], swatchTotalCount }.
  listing                   Json?
  // ── TODO-155.2 (ADR-079 Ek) — Faz 2C-9B · Campaign Badge Snapshot (ADDITIVE) ──
  // Index ANINDA paylasilan selectPublicCampaignDisplay ile snapshot'lanan PUBLIC-SAFE kampanya rozeti (BIRINCIL).
  // PDP ile AYNI "tek formul" (ADR-062) → PDP↔PLP tutarliligi. Source-of-truth DEGIL (checkout otoriter);
  // yalniz kart "Sepette" sunumu. campaign = PublicCampaignBadge JSON (allowlist; ic id/limit/priority SIZMAZ)
  // ya da null. campaignStartsAt/EndsAt = kazanan kampanyanin GECERLILIK penceresi → read-time bastirma
  // (now<start ya da now>end ise rozet gosterilmez; bayat snapshot vitrine sizmaz). Reconciliation temizler.
  campaign                  Json?
  campaignStartsAt          DateTime?
  campaignEndsAt            DateTime?
  // Kaynak zaman damgalari (siralama/tani) + indeksleme metaverisi (revision her reindex'te artar).
  productCreatedAt          DateTime
  productUpdatedAt          DateTime
  indexedAt                 DateTime                 @default(now())
  revision                  Int                      @default(0)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([storeId, primaryCategoryId])
  @@index([storeId, minPriceMinor])
  @@index([storeId, hasStock])
  @@index([storeId, availability])
  @@index([storeId, productCreatedAt])
  // TODO-155.2 — Reconciliation sweep: suresi gecmis kampanya snapshot'larini bounded taramak icin.
  @@index([storeId, campaignEndsAt])
  // TODO-161B (ADR-142) — Similar Products Tier 3 (ayni marka) aday sorgusu: 50k+ katalogda marka-hedefli
  // daraltma icin (aksi halde storeId index'i tum magazayi tarayip brand'i residual filtreler).
  @@index([storeId, brand])
  // TODO-165A (ADR-254) — Governed marka slug'iyla PLP filtreleme/listeleme.
  @@index([storeId, brandSlug])
  // TODO-165B — Cok-kategori PLP filtreleme icin array containment (categoryIds && subtree_ids /
  // categorySlugs && [slug]). GIN indeks olmadan buyuk katalogda seq-scan olur.
  @@index([categoryIds], type: Gin)
  @@index([categorySlugs], type: Gin)
}

// Flat facet IS ATI: bir (urun × filterable attribute × DEGER) satiri. YALNIZ CategoryAttribute.
// filterable=true attribute'lardan uretilir (hardcode facet YOK). Bir satirda EN FAZLA bir typed
// deger kolonu dolu (optionId | valueText | valueNumber | valueBoolean | valueDate) — builder
// invariant'i + DB CHECK (migration). Ayni urunun ayni degeri (or. coklu varyantta ayni renk)
// builder'da TEKILLESTIRILIR → duplicate satir yok. Urunun tam reindex'i delete-and-replace
// (atomik, tek transaction) — kategori/attribute degisince eski satirlar KALMAZ. categoryId =
// facet'in cikartildigi kaynak kategori (urunun primaryCategory'si).
model ProductFacetValue {
  id                    String    @id @default(cuid())
  storeId               String
  productId             String
  categoryId            String
  attributeDefinitionId String
  optionId              String?
  valueText             String?
  valueNumber           Decimal?  @db.Decimal(20, 6)
  valueBoolean          Boolean?
  valueDate             DateTime?
  // optionId/valueText degerinin normalize (lowercase/trim) hali — facet count grupla + arama zemini.
  normalizedText        String?

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Facet count'un iş atı: kategori+attribute+option grupla-say (kendi-facet-haric kurali Faz B).
  @@index([storeId, attributeDefinitionId, optionId])
  @@index([storeId, attributeDefinitionId, valueNumber])
  @@index([storeId, categoryId, attributeDefinitionId])
  @@index([storeId, productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TODO-156D (ADR-081/082) — SEO URL YONETIMI TEMELI (additive; henuz gateway/UI'ya
// BAGLI DEGIL — brief §19 "Admin Foundation: servisleri hazirla, UI yapma"). Slug
// uretim/normalizasyon + redirect cozumleme MANTIGI cerceve-bagimsiz @commerce-os/utils'
// tedir (slug.ts / redirect.ts); bu tablolar o mantigin KALICILIK zeminidir. Tenant-aware
// (storeId). Silinen entity davranisi: history satiri KALIR (eski URL redirect'i icin);
// redirect kurallari elle/otomatik yonetilir (bkz. TECHNICAL_DEBT — canli wiring bir sonraki faz).
// ─────────────────────────────────────────────────────────────────────────────

/// Slug gecmisi/redirect'in ait oldugu entity turu (product/kategori/gelecek CMS sayfasi).
enum SlugEntityType {
  PRODUCT
  CATEGORY
  CMS_PAGE
  // ADR-265 — Marka slug yasam dongusu (storefront `/markalar/[slug]`). Marka slug degisince
  // SlugHistory + otomatik 301 uretimi bu tur uzerinden yazilir (urun/kategori ile simetrik).
  BRAND
}

/// HTTP redirect statusu. Otomatik slug degisimi DAIMA PERMANENT_301 (uygulama karari).
enum RedirectType {
  PERMANENT_301
  FOUND_302
  TEMPORARY_307
  PERMANENT_308
}

/// ADR-265 — Redirect kaydinin KAYNAGI. AUTOMATIC: slug degisiminden `recordSlugChange` uretti
/// (kullanici dogrudan SILEMEZ; yalniz aktif/pasif). MANUAL: Admin SEO ekraninda elle olusturuldu
/// (tam CRUD). Otomatik/manuel ayrimi kolon + filtre + silme guvenligi icin tasinir.
enum RedirectOrigin {
  AUTOMATIC
  MANUAL
}

/// Bir entity'nin ESKI slug'i (slug degisince yazilir). Amac: eski URL'ler bozulmasin →
/// buradan bir Redirect turetilebilir. Ayni (store, tur, oldSlug) tekildir (deterministik lookup).
model SlugHistory {
  id         String         @id @default(cuid())
  storeId    String
  entityType SlugEntityType
  entityId   String
  oldSlug    String
  createdAt  DateTime       @default(now())
  createdBy  String?

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, entityType, oldSlug])
  @@index([storeId])
  @@index([storeId, entityType, entityId])
}

/// Yonlendirme kurali (kaynak path → hedef path). Cozumleme (chain/loop guard) SAF motorda
/// (@commerce-os/utils redirect.ts). (store, sourcePath) tekil → tek kaynak-tek kural (precedence net).
model Redirect {
  id         String         @id @default(cuid())
  storeId    String
  sourcePath String
  targetPath String
  type       RedirectType   @default(PERMANENT_301)
  // ADR-265 — kaynak: otomatik (slug degisimi) vs manuel (Admin SEO). Mevcut satirlar slug
  // degisiminden gelir → varsayilan AUTOMATIC. Admin elle olusturunca MANUAL yazilir.
  origin     RedirectOrigin @default(AUTOMATIC)
  enabled    Boolean        @default(true)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, sourcePath])
  @@index([storeId])
  @@index([storeId, enabled])
  @@index([storeId, origin])
}

// ============================================================================
// TODO-160 (ADR-102…107) — Influencer Tracking & Attribution.
//
// Zincir: link → tiklama → oturum → sepet → checkout → siparis → net gelir.
// Attribution SUNUCU-otoriter ve siparis aninda SNAPSHOT'lanir (ADR-103); rapor
// gecmisi yeniden HESAPLAMAZ. Gross ve net gelir AYRI tasinir (ADR-104): iade
// net'i duzeltir, gross'u geriye donuk BOZMAZ. Tenant izolasyonu: her tabloda
// storeId + @@index([storeId]). Para tamsayi minor unit.
// ============================================================================

/// Influencer/is ortagi kimligi (dis kisi/anlasma iliskisi — ADR-091). code
/// store scope'unda tekildir (link/rapor icin insan-okur kisa kimlik).
model Influencer {
  id        String           @id @default(cuid())
  storeId   String
  name      String
  code      String
  email     String?
  status    InfluencerStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  store             Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaigns         InfluencerCampaign[]
  orderAttributions OrderAttribution[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

/// Influencer kampanyasi: attributionWindowDays kampanya BAZLI attribution
/// penceresini (gun) belirler. startsAt/endsAt opsiyonel aktiflik penceresi.
model InfluencerCampaign {
  id                    String                   @id @default(cuid())
  storeId               String
  influencerId          String
  name                  String
  status                InfluencerCampaignStatus @default(ACTIVE)
  attributionWindowDays Int                      @default(30)
  startsAt              DateTime?
  endsAt                DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  store             Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  influencer        Influencer               @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  trackingLinks     InfluencerTrackingLink[]
  clicks            AttributionClick[]
  orderAttributions OrderAttribution[]

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, influencerId])
  @@index([influencerId])
}

/// Takip linki. token OPAK + tahmin-edilemez (144-bit) + anlamli-id-TASIMAZ.
/// PLAIN token DB'de SAKLANMAZ (ADR-102 revizyon): yalnizca HMAC-SHA256 lookup
/// hash'i (`tokenHash`) tutulur → DB sizintisinda kullanilabilir URL geri elde
/// edilemez. Plain URL yalnizca OLUSTURMA/YENIDEN-URETME aninda BIR KEZ doner;
/// liste/detay token'i tekrar GOSTERMEZ. Yenileme (regenerate) eski token'i
/// GECERSIZ kilar (rotasyon/iptal). Hedef SUNUCUDA guvenli iç yola cevrilir
/// (open-redirect yok). utm* raporlama baglamidir.
model InfluencerTrackingLink {
  id          String                 @id @default(cuid())
  storeId     String
  campaignId  String
  tokenHash   String
  targetType  TrackingLinkTargetType @default(HOME)
  targetPath  String                 @default("/")
  productId   String?
  categoryId  String?
  // UTM raporlama baglamidir. ADR-175: UTM link olusturmada set edilir, sonradan
  // DEGISTIRILMEZ (immutable) → click-seviyesi UTM raporu link join'iyle tarihsel dogru.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  customLabel String?
  status      TrackingLinkStatus     @default(ACTIVE)
  // Yasam dongusu zaman damgalari (ADR-170) — link detay dashboard'unda gosterilir.
  activatedAt DateTime?
  pausedAt    DateTime?
  revokedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign          InfluencerCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  category          ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  clicks            AttributionClick[]
  orderAttributions OrderAttribution[]

  @@unique([storeId, tokenHash])
  @@index([storeId])
  @@index([storeId, campaignId])
  @@index([campaignId])
  @@index([productId])
  @@index([categoryId])
}

/// Tiklama olayi. KVKK (ADR-106): ham IP/UA/referrer SAKLANMAZ — yalniz tuzlu
/// HMAC hash + referrer HOST. visitorIdHash = HMAC(SESSION_SECRET, first-party
/// visitor id). isBot bilinen bot UA'lar icin true (metrik paydalarindan DISLANIR).
model AttributionClick {
  id             String   @id @default(cuid())
  storeId        String
  campaignId     String
  trackingLinkId String
  visitorIdHash  String
  sessionIdHash  String?
  ipHash         String?
  userAgentHash  String?
  referrerHost   String?
  landingPath    String
  isBot          Boolean  @default(false)
  createdAt      DateTime @default(now())

  store    Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign InfluencerCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  link     InfluencerTrackingLink @relation(fields: [trackingLinkId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([trackingLinkId, createdAt])
  @@index([campaignId, createdAt])
  // Rapid-repeat dedupe sorgusu (ADR-105): ayni ziyaretci+link kisa pencerede.
  @@index([storeId, trackingLinkId, visitorIdHash, createdAt])
}

/// Siparis attribution SNAPSHOT'i (ADR-103, immutable kimlik alanlari). Siparis
/// basina TEK (@@unique). Influencer/campaign sonradan degisse bile snapshot
/// (Json) siparis anindaki degerleri korur. Gross booking = siparis PLACE aninda;
/// net = gross - refunded (ADR-104). customerId TUTULMAZ (PII minimizasyonu).
model OrderAttribution {
  id                   String           @id @default(cuid())
  storeId              String
  orderId              String           @unique
  influencerId         String
  campaignId           String
  trackingLinkId       String?
  attributionModel     AttributionModel @default(LAST_CLICK)
  attributedAt         DateTime         @default(now())
  grossRevenueMinor    Int
  refundedRevenueMinor Int              @default(0)
  netRevenueMinor      Int
  currency             String
  snapshot             Json
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  store      Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order      Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  influencer Influencer               @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  campaign   InfluencerCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  link       InfluencerTrackingLink?  @relation(fields: [trackingLinkId], references: [id], onDelete: SetNull)
  refunds    OrderAttributionRefund[]

  // orderId zaten tekil (1-1) → ayrica @@unique([storeId, orderId]) gereksiz.
  @@index([storeId])
  @@index([storeId, campaignId, attributedAt])
  @@index([storeId, influencerId, attributedAt])
  @@index([campaignId])
  @@index([influencerId])
  @@index([trackingLinkId])
}

/// Append-only iade defteri (ADR-104). refundKey iade olayinin idempotency
/// anahtaridir (cancel:<orderId> ya da provider eventId); ayni olay ikinci kez
/// uygulanmaz (@@unique). netRevenue OrderAttribution'da toplamdan turetilir.
model OrderAttributionRefund {
  id                 String   @id @default(cuid())
  storeId            String
  orderAttributionId String
  refundKey          String
  amountMinor        Int
  createdAt          DateTime @default(now())

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attribution OrderAttribution @relation(fields: [orderAttributionId], references: [id], onDelete: Cascade)

  @@unique([orderAttributionId, refundKey])
  @@index([storeId])
  @@index([orderAttributionId])
}

// ═══════════════════ TODO-161 (ADR-114…120) — Sponsored Product Management ═══════════════════
// Store-ici urun one cikarma. Organik search read-model'inin (ADR-079) skorunu DEGISTIRMEZ;
// sponsorlu enjeksiyon organik sonuc URETILDIKTEN SONRA ayri katmandadir (ADR-114/115). Aday
// UYGUNLUGU (ACTIVE + hasStock) + relevancy ProductSearchDocument uzerinden dogrulanir → pasif/
// stok-disi urun otomatik elenir (ADR-116). Olcum TODO-160 attribution KATMANINI yeniden
// kullanir; Influencer domain modeliyle BIRLESMEZ (ADR-091). Migration ADDITIVE.

/// Sponsorlu urun kampanyasi. placement = tek yerlesim tipi (HOME_SHOWCASE | SEARCH_RESULTS).
/// startsAt/endsAt UTC instant (timezone alani yalniz admin GORUNTU/DUZENLEME baglamidir, aktiflik
/// mantigini ETKILEMEZ — ADR-119). priority + createdAt deterministik cakisma sirasi. maxSlots =
/// kampanyanin tek sonuc kumesinde alabilecegi azami urun. targetCategoryId opsiyonel kategori
/// hedefleme (kategori silinince SetNull — kampanya kalir, hedef temizlenir).
model SponsoredProductCampaign {
  id               String                  @id @default(cuid())
  storeId          String
  name             String
  status           SponsoredCampaignStatus @default(ACTIVE)
  placement        SponsoredPlacementType
  startsAt         DateTime?
  endsAt           DateTime?
  priority         Int                     @default(0)
  maxSlots         Int                     @default(3)
  targetCategoryId String?
  timezone         String                  @default("Europe/Istanbul")
  // TODO-161A (ADR-124) — ADDITIVE. Varsayilan INTERNAL_PROMOTION → mevcut satirlar guard'dan
  // MUAF kalir (sifir regresyon). SPONSORED kampanya gecerli bir anlasmaya BAGLI olmadan
  // (ve `StoreSettings.allowUnpaidSponsoredCampaigns=false` iken) TESLIM EDILMEZ.
  commercialMode   SponsoredCommercialMode @default(INTERNAL_PROMOTION)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  store          Store                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  targetCategory ProductCategory?               @relation(fields: [targetCategoryId], references: [id], onDelete: SetNull)
  placements     SponsoredProductPlacement[]
  keywords       SponsoredTargetKeyword[]
  events         SponsoredProductEvent[]
  attributions   OrderSponsoredAttribution[]
  agreementLinks SponsorshipAgreementCampaign[]
  charges        SponsorshipCharge[]

  @@index([storeId])
  @@index([storeId, status, placement])
  // Aktif kampanya penceresi sorgusu (status + placement + tarih araligi).
  @@index([storeId, placement, startsAt, endsAt])
  @@index([storeId, createdAt])
  @@index([targetCategoryId])
}

/// Kampanya↔urun junction. position opsiyonel istenen slot; priority urun-ici sira. Urun
/// silinince Cascade (placement kalkar; attribution snapshot'i AYRI tabloda KORUNUR).
model SponsoredProductPlacement {
  id         String   @id @default(cuid())
  storeId    String
  campaignId String
  productId  String
  position   Int?
  priority   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  store    Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign SponsoredProductCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
  @@index([storeId])
  @@index([storeId, productId])
  @@index([campaignId])
}

/// SEARCH_RESULTS query allowlist. keyword NORMALIZE saklanir (locale-bagimsiz; arama query
/// normalize'i ile ayni zemin) → indeksli join ile aday cozumu. Ilgisiz hedefleme relevancy
/// kapisini (ADR-116) yine de gecmek zorundadir (yalniz allowlist yetmez).
model SponsoredTargetKeyword {
  id         String   @id @default(cuid())
  storeId    String
  campaignId String
  keyword    String
  createdAt  DateTime @default(now())

  store    Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign SponsoredProductCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, keyword])
  @@index([storeId, keyword])
  @@index([campaignId])
}

/// Funnel event'i (IMPRESSION | CLICK | CART). KVKK (ADR-106 deseni): ham IP/UA SAKLANMAZ,
/// yalniz tuzlu visitorIdHash. isBot bilinen bot UA'lar icin true (metrik paydalarindan DISLANIR).
/// Dedupe: ayni (visitorIdHash, placementId, type) kisa pencerede yeni satir ACMAZ. campaignId/
/// placementId/productId imzali token'dan gelir (istemci belirleyemez — ADR-118).
model SponsoredProductEvent {
  id            String                 @id @default(cuid())
  storeId       String
  campaignId    String
  placementId   String?
  productId     String
  type          SponsoredEventType
  placement     SponsoredPlacementType
  source        String?
  visitorIdHash String?
  sessionIdHash String?
  isBot         Boolean                @default(false)
  createdAt     DateTime               @default(now())

  store    Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign SponsoredProductCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([campaignId, type, createdAt])
  @@index([productId, type])
  // Rapid-repeat + unique-impression dedupe sorgusu (ADR-118).
  @@index([storeId, placementId, visitorIdHash, type, createdAt])
}

/// Sponsorlu siparis attribution SNAPSHOT'i (ADR-118, immutable). Siparis basina N (urun basina 1);
/// @@unique([orderId, campaignId, productId]). Gelir = siparis SATIRI (istemci belirleyemez).
/// Influencer attribution'dan BAGIMSIZ + BIRLIKTE var olabilir (ADR-120). net = gross - refunded.
model OrderSponsoredAttribution {
  id                   String   @id @default(cuid())
  storeId              String
  orderId              String
  campaignId           String
  placementId          String?
  productId            String
  attributedAt         DateTime @default(now())
  quantity             Int
  grossRevenueMinor    Int
  refundedRevenueMinor Int      @default(0)
  netRevenueMinor      Int
  currency             String
  snapshot             Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store    Store                             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order    Order                             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  campaign SponsoredProductCampaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  refunds  OrderSponsoredAttributionRefund[]

  @@unique([orderId, campaignId, productId])
  @@index([storeId])
  @@index([storeId, campaignId, attributedAt])
  @@index([orderId])
  @@index([productId])
}

/// Append-only sponsorlu iade defteri (ADR-118). refundKey idempotency anahtari (cancel:<orderId>
/// ya da refund:<eventId>); ayni olay ikinci kez uygulanmaz (@@unique). netRevenue toplamdan turetilir.
model OrderSponsoredAttributionRefund {
  id                          String   @id @default(cuid())
  storeId                     String
  orderSponsoredAttributionId String
  refundKey                   String
  amountMinor                 Int
  createdAt                   DateTime @default(now())

  store       Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  attribution OrderSponsoredAttribution @relation(fields: [orderSponsoredAttributionId], references: [id], onDelete: Cascade)

  @@unique([orderSponsoredAttributionId, refundKey])
  @@index([storeId])
  @@index([orderSponsoredAttributionId])
}

// ═══════════ TODO-161A (ADR-121…127) — Sponsorship Agreements, Billing & Settlement ═══════════
// Sponsor firma anlasmalari → donemsel mutabakat (settlement) → tahakkuk (charge) → tahsilat
// (payment). Sponsorlu GOSTERIM motoru (TODO-161) YENIDEN YAZILMAZ; yalniz `commercialMode`
// uzerinden ticari uygunluk kapisi eklenir (ADR-124). Migration ADDITIVE.
//
// Zincir: SponsorAccount → SponsorshipAgreement → (Campaign baglari) → SponsorshipSettlement
//         (metrik SNAPSHOT) → SponsorshipCharge (tahakkuk) → SponsorshipPayment (tahsilat).
//
// Para tamsayi minor unit; oranlar basis point. Tenant izolasyonu: her tabloda storeId + index.
// Defterler APPEND-ONLY: odeme iptali NEGATIF satirdir, silme/guncelleme YOKTUR.

/// Sponsor (reklamveren) firma cari kimligi — ADR-121. `Customer` (son-tuketici) ve `Influencer`
/// (TODO-160 is-ortagi) modelleriyle BIRLESMEZ: bunlar ticari/vergi/fatura alanlarini paylasmaz.
/// Vergi no + iletisim + fatura adresi HICBIR public response'a CIKMAZ (public uc yoktur).
model SponsorAccount {
  id             String               @id @default(cuid())
  storeId        String
  companyName    String
  contactName    String
  email          String
  phone          String?
  taxOffice      String?
  taxNumber      String?
  billingAddress String?
  status         SponsorAccountStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  store      Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agreements SponsorshipAgreement[]

  // Magaza icinde firma basina TEK cari (mukerrer sponsor kaydi engellenir).
  @@unique([storeId, companyName])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

/// Sponsorluk anlasmasi — para birimi ve VERGI ORANININ TEK OTORITESIDIR (ADR-127). Charge ve
/// Settlement bu degerleri OLUSTURMA aninda snapshot'lar → anlasma sonradan degisse gecmis belge
/// KAYMAZ. `unitPriceMinor` CPM/CPC/CPA icin birim bedel; `revenueSharePercentBp` yalniz
/// REVENUE_SHARE icin; `agreedAmountMinor` yalniz FIXED_FEE icin. `budgetExhaustedAt` settlement
/// FINALIZE aninda damgalanir (butce yalniz tahakkuk aninda bilinebilir → cron GEREKMEZ).
model SponsorshipAgreement {
  id                    String                      @id @default(cuid())
  storeId               String
  sponsorAccountId      String
  agreementNumber       String
  title                 String
  status                SponsorshipAgreementStatus  @default(DRAFT)
  startsAt              DateTime
  endsAt                DateTime
  currency              String
  pricingModel          SponsorshipPricingModel
  settlementPeriod      SponsorshipSettlementPeriod @default(CAMPAIGN_END)
  agreedAmountMinor     Int?
  unitPriceMinor        Int?
  revenueSharePercentBp Int?
  budgetLimitMinor      Int?
  paymentTermDays       Int                         @default(30)
  taxRateBp             Int                         @default(2000)
  signedAt              DateTime?
  // TODO-161A.2 (ADR-128) — ADDITIVE onay metası. `approvedAt`/`approvedByUserId` anlaşma ACTIVE
  // yapıldığında damgalanır ve ticari kampanya aktivasyon kapısının denetim izidir. Durum tek
  // otorite olmaya devam eder (guard `status = ACTIVE` bakar); bu alanlar KİM/NE ZAMAN kaydıdır.
  approvedAt            DateTime?
  approvedByUserId      String?
  documentUrl           String?
  notes                 String?
  budgetExhaustedAt     DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  store              Store                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sponsorAccount     SponsorAccount                 @relation(fields: [sponsorAccountId], references: [id], onDelete: Restrict)
  campaignLinks      SponsorshipAgreementCampaign[]
  settlements        SponsorshipSettlement[]
  charges            SponsorshipCharge[]
  payments           SponsorshipPayment[]
  advanceAllocations SponsorshipAdvanceAllocation[]

  @@unique([storeId, agreementNumber])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, sponsorAccountId])
  @@index([storeId, endsAt])
  @@index([sponsorAccountId])
}

/// Anlasma ↔ sponsorlu kampanya bagi. `@@unique([campaignId])`: bir kampanya en fazla BIR
/// anlasmaya baglidir — teslim guard'inin (ADR-124) deterministik olmasi icin zorunludur
/// (iki anlasmadan hangisinin uygunlugu gecerli sorusu OLUSMAZ). Yeniden baglamak icin once
/// mevcut bag COZULUR. `allocationAmountMinor` cok-kampanyali anlasmada bilgi amaclidir.
model SponsorshipAgreementCampaign {
  id                    String   @id @default(cuid())
  storeId               String
  agreementId           String
  campaignId            String
  allocationAmountMinor Int?
  createdAt             DateTime @default(now())

  store     Store                    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agreement SponsorshipAgreement     @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  campaign  SponsoredProductCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId])
  @@unique([agreementId, campaignId])
  @@index([storeId])
  @@index([agreementId])
}

/// Donemsel mutabakat + METRIK SNAPSHOT'i (ADR-123). `@@unique([agreementId, periodStart,
/// periodEnd])` ayni donemin IKI KEZ tahakkuk ettirilmesini DB SEVIYESINDE imkansiz kilar.
/// DRAFT yeniden hesaplanabilir ve silinebilir (donem serbest kalir); FINALIZED IMMUTABLE'dir
/// ve donemi KALICI isgal eder. Sonradan gelen event/iade FINALIZED kaydi SESSIZCE DEGISTIRMEZ →
/// duzeltme ayri bir ADJUSTMENT charge'idir. `snapshot` (Json) donem kapanisindaki ham metrik +
/// fiyat parametrelerini tasir (gecmis rapor yeniden HESAPLANMAZ).
model SponsorshipSettlement {
  id                    String                      @id @default(cuid())
  storeId               String
  agreementId           String
  periodKind            SponsorshipSettlementPeriod @default(MANUAL)
  periodStart           DateTime
  periodEnd             DateTime
  impressions           Int                         @default(0)
  billableImpressions   Int                         @default(0)
  clicks                Int                         @default(0)
  billableClicks        Int                         @default(0)
  orders                Int                         @default(0)
  grossRevenueMinor     Int                         @default(0)
  refundedRevenueMinor  Int                         @default(0)
  netRevenueMinor       Int                         @default(0)
  calculatedChargeMinor Int                         @default(0)
  currency              String
  pricingModel          SponsorshipPricingModel
  status                SponsorshipSettlementStatus @default(DRAFT)
  snapshot              Json
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  finalizedAt           DateTime?

  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agreement SponsorshipAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  charges   SponsorshipCharge[]

  @@unique([agreementId, periodStart, periodEnd])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, agreementId])
  @@index([agreementId, periodStart])
}

/// Tahakkuk (ic TICARI BELGE — resmi e-Fatura DEGILDIR, ADR-126). Matrah/vergi/toplam ve para
/// birimi olusturma aninda SNAPSHOT'lanir. `settlementId` tekildir → bir settlement'tan en fazla
/// BIR donemsel tahakkuk uretilir (idempotent). `idempotencyKey` ADJUSTMENT tekrarini engeller
/// (`refund-adj:<settlementId>:<refundedTotal>`). ADJUSTMENT tutari NEGATIF olabilir (alacak
/// azaltici). `OVERDUE` kalici DEGILDIR — `dueAt` + kalan bakiyeden TURETILIR (ADR-125).
model SponsorshipCharge {
  id               String                  @id @default(cuid())
  storeId          String
  agreementId      String
  campaignId       String?
  settlementId     String?
  chargeNumber     String
  chargeType       SponsorshipChargeType   @default(PERIOD)
  pricingModel     SponsorshipPricingModel
  periodStart      DateTime
  periodEnd        DateTime
  quantity         Int                     @default(0)
  unitPriceMinor   Int                     @default(0)
  subtotalMinor    Int
  taxRateBp        Int
  taxAmountMinor   Int
  totalAmountMinor Int
  currency         String
  status           SponsorshipChargeStatus @default(DRAFT)
  idempotencyKey   String?
  notes            String?
  generatedAt      DateTime                @default(now())
  issuedAt         DateTime?
  dueAt            DateTime
  finalizedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  store              Store                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agreement          SponsorshipAgreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  campaign           SponsoredProductCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  settlement         SponsorshipSettlement?         @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  payments           SponsorshipPayment[]
  advanceAllocations SponsorshipAdvanceAllocation[]

  @@unique([storeId, chargeNumber])
  @@unique([settlementId])
  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, agreementId])
  // Vade asimi (turetilmis OVERDUE) + alacak yaslandirma sorgusu.
  @@index([storeId, status, dueAt])
  @@index([agreementId])
  @@index([campaignId])
}

/// APPEND-ONLY tahsilat defteri (ADR-125). Kalan bakiye SUNUCUDA turetilir
/// (`total − Σ amountMinor`); istemci tutari OTORITE DEGILDIR. Asiri tahsilat REDDEDILIR.
/// Odeme iptali/iadesi = `reversalOfPaymentId` isaretli YENI NEGATIF satir; orijinal kayit
/// SILINMEZ/DEGISTIRILMEZ. Bir odeme en fazla BIR KEZ ters cevrilir (`@@unique`).
/// `recordedByUserId` islemi yapan platform admin'idir (denetim izi; AuditLog'a da yazilir).
model SponsorshipPayment {
  id                  String                   @id @default(cuid())
  storeId             String
  agreementId         String
  chargeId            String?
  amountMinor         Int
  currency            String
  method              SponsorshipPaymentMethod @default(BANK_TRANSFER)
  providerId          String?
  providerReference   String?
  manualReference     String?
  paidAt              DateTime
  recordedByUserId    String?
  reversalOfPaymentId String?
  reversalReason      String?
  idempotencyKey      String?
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  store              Store                          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agreement          SponsorshipAgreement           @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  charge             SponsorshipCharge?             @relation(fields: [chargeId], references: [id], onDelete: SetNull)
  reversalOf         SponsorshipPayment?            @relation("SponsorshipPaymentReversal", fields: [reversalOfPaymentId], references: [id], onDelete: Restrict)
  reversedBy         SponsorshipPayment?            @relation("SponsorshipPaymentReversal")
  advanceAllocations SponsorshipAdvanceAllocation[] @relation("AdvanceSourcePayment")

  @@unique([reversalOfPaymentId])
  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([storeId, agreementId])
  @@index([storeId, paidAt])
  @@index([chargeId])
  @@index([agreementId])
}

/// TODO-161A.2 (ADR-129) — APPEND-ONLY avans mahsup defteri.
///
/// Avans, `chargeId = null` olan bir `SponsorshipPayment`'tir → anlaşmaya bağlı, henüz bir
/// tahakkuka mahsup EDİLMEMİŞ nakittir ("kullanılabilir avans"). Avans OTOMATİK olarak
/// tahakkuklara dağıtılmaz (ADR-129, §gizli-mahsup-yasağı); yalnız kullanıcının açık bir
/// işlemiyle bu defterde bir satır olarak ilişkilendirilir.
///
/// Bir tahakkuğun "ödenmişi" = (o tahakkuğa doğrudan tahsilat toplamı) + (bu defterden o
/// tahakkuğa yapılan net mahsup). Bir avansın "kalan bakiyesi" = avans tutarı − bu defterden
/// o avanstan yapılan net mahsup. Ters kayıt = `reversalOfId` işaretli YENİ NEGATİF satır;
/// orijinal SİLİNMEZ/DEĞİŞTİRİLMEZ (aynı defter ilkesi — ADR-125). Bir mahsup en fazla BİR KEZ
/// ters çevrilir (`@@unique`). Aşırı mahsup (avans bakiyesi VEYA tahakkuk kalanı aşımı) REDDEDİLİR.
model SponsorshipAdvanceAllocation {
  id               String   @id @default(cuid())
  storeId          String
  agreementId      String
  advancePaymentId String
  chargeId         String
  amountMinor      Int
  currency         String
  reversalOfId     String?
  reversalReason   String?
  recordedByUserId String?
  idempotencyKey   String?
  notes            String?
  createdAt        DateTime @default(now())

  store          Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agreement      SponsorshipAgreement          @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  advancePayment SponsorshipPayment            @relation("AdvanceSourcePayment", fields: [advancePaymentId], references: [id], onDelete: Restrict)
  charge         SponsorshipCharge             @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  reversalOf     SponsorshipAdvanceAllocation? @relation("AdvanceAllocationReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy     SponsorshipAdvanceAllocation? @relation("AdvanceAllocationReversal")

  @@unique([reversalOfId])
  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([storeId, agreementId])
  @@index([advancePaymentId])
  @@index([chargeId])
}

/// TODO-161B (ADR-137/138/139) — Recently Viewed & Product Recommendations.
///
/// Kullanicinin/visitor'in gorduğu urunlerin sunucu-tarafi, KVKK-uyumlu kaydi. Guest kimligi HAM
/// IP/UA DEGIL; `visitorHash = HMAC(SESSION_SECRET, first-party visitor id)` (tracking-core.hashIdentifier).
/// Tam olarak BIR kimlik doludur (customerId XOR visitorHash — DB CHECK, migration). Aynı kimlik + product
/// icin TEK kayit (kısmi unique index, migration; Prisma @@unique NULL-distinct semantigi guest satirlari
/// dedupe etmez). Tekrar goruntulemede lastViewedAt=now + viewCount+1 (upsert). Kimlik basina max 50 kayit
/// (write yolunda prune + retention re-prune). 90-gun retention (TODO-161A.1 SAF altyapi reuse, ayri worker).
/// onDelete: Cascade → store/musteri/urun silinince otomatik temizlik (KVKK + orphan yok).
model RecentlyViewedProduct {
  id           String   @id @default(cuid())
  storeId      String
  customerId   String?
  visitorHash  String?
  productId    String
  lastViewedAt DateTime @default(now())
  viewCount    Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  // NOT: (storeId,customerId,productId) ve (storeId,visitorHash,productId) KISMI unique index'leri +
  // XOR-kimlik CHECK migration'da raw SQL ile eklenir (Prisma partial-unique/CHECK desteklemez).

  // Kimlik+zaman listeleme (en-yeni-once) sorgulari.
  @@index([storeId, customerId, lastViewedAt])
  @@index([storeId, visitorHash, lastViewedAt])
  // Urun silme/cascade + urun-bazli temizlik.
  @@index([productId])
}

/// TD-130 (ADR-145…148) — Recommendation Measurement ham davranis-event'i (AYRI domain).
/// Oneri yuzeylerinin (Recently Viewed / Similar Products) impression/click/add-to-cart olcumu.
/// SponsoredProductEvent deseni: productId/anchorProductId PLAIN string (Product FK YOK → minimal coupling,
/// event-store'da since-deleted urun referansi normaldir). Yalniz Store FK (Cascade). visitorHash/sessionHash
/// KVKK-uyumlu HMAC (ham IP/UA saklanmaz); bot/prefetch event URETMEZ (satir hic yazilmaz → isBot kolonu YOK).
/// customerId nullable plain (Customer FK yok — analytics; silinen musteri agregatlari korunur).
/// 180-gun retention: TODO-161A.1 SAF altyapisi (advisory lock + QueueJobLog) reuse; influencer/sponsored
/// RETENTION_TABLE_SPECS allowlist'ine DOKUNMAZ (ayri worker/jobType, ADR-148).
model RecommendationEvent {
  id              String   @id @default(cuid())
  storeId         String
  customerId      String?
  visitorHash     String?
  sessionHash     String?
  productId       String
  anchorProductId String?
  source          String
  placement       String
  eventType       String
  /// YALNIZ ADD_TO_CART idempotency'si icin istemci nonce'u; impression/click zaman-pencere dedupe kullanir.
  dedupeKey       String?
  createdAt       DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Store-scope + zaman (retention cutoff createdAt < cutoff; store listeleme).
  @@index([storeId, createdAt])
  // Admin funnel ozeti agregasyonu (eventType x source x placement, tarih araligi).
  @@index([storeId, eventType, source, placement, createdAt])
  // Urun-bazli kirilim + dedupe destegi.
  @@index([storeId, productId, eventType, createdAt])
  // Impression/click dedupe lookup: kimlik (visitorHash) + yuzey + urun + recency.
  @@index([storeId, source, placement, productId, visitorHash, eventType, createdAt])
  // ADD_TO_CART idempotency lookup.
  @@index([storeId, dedupeKey])
}

/// TODO-162 (ADR-205) — Home Discovery section-analytics ham event'i (AYRI domain).
/// Eligibility-driven keşif section'larının funnel ölçümü (section/card impression, product/CTA click,
/// add-to-cart). RecommendationEvent deseni: productId/campaignId/sponsoredCampaignId PLAIN string
/// (FK YOK → minimal coupling). Yalnız Store FK (Cascade). visitorHash/sessionHash KVKK-uyumlu HMAC
/// (ham IP/UA saklanmaz); **bot/prefetch VE hidden-section event ÜRETMEZ** (satır hiç yazılmaz → isBot
/// kolonu YOK; §22). Sponsored kartları AYRICA mevcut SponsoredProductEvent token ölçümünü kullanır
/// (bu tablo yalnız section-seviyesi funnel). sectionType = HomeSection.type; eligibilitySource =
/// SECTION_BOUNDS.source. Retention: TODO-161A.1 SAF altyapı reuse (ayrı jobType; ADR-205).
model HomeDiscoveryEvent {
  id                  String   @id @default(cuid())
  storeId             String
  customerId          String?
  visitorHash         String?
  sessionHash         String?
  /// HomeSection.id — hangi yönetilen section (analytics kırılımı için opak plain string).
  sectionId           String
  /// HomeSection.type (DISCOVERY_GRID, CONTINUE_BROWSING, …).
  sectionType         String
  /// Eligibility kararının türetildiği sinyal (SECTION_BOUNDS.source: RECENTLY_VIEWED, CART, …).
  eligibilitySource   String
  /// SECTION_IMPRESSION | CARD_IMPRESSION | PRODUCT_CLICK | CTA_CLICK | ADD_TO_CART.
  eventType           String
  /// Etkileşimli event'lerde ürün (impression'da null olabilir).
  productId           String?
  /// İlişkili kampanya (PERSONALIZED_DEALS/EDITORIAL/DAILY_DEALS) — plain string.
  campaignId          String?
  /// Sponsorlu kart — plain string (otoritatif ölçüm yine SponsoredProductEvent'te).
  sponsoredCampaignId String?
  /// Yerleşim: HOME (ileride genişleyebilir; String).
  placement           String
  /// YALNIZ ADD_TO_CART idempotency; impression/click zaman-pencere dedupe kullanır.
  dedupeKey           String?
  createdAt           DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Store-scope + zaman (retention cutoff createdAt < cutoff; store listeleme).
  @@index([storeId, createdAt])
  // Admin funnel özeti (eventType x sectionType x eligibilitySource, tarih aralığı).
  @@index([storeId, sectionType, eligibilitySource, eventType, createdAt])
  // Section-bazlı kırılım.
  @@index([storeId, sectionId, eventType, createdAt])
  // Impression/click dedupe lookup: kimlik + section + ürün + recency.
  @@index([storeId, sectionId, productId, visitorHash, eventType, createdAt])
  // ADD_TO_CART idempotency lookup.
  @@index([storeId, dedupeKey])
}

/// TODO-165A (ADR-253) — Product Data Governance: store-scoped Marka (Brand) varligi.
/// Product.brand (legacy serbest metin) DORMANT kalir; yeni yazma yolu bu tablo +
/// Product.brandId uzerinden gecer (servis katmani ileriki task). slug store icinde
/// tekildir; logo/kapak MediaAsset'e SetNull (marka silinince gorsel referansi kalkar,
/// gorselin kendisi SILINMEZ). Store silinince marka CASCADE kalkar.
model Brand {
  id             String      @id @default(cuid())
  storeId        String
  name           String
  slug           String
  description    String?
  logoMediaId    String?
  coverMediaId   String?
  websiteUrl     String?
  status         BrandStatus @default(ACTIVE)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  logoMedia  MediaAsset? @relation("BrandLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  coverMedia MediaAsset? @relation("BrandCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  products   Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, status])
}

/// TODO-165A (ADR-255) — Product Data Governance: Governed urun taksonomisi degeri
/// (ör. Malzeme=Pamuk, Sezon=Yaz). Her taksonomi degeri TAM OLARAK bir AttributeOption'i
/// "destekler" (1:1, attributeOptionId @unique) — governance/merchandising sunum katmani
/// bu tablodadir, EAV-degeri secimi hala AttributeOption uzerinden akar (mevcut yol
/// KIRILMAZ). slug create-sonrasi IMMUTABLE'dir (service guard; DB bunu zorlamaz).
/// parent → hiyerarsik taksonomi (ör. COLOR_FAMILY altinda ton kirilimlari); silinen
/// parent SetNull (cocuk taksonomi degeri KALIR, koksuz kalir). attributeOptionId → AttributeOption
/// Cascade (destekledigi option silinince — ki normalde Restrict'li kullanim satirlari
/// varsa zaten silinemez — taksonomi degeri de kalkar; orphan governance kaydi olmaz).
model ProductTaxonomyValue {
  id                String                @id @default(cuid())
  storeId           String
  type              ProductTaxonomyType
  name              String
  slug              String
  status            ProductTaxonomyStatus @default(ACTIVE)
  displayOrder      Int                   @default(0)
  metadata          Json                  @default("{}")
  parentId          String?
  attributeOptionId String                @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent          ProductTaxonomyValue?  @relation("TaxonomyParent", fields: [parentId], references: [id], onDelete: SetNull)
  children        ProductTaxonomyValue[] @relation("TaxonomyParent")
  attributeOption AttributeOption        @relation("TaxonomyBackingOption", fields: [attributeOptionId], references: [id], onDelete: Cascade)

  @@unique([storeId, type, slug])
  @@index([storeId, type, status])
}

// ─────────────────────── TODO-169 (ADR-269) — Returns Management Foundation ───────────────────────
// Müşteri iade talebi + Store Admin iade operasyonu. İade OrderLine + quantity seviyesinde modellenir;
// bir sipariş N ReturnRequest, her request N ReturnItem içerir. RefundIntent PENDING bu fazda finansa
// DOKUNMAZ (ADR-268 §5 OrderRefund defterinin upstream'i; TODO-170 işler). Tüm modeller additive.

// İade talebi yaşam döngüsü (saf state-machine `returns/status-map.ts`). Terminal durumlar immutable.
enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  AWAITING_SHIPMENT
  RETURN_SHIPPED
  RECEIVED
  INSPECTION_REQUIRED
  INSPECTED
  REFUND_PENDING
  REPLACEMENT_PENDING
  COMPLETED
  CANCELLED_BY_CUSTOMER
  EXPIRED
  CLOSED
}

// İlk faz çözüm türleri. STORE_CREDIT/GIFT_CARD_BALANCE/MANUFACTURER_SUPPORT/INSTANT_REFUND/
// EXCHANGE_WITH_DIFFERENT_PRODUCT gelecekte additive eklenecek (bkz. ADR-269 §1).
// TODO-175 (ADR-285): REFUND = nötr refund çözümü (destination ayrı refundDestination alanında).
// REFUND_TO_ORIGINAL_PAYMENT legacy olarak korunur (= REFUND + ORIGINAL_PAYMENT semantiği).
enum ReturnResolutionType {
  REFUND
  REFUND_TO_ORIGINAL_PAYMENT
  REPLACEMENT
}

// TODO-175 (ADR-285) — Refund geri ödeme hedefi. Yalnız external-origin bileşeni yönetir;
// credit-origin bileşen her zaman shopping balance'a restore edilir.
enum RefundDestination {
  ORIGINAL_PAYMENT
  SHOPPING_BALANCE
}

// Governed iade nedeni. TR/EN kullanıcı etiketleri i18n katmanındadır; enum stable/dildir.
enum ReturnReason {
  NO_LONGER_NEEDED
  ORDERED_BY_MISTAKE
  BETTER_PRICE_AVAILABLE
  NOT_AS_DESCRIBED
  WRONG_ITEM_RECEIVED
  DEFECTIVE_OR_NOT_WORKING
  DAMAGED_PRODUCT
  DAMAGED_PACKAGING
  MISSING_PARTS_OR_ACCESSORIES
  QUALITY_NOT_EXPECTED
  SIZE_OR_FIT_ISSUE
  DELIVERY_TOO_LATE
  UNAUTHORIZED_PURCHASE
  OTHER
}

// İade edilen ürünün fiziksel durumu (admin inceleme sonucu).
enum ReturnItemConditionStatus {
  NEW_UNOPENED
  OPENED_UNUSED
  USED
  DAMAGED
}

// Kalem inceleme sonucu.
enum ReturnInspectionResult {
  PASSED
  FAILED
  PARTIAL
}

// İnceleme sonrası stok kararı. YALNIZ RESTOCK_AS_SELLABLE inventory adjustment üretir.
// NOT (TODO-173/ADR-274): Bu enum yalnız KABUL EDİLEN (received) adedin stok kararıdır; reddedilen
// adet disposition'ı için GENİŞLETİLMEZ — o ayrı ReturnRejectedDisposition domain'idir (K1).
enum ReturnRestockDecision {
  RESTOCK_AS_SELLABLE
  RESTOCK_AS_DAMAGED
  DO_NOT_RESTOCK
  RETURN_TO_VENDOR
  DISPOSE
}

// TODO-173 (ADR-274) — Reddedilen (rejected) adet için disposition türü. ReturnRestockDecision'dan
// AYRIDIR (o kabul-adet-scoped stok kararıdır). Yalnız RETURN_TO_CUSTOMER reverse shipment üretebilir;
// diğerleri lojistik/audit no-op'tur (fiziksel aksiyon backend'de tetiklenmez).
enum ReturnRejectedDisposition {
  RETURN_TO_CUSTOMER
  DESTROY
  SEND_TO_VENDOR
  KEEP_IN_STORE
  CONTACT_CUSTOMER
}

// TODO-173 (ADR-274) — Disposition kaydının yaşam döngüsü. PENDING = karar verildi, quantity cap'e girer
// (rezerve). CANCELLED = quantity SERBEST bırakılır (cap'ten düşer, tekrar dispose edilebilir). COMPLETED =
// terminal/IMMUTABLE (değiştirilemez/iptal edilemez; RETURN_TO_CUSTOMER'da reverse shipment kesinleşince).
enum ReturnDispositionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// Durum geçişini yapan aktör tipi (append-only ReturnStatusHistory). AuditLog yalnız platformUserId
// taşıdığı için müşteri aktörü burada birinci-sınıf temsil edilir.
enum ReturnActorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

// RefundIntent durumu. PENDING = hesaplandı, henüz işlenmedi. CONSUMED (TODO-170) = ilk OrderRefund
// oluşturulurken AYNI tx'te atomik consume edildi (yalnız bir kez). CANCELLED (ADR-269 R1) = refund'suz
// terminal iade. PROCESSED legacy/kullanılmaz olarak KORUNUR (hiç yazılmadı; drop/rename YOK — TODO-170
// COMPLETED guard'ı artık SUCCEEDED OrderRefund'a bakar, intent PROCESSED'a değil).
enum RefundIntentStatus {
  PENDING
  PROCESSED
  CONSUMED
  CANCELLED
}

// Store-scoped iade numarası sayacı (OrderNumberCounter deseni). returnNumber üretimi create
// transaction'ı içinde bu satırın atomik increment'iyle yapılır.
model ReturnNumberCounter {
  storeId   String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// İade talebi aggregate kökü. version = optimistic concurrency (eşzamanlı admin aksiyonu koruması).
model ReturnRequest {
  id                          String               @id @default(cuid())
  storeId                     String
  orderId                     String
  customerId                  String
  returnNumber                String
  status                      ReturnStatus         @default(REQUESTED)
  resolutionType              ReturnResolutionType
  // Talep anında snapshot'lanan iade penceresi bitişi (teslim tarihi + returnWindowDays).
  returnWindowEndsAt          DateTime
  customerNote                String?
  // Müşteriye ASLA gösterilmez (serileştirmede allowlist dışı).
  adminNote                   String?
  // Reddetme zorunlu neden (status=REJECTED iken service tarafından zorunlu kılınır).
  rejectionReason             String?
  // İlk faz manuel iade kargosu: müşteri taşıyıcı + takip no girer; admin teslim alındı işaretler.
  returnCarrier               String?
  returnTrackingNumber        String?
  // Admin kararı: kargo ücreti iade edilsin mi (refund-calc shippingRefundMinor bunu esas alır).
  refundShipping              Boolean              @default(false)
  // TODO-175 (ADR-285) — müşterinin submit anında seçtiği IMMUTABLE refund hedefi. REFUND çözümünde
  // set edilir; REPLACEMENT'ta null. Admin değiştiremez; execution UI'ya değil bu snapshot'a güvenir.
  refundDestination           RefundDestination?
  refundDestinationSelectedBy ReturnActorType?
  refundDestinationSelectedAt DateTime?
  requestedAt                 DateTime             @default(now())
  reviewedAt                  DateTime?
  approvedAt                  DateTime?
  rejectedAt                  DateTime?
  shippedAt                   DateTime?
  receivedAt                  DateTime?
  inspectedAt                 DateTime?
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  version                     Int                  @default(0)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  store        Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order        Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer     Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        ReturnItem[]
  history      ReturnStatusHistory[]
  refundIntent RefundIntent?
  orderRefunds OrderRefund[]
  // TODO-173 (ADR-274) — reddedilen adet disposition'ları + bu iadeden doğan reverse shipment'lar.
  dispositions ReturnItemDisposition[]
  shipments    Shipment[]

  @@unique([storeId, returnNumber])
  @@index([storeId])
  @@index([orderId])
  @@index([customerId])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

// İade kalemi: bir OrderLine'ın belirli adedi. approvedQuantity/rejectedQuantity kısmi onay için.
model ReturnItem {
  id               String                     @id @default(cuid())
  storeId          String
  returnRequestId  String
  orderLineId      String
  quantity         Int
  reason           ReturnReason
  customerComment  String?
  conditionStatus  ReturnItemConditionStatus?
  inspectionResult ReturnInspectionResult?
  approvedQuantity Int?
  rejectedQuantity Int?
  restockDecision  ReturnRestockDecision?
  // Idempotent restock guard: RESTOCK_AS_SELLABLE bir kez uygulanınca set edilir.
  restockedAt      DateTime?
  restockBatchId   String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  store         Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest           @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderLine     OrderLine               @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  attachments   ReturnAttachment[]
  // TODO-173 (ADR-274) — bu kalemin reddedilen adedine ait disposition'lar + reverse shipment'lar.
  dispositions  ReturnItemDisposition[]
  shipments     Shipment[]

  @@index([storeId])
  @@index([returnRequestId])
  @@index([orderLineId])
}

// TODO-173 (ADR-274) — Reddedilen (rejected) adet için disposition kararı. ReturnRestockDecision'dan
// AYRI domain'dir (o kabul-adet-scoped). Kurallar (backend-enforce): yalnız rejectedQuantity üzerinde;
// Σ(quantity where status != CANCELLED, returnItemId) ≤ ReturnItem.rejectedQuantity; aynı reddedilen adet
// iki aktif disposition'da olamaz; RETURN_TO_CUSTOMER reverse shipment üretebilir (diğerleri no-op);
// CANCELLED quantity'yi serbest bırakır; COMPLETED immutable. Her karar append-only ReturnStatusHistory
// (eventType/metadata) + AuditLog üretir. reason internal'dır (müşteriye sızmaz). version = optimistic lock.
model ReturnItemDisposition {
  id                      String                    @id @default(cuid())
  storeId                 String
  returnRequestId         String
  returnItemId            String
  type                    ReturnRejectedDisposition
  quantity                Int
  status                  ReturnDispositionStatus   @default(PENDING)
  reason                  String?
  createdByPlatformUserId String?
  version                 Int                       @default(0)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  returnItem    ReturnItem    @relation(fields: [returnItemId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([returnRequestId])
  @@index([returnItemId])
  @@index([returnItemId, status])
}

// İade kalemi fotoğraf/kanıt eki. media PRIVATE (public /media'dan sunulmaz); mediaAsset Restrict
// (MEDIA_IN_USE guard'ına dahil — kullanımdaki medya silinemez).
model ReturnAttachment {
  id           String   @id @default(cuid())
  storeId      String
  returnItemId String
  mediaAssetId String
  type         String   @default("PHOTO")
  createdAt    DateTime @default(now())

  store      Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  returnItem ReturnItem @relation(fields: [returnItemId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([returnItemId])
  @@index([mediaAssetId])
}

// Append-only durum geçmişi (birincil audit trail). actorId scalar (customerId ya da platformUserId;
// FK DEĞİL — aktör silinse bile tarihsel kayıt korunur, ProductPriceChange deseni).
model ReturnStatusHistory {
  id              String          @id @default(cuid())
  storeId         String
  returnRequestId String
  fromStatus      ReturnStatus?
  toStatus        ReturnStatus
  actorType       ReturnActorType
  actorId         String?
  note            String?
  // TODO-172 (ADR-273) — YAPISAL audit (additive). Domain sorgusu artık note içindeki JSON'a
  // (substring/parse) BAĞLI DEĞİL: `eventType` exact-query edilebilir ayrımcı, `metadata` yapısal
  // payload. `note` yalnız insan-okur amaçlı kalır. PII/secret metadata'ya YAZILMAZ.
  eventType       String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([returnRequestId])
  // Son-90-gün hızlı iade sayımı (eventType exact + store + zaman) için.
  @@index([storeId, eventType, createdAt])
}

// Finansal iade NIYETI (immutable snapshot'lardan hesaplanır). status=PENDING bu fazda finansa
// DOKUNMAZ; TODO-170 Refund Ledger & Payment Reversal işler. 1-1 ReturnRequest.
model RefundIntent {
  id                  String             @id @default(cuid())
  storeId             String
  returnRequestId     String             @unique
  orderId             String
  paymentAttemptId    String?
  currency            String
  productRefundMinor  Int
  shippingRefundMinor Int
  taxRefundMinor      Int
  totalRefundMinor    Int
  status              RefundIntentStatus @default(PENDING)
  // R1 (ADR-269 hardening) — iade refund'suz terminal olunca (REJECTED/CANCELLED_BY_CUSTOMER/
  // EXPIRED/CLOSED-finansalsiz) PENDING intent AYNI tx'te CANCELLED yapilir; silinmez (append-only
  // finansal iz). Iptal ani + nedeni burada tutulur (audit/denetim; projection bunu saymaz).
  cancelledAt         DateTime?
  cancellationReason  String?
  // Store-scoped idempotency (çift intent koruması; TODO-170 provider çağrısı için de kullanılır).
  idempotencyKey      String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  returnRequest  ReturnRequest   @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: SetNull)
  orderRefunds   OrderRefund[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([orderId])
  @@index([status])
}

// ─── TODO-170 (ADR-272) Refund Ledger & Payment Reversal ───────────────────────────────────────
// OrderRefund = GERÇEKLEŞEN/DENENEN para hareketi (append-only ledger head). ReturnRequest onayı ≠
// refund; RefundIntent finansal talimattır; OrderRefund para hareketidir. Yalnız SUCCEEDED finanstan
// düşer. Partial + çoklu refund desteklenir; cap invariant (Σ SUCCEEDED + Σ active ≤ captured) order+
// currency düzeyinde advisory lock + version guard ile korunur.

enum OrderRefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

// Refund yürütme kipi. PROVIDER_AUTOMATIC = otomatik sağlayıcı çağrısı (bu fazda yalnız MOCK gerçek
// çalışır). MANUAL_OFFLINE = admin'in offline tamamladığı iade (banka havalesi ya da otomatik iade
// desteklemeyen gerçek kart sağlayıcısı) — banka/reference + açıklama zorunlu, güçlü yetki.
enum RefundExecutionMode {
  PROVIDER_AUTOMATIC
  MANUAL_OFFLINE
  INTERNAL_CREDIT // TODO-175 — SHOPPING_BALANCE external legi: provider yok, tx-içi SUCCEEDED
}

enum OrderRefundEventType {
  REQUESTED
  PROVIDER_SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  RETRY
  MANUAL_COMPLETED
  RECONCILED
  STATUS_QUERIED
  DUPLICATE_CALLBACK
}

enum OrderRefundActorType {
  ADMIN
  SYSTEM
  PROVIDER
}

// TODO-174A (ADR-280) — Refund'un menşei (pozitif, sorgu-dostu ayrım). ReturnRequest akışı
// (returnRequestId + refundIntentId DOLU) ile intent'siz cancellation akışı (her ikisi NULL)
// arasındaki farkı nullable-FK çıkarımına güvenmeden (SetNull kırılganlığı) taşır. Backfill:
// returnRequestId IS NULL → ORDER_CANCELLATION, aksi RETURN_REQUEST. Enum stable/dildir.
enum RefundOrigin {
  RETURN_REQUEST
  ORDER_CANCELLATION
}

model OrderRefund {
  id                              String               @id @default(cuid())
  storeId                         String
  orderId                         String
  // TODO-174A (ADR-280) — refund menşei; birleşik iade/refund görünürlüğü + admin kaynak filtresi.
  origin                          RefundOrigin         @default(RETURN_REQUEST)
  // TODO-175 (ADR-285) — external legin hedefi (ORIGINAL_PAYMENT: PSP; SHOPPING_BALANCE: INTERNAL_CREDIT).
  refundDestination               RefundDestination?
  returnRequestId                 String?
  refundIntentId                  String?
  paymentAttemptId                String
  // Otomatik yürütmede sağlayıcı; saf MANUAL_OFFLINE'da null.
  provider                        PaymentProviderType?
  executionMode                   RefundExecutionMode
  method                          PaymentMethodType
  status                          OrderRefundStatus    @default(PENDING)
  currency                        String
  // Inclusive KDV: taxRefundMinor productRefundMinor'ın İÇİNDEDİR (disclosure only; üstüne eklenmez).
  productRefundMinor              Int
  shippingRefundMinor             Int
  taxRefundMinor                  Int
  totalRefundMinor                Int
  providerRefundId                String?
  providerReference               String?
  failureCode                     String?
  failureMessage                  String?
  // MANUAL_OFFLINE alanları (banka havalesi / manuel kart iadesi).
  manualMethod                    PaymentManualMethod?
  manualReference                 String?
  manualNote                      String?
  manualCompletedByPlatformUserId String?
  // Server-üretimi idempotency (client belirlemez). İlk: order-refund:<intentId>; retry: ...:retry:<n>.
  idempotencyKey                  String
  requestedByPlatformUserId       String?
  requestedAt                     DateTime             @default(now())
  processingStartedAt             DateTime?
  completedAt                     DateTime?
  failedAt                        DateTime?
  cancelledAt                     DateTime?
  version                         Int                  @default(0)
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt

  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt     @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  returnRequest  ReturnRequest?     @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  refundIntent   RefundIntent?      @relation(fields: [refundIntentId], references: [id], onDelete: SetNull)
  events         OrderRefundEvent[]

  @@unique([storeId, idempotencyKey])
  // Aynı providerRefundId yalnız bir kez kabul edilir (duplicate callback koruması). NULL'lar distinct.
  @@unique([storeId, provider, providerRefundId])
  @@index([storeId])
  @@index([orderId])
  @@index([status])
  @@index([returnRequestId])
  @@index([refundIntentId])
  // Finans: SUCCEEDED refund'lar completedAt (store tz) ile gün×currency bucketlenir.
  @@index([storeId, status, completedAt])
  // TODO-174A: birleşik iade/refund listesi — store+menşe scope, requestedAt sıralama.
  @@index([storeId, origin, requestedAt])
}

// Append-only refund audit izi. actorId scalar (FK DEĞİL — aktör silinse bile korunur; ReturnStatusHistory
// deseni). storeId scalar (scoping; cascade OrderRefund üzerinden).
model OrderRefundEvent {
  id                String               @id @default(cuid())
  storeId           String
  orderRefundId     String
  type              OrderRefundEventType
  actorType         OrderRefundActorType
  actorId           String?
  amountMinor       Int
  providerReference String?
  metadata          Json?
  createdAt         DateTime             @default(now())

  orderRefund OrderRefund @relation(fields: [orderRefundId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([orderRefundId])
}

// =====================================================================================
// TODO-177 (ADR-289) — Product Support / Ürün Desteği (Faz 1)
// Order/ürün bağlamlı guided support: context → topic → deterministik soru ağacı →
// self-service → gerekirse ticket escalation. İzole domain; return/refund/cancel'a DOKUNMAZ.
// Şablonlar: returns (routes/attachment/status-history/counter) + recovery (lifecycle/SLA/assign).
// =====================================================================================

enum SupportTicketStatus {
  OPEN
  WAITING_STORE
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

// Durum geçişi / mesaj aktörü. ReturnActorType deseni; STORE_ADMIN (returns ADMIN yerine) —
// ürün kararı. actorId scalar (FK değil; aktör silinse bile tarihsel kayıt korunur).
enum SupportActorType {
  CUSTOMER
  STORE_ADMIN
  SYSTEM
}

// Guided flow başlangıç konuları (storefront 7 topic). Resolution + SLA bu eksende çözülür.
enum SupportTopic {
  PRODUCT_NOT_WORKING
  DAMAGED_OR_MISSING
  SETUP_USAGE
  WARRANTY_SERVICE
  PRODUCT_INFO
  INVOICE_DOCUMENT
  OTHER
}

// Kontrollü soru tipi seti (Faz 1). INFO/SELF_SERVICE_RESULT terminal düğümlerdir.
enum SupportQuestionType {
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  SHORT_TEXT
  LONG_TEXT
  INFO
  SELF_SERVICE_RESULT
}

enum SupportQuestionSetStatus {
  ACTIVE
  INACTIVE
}

// Versiyon yaşam döngüsü. Ticket yalnız PUBLISHED version'ı çalıştırır; PUBLISHED version
// tickets tarafından pinlenir (onDelete: Restrict) → tarihsel anlam sabit.
enum SupportQuestionSetVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Deterministik dallanma eşleşme türü. select/boolean sorularında bir DEFAULT zorunlu
// (publish-time validateQuestionGraph). İlk eşleşen (sortOrder) kazanır — expression engine YOK.
enum SupportTransitionMatchKind {
  OPTION
  BOOLEAN_TRUE
  BOOLEAN_FALSE
  DEFAULT
}

enum SupportTransitionAction {
  GO_TO_QUESTION
  GO_TO_RESULT
  ESCALATE
}

// Resolution mapping kapsamı (redundant iki tabloyu birleştirir; targetId polimorfik scalar:
// scope=PRODUCT→productId, scope=CATEGORY→categoryId). FK YOK → hedef silinirse satır INERT
// (resolution yalnız canlı product/category id'lerini eşler). Bkz. ADR-289 model re-eval.
enum SupportMappingScope {
  PRODUCT
  CATEGORY
}

// --- Question domain (platform-owned; store MUTATE EDEMEZ) ---

// Mantıksal soru seti konteyneri (global; storeId YOK). Mapping tabloları store'a bağlar.
model SupportQuestionSet {
  id          String                   @id @default(cuid())
  key         String                   @unique
  title       String
  description String?
  isDefault   Boolean                  @default(false)
  status      SupportQuestionSetStatus @default(ACTIVE)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  versions      SupportQuestionSetVersion[]
  mappings      SupportQuestionSetMapping[]
  topicDefaults SupportTopicDefault[]

  @@index([status])
}

// Versiyonlanmış içerik snapshot'ı. "Aktif" = en son PUBLISHED. Ticket bu satırın id'sini pinler.
model SupportQuestionSetVersion {
  id                      String                          @id @default(cuid())
  questionSetId           String
  version                 Int
  status                  SupportQuestionSetVersionStatus @default(DRAFT)
  publishedAt             DateTime?
  createdByPlatformUserId String?
  createdAt               DateTime                        @default(now())

  questionSet SupportQuestionSet          @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questions   SupportQuestion[]
  transitions SupportQuestionTransition[]
  tickets     SupportTicket[]

  @@unique([questionSetId, version])
  @@index([questionSetId, status])
}

model SupportQuestion {
  id                   String              @id @default(cuid())
  questionSetVersionId String
  key                  String
  type                 SupportQuestionType
  prompt               String
  helpText             String?
  sortOrder            Int                 @default(0)
  required             Boolean             @default(true)
  isEntry              Boolean             @default(false)
  createdAt            DateTime            @default(now())

  version             SupportQuestionSetVersion   @relation(fields: [questionSetVersionId], references: [id], onDelete: Cascade)
  options             SupportQuestionOption[]
  outgoingTransitions SupportQuestionTransition[] @relation("SupportTransitionFrom")
  incomingTransitions SupportQuestionTransition[] @relation("SupportTransitionTo")

  @@unique([questionSetVersionId, key])
  @@index([questionSetVersionId, sortOrder])
}

model SupportQuestionOption {
  id         String @id @default(cuid())
  questionId String
  key        String
  label      String
  sortOrder  Int    @default(0)

  question             SupportQuestion             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  matchedByTransitions SupportQuestionTransition[] @relation("SupportTransitionOption")

  @@unique([questionId, key])
  @@index([questionId])
}

// Deterministik dallanma kenarı. sortOrder'da ilk eşleşen kazanır. toQuestion/matchOption
// nullable (RESULT/ESCALATE veya DEFAULT'ta null); silinirse SetNull (validateQuestionGraph zaten korur).
model SupportQuestionTransition {
  id                   String                     @id @default(cuid())
  questionSetVersionId String
  fromQuestionId       String
  matchKind            SupportTransitionMatchKind
  matchOptionId        String?
  action               SupportTransitionAction
  toQuestionId         String?
  sortOrder            Int                        @default(0)

  version      SupportQuestionSetVersion @relation(fields: [questionSetVersionId], references: [id], onDelete: Cascade)
  fromQuestion SupportQuestion           @relation("SupportTransitionFrom", fields: [fromQuestionId], references: [id], onDelete: Cascade)
  toQuestion   SupportQuestion?          @relation("SupportTransitionTo", fields: [toQuestionId], references: [id], onDelete: SetNull)
  matchOption  SupportQuestionOption?    @relation("SupportTransitionOption", fields: [matchOptionId], references: [id], onDelete: SetNull)

  @@index([questionSetVersionId, fromQuestionId, sortOrder])
}

// --- Resolution mapping (3 tier de platform-owned) ---

// Tier 1 (PRODUCT) + Tier 2 (CATEGORY) birleşik tablo. Store-scoped; targetId polimorfik scalar.
model SupportQuestionSetMapping {
  id            String              @id @default(cuid())
  storeId       String
  scope         SupportMappingScope
  targetId      String
  topic         SupportTopic
  questionSetId String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  questionSet SupportQuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)

  @@unique([storeId, scope, targetId, topic])
  @@index([storeId, scope, topic])
  @@index([questionSetId])
}

// Tier 3 — platform DEFAULT (topic başına ZORUNLU tek satır; seed garanti eder). onDelete: Restrict
// → aktif default olan bir set silinemez (dead-end imkânsız invariant'ı DB-seviyesinde korunur).
model SupportTopicDefault {
  id            String       @id @default(cuid())
  topic         SupportTopic @unique
  questionSetId String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  questionSet SupportQuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Restrict)

  @@index([questionSetId])
}

// --- Ticket domain (store-scoped) ---

// Ticket aggregate kökü. Immutable snapshot alanları (context) + mutable lifecycle. version =
// optimistic concurrency (eşzamanlı store-admin aksiyonu koruması). questionSetVersionId pinlenir.
model SupportTicket {
  id                      String              @id @default(cuid())
  storeId                 String
  ticketNumber            String
  customerId              String
  orderId                 String
  orderLineId             String
  productId               String
  variantId               String?
  questionSetVersionId    String
  topic                   SupportTopic
  // Warranty snapshot (ticket açılışında; ADR-289 §7). anchorSource: SHIPMENT_DELIVERED|ORDER_CREATED|NONE.
  warrantyEndsAt          DateTime?
  warrantyAnchorSource    String?
  // Ulaşılan self-service çözüm (varsa) — escalation'da "attempted resolution" olarak taşınır.
  suggestedResolutionKey  String?
  suggestedResolutionText String?
  status                  SupportTicketStatus @default(OPEN)
  // Manuel assignment (round-robin YOK). scalar platformUserId (FK değil; recovery deseni).
  assigneePlatformUserId  String?
  reopenCount             Int                 @default(0)
  firstResponseAt         DateTime?
  resolvedAt              DateTime?
  closedAt                DateTime?
  lastActivityAt          DateTime            @default(now())
  version                 Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  store              Store                         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer           Customer                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order              Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine          OrderLine                     @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  product            Product                       @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant            ProductVariant?               @relation(fields: [variantId], references: [id], onDelete: Restrict)
  questionSetVersion SupportQuestionSetVersion     @relation(fields: [questionSetVersionId], references: [id], onDelete: Restrict)
  messages           SupportTicketMessage[]
  answers            SupportTicketAnswerSnapshot[]
  attachments        SupportTicketAttachment[]
  statusHistory      SupportTicketStatusHistory[]
  slaSnapshots       SupportSlaSnapshot[]

  @@unique([storeId, ticketNumber])
  @@index([storeId, status, lastActivityAt])
  @@index([storeId, assigneePlatformUserId])
  @@index([storeId, customerId])
  @@index([orderId])
  @@index([productId])
}

// Append-only konuşma. actor CUSTOMER|STORE_ADMIN|SYSTEM. storeId scalar (cascade ticket'tan).
model SupportTicketMessage {
  id        String           @id @default(cuid())
  storeId   String
  ticketId  String
  actorType SupportActorType
  actorId   String?
  body      String
  createdAt DateTime         @default(now())

  ticket      SupportTicket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportTicketAttachment[]

  @@index([storeId, ticketId, createdAt])
}

// Guided cevapların IMMUTABLE snapshot'ı — soru METNİ + tipi ile birlikte. Soru seti sonradan
// değişse bile eski ticket'ın anlamı SABİT (version + metin snapshot; ADR-289 §3).
model SupportTicketAnswerSnapshot {
  id             String              @id @default(cuid())
  storeId        String
  ticketId       String
  questionKey    String
  questionPrompt String
  questionType   SupportQuestionType
  answerValue    Json
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([storeId, ticketId, sortOrder])
}

// Ticket eki (ReturnAttachment birebir). media PRIVATE; mediaAsset Restrict (MEDIA_IN_USE guard).
// ticketMessageId null → escalation anında eklenen ek; dolu → belirli mesaja iliştirilmiş ek.
model SupportTicketAttachment {
  id              String   @id @default(cuid())
  storeId         String
  ticketId        String
  ticketMessageId String?
  mediaAssetId    String
  type            String   @default("PHOTO")
  createdAt       DateTime @default(now())

  ticket     SupportTicket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    SupportTicketMessage? @relation(fields: [ticketMessageId], references: [id], onDelete: SetNull)
  mediaAsset MediaAsset            @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([ticketId])
  @@index([mediaAssetId])
}

// Append-only durum geçmişi (ReturnStatusHistory deseni). eventType exact-queryable discriminator.
model SupportTicketStatusHistory {
  id         String               @id @default(cuid())
  storeId    String
  ticketId   String
  fromStatus SupportTicketStatus?
  toStatus   SupportTicketStatus
  actorType  SupportActorType
  actorId    String?
  eventType  String?
  note       String?
  metadata   Json?
  createdAt  DateTime             @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([storeId, ticketId, createdAt])
  @@index([storeId, eventType, createdAt])
}

// SLA döngü snapshot'ı. cycle=1 (açılış); reopen → cycle+1 (taze first-response + resolution).
// CANLI SLA = ticket için en yüksek cycle'lı satır. topic + policyLabel snapshot (audit).
model SupportSlaSnapshot {
  id                 String       @id @default(cuid())
  storeId            String
  ticketId           String
  cycle              Int
  topic              SupportTopic
  firstResponseDueAt DateTime
  resolutionDueAt    DateTime
  firstResponseMetAt DateTime?
  resolvedAt         DateTime?
  policyLabel        String?
  createdAt          DateTime     @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([storeId, ticketId, cycle])
  @@index([storeId, ticketId, cycle])
}

// Store-scoped ticket numarası sayacı (ReturnNumberCounter deseni; advisory-lock'lı increment).
model SupportTicketNumberCounter {
  storeId   String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ============================================================================
// TODO-178 — Store → Platform Request & Task Management
//
// Mağaza (Store Admin), platform tarafından yönetilen/müdahale gerektiren konular için talep açar;
// Platform Admin bunları operasyonel inbox olarak yönetir. Product Support (müşteri→mağaza) DEĞİLDİR:
// yalnız DESEN reuse edilir, hiçbir Support* tablosu/enum'ı paylaşılmaz. Request MAĞAZAYA aittir;
// assignee yalnız Platform user olabilir (scalar, FK değil); store user assignment YOKTUR.
// ============================================================================

// OPEN → TRIAGED → IN_PROGRESS ↔ WAITING_STORE → RESOLVED → CLOSED. CANCELLED YOK — kapanış nedeni
// PlatformRequestCloseReason ile taşınır (COMPLETED/WITHDRAWN_BY_STORE/NOT_ACTIONABLE/DUPLICATE/REJECTED).
enum PlatformRequestStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  WAITING_STORE
  RESOLVED
  CLOSED
}

// Platform-owned öncelik. Store DOĞRUDAN set edemez; storeImpact yalnız advisory'dir.
enum PlatformRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Store'un opsiyonel/advisory etki bildirimi (platform priority OTORİTESİ DEĞİL).
enum PlatformRequestStoreImpact {
  LOW
  MEDIUM
  HIGH
}

// CLOSED geçişinde zorunlu kapanış nedeni (ayrı CANCELLED status yerine).
enum PlatformRequestCloseReason {
  COMPLETED
  WITHDRAWN_BY_STORE
  NOT_ACTIONABLE
  DUPLICATE
  REJECTED
}

// Creator kimlik BACKING'i (auth gerçekliği). Bugün store admin = PlatformUser → PLATFORM_USER.
// Faz 2 tenant-auth gelince yeni satırlar STORE_USER olur (forward-compatible; TD-019).
enum PlatformRequestActorKind {
  PLATFORM_USER
  STORE_USER
}

// Domain-side aktör (mesaj yazarı / history aktörü). Product Support'un SupportActorType'ından
// AYRI enum (farklı domain, farklı değerler): STORE (talep eden mağaza) / PLATFORM / SYSTEM.
enum PlatformRequestActorType {
  STORE
  PLATFORM
  SYSTEM
}

// Mesaj/ek görünürlüğü — KESİN ayrım. INTERNAL asla store serializer/API yüzeyinden sızmaz.
enum PlatformRequestMessageVisibility {
  STORE_VISIBLE
  INTERNAL
}

// Polimorfik contextType/contextId YERİNE typed kind + immutable contextSnapshot (orphan/FK-integrity
// riski yok). İlk senaryolar platform-seviye config'e referans verir; gerçek store-satır referansı
// gerekirse ileride typed nullable FK eklenir.
enum PlatformRequestContextKind {
  NONE
  PLATFORM_TAXONOMY
  PLATFORM_CONTENT
  PLATFORM_POLICY
  STORE_DATA
  OTHER
}

// Platform-managed taxonomy (hardcoded enum DEĞİL, dynamic form engine DEĞİL). Deterministik seed
// (packages/config PLATFORM_REQUEST_CATEGORY_SEED tek kaynak). slaPolicyKey → platform-request SLA
// policy byKey; defaultPriority → yeni request'in başlangıç priority'si (store etkilemez).
model PlatformRequestCategory {
  id              String                  @id
  key             String                  @unique
  labelTr         String
  labelEn         String
  defaultPriority PlatformRequestPriority @default(NORMAL)
  slaPolicyKey    String                  @default("DEFAULT")
  active          Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  requests PlatformRequest[]

  @@index([active, sortOrder])
}

// GLOBAL (store-scoped DEĞİL) sıralı numara sayacı — singleton satır (id="global"). Numara tek başına
// global referanstır (PR-000001). Atomik increment advisory-lock ile Faz B servis katmanında.
model PlatformRequestNumberCounter {
  id        String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Aggregate kök. storeId = sahiplik. requestNumber GLOBAL unique. Immutable creator snapshot +
// immutable context snapshot; mutable lifecycle (status/priority/assignee). version = optimistic lock.
model PlatformRequest {
  id                     String                      @id @default(cuid())
  storeId                String
  requestNumber          String                      @unique
  categoryId             String
  // Kategori snapshot (immutable AUDIT; recategorize edilse bile "ilk açıldığı kategori" SABİT).
  // OPERASYONEL/current kategori `category` relation'ından okunur (TD-178-4). Snapshot bilingual
  // (TD-178-5): categoryLabel = TR, categoryLabelEn = EN.
  categoryKey            String
  categoryLabel          String
  categoryLabelEn        String                      @default("")
  subject                String
  description            String
  status                 PlatformRequestStatus       @default(OPEN)
  priority               PlatformRequestPriority     @default(NORMAL)
  // Store advisory (opsiyonel); platform priority otoritesini ETKİLEMEZ.
  storeImpact            PlatformRequestStoreImpact?
  // Yapısal bağlam (polimorfik FK yok): kind + immutable denormalize snapshot.
  contextKind            PlatformRequestContextKind  @default(NONE)
  contextSnapshot        Json?
  // Creator kimlik snapshot (forward-compatible; bugün PLATFORM_USER). actorId scalar (FK DEĞİL).
  createdByActorKind     PlatformRequestActorKind    @default(PLATFORM_USER)
  createdByActorId       String
  createdByName          String
  createdByEmail         String
  // Platform assignee (scalar platformUserId; FK DEĞİL; recovery/support deseni). Store asla atanmaz.
  assigneePlatformUserId String?
  reopenCount            Int                         @default(0)
  firstResponseAt        DateTime?
  resolvedAt             DateTime?
  closedAt               DateTime?
  closeReason            PlatformRequestCloseReason?
  lastActivityAt         DateTime                    @default(now())
  version                Int                         @default(0)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  store        Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     PlatformRequestCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  messages     PlatformRequestMessage[]
  attachments  PlatformRequestAttachment[]
  history      PlatformRequestHistory[]
  slaSnapshots PlatformRequestSlaSnapshot[]

  // Store listesi (own-store) erişim yolu.
  @@index([storeId, status, lastActivityAt])
  @@index([storeId, assigneePlatformUserId, status])
  // Platform cross-store inbox erişim yolu (storeId-prefix'siz; tüm mağazalar).
  @@index([status, priority, lastActivityAt])
  @@index([assigneePlatformUserId, status])
  @@index([categoryId])
}

// Append-only konuşma. STORE yazarları DAİMA STORE_VISIBLE (servis zorlar). INTERNAL yalnız PLATFORM.
model PlatformRequestMessage {
  id         String                           @id @default(cuid())
  storeId    String
  requestId  String
  authorType PlatformRequestActorType
  actorId    String?
  visibility PlatformRequestMessageVisibility @default(STORE_VISIBLE)
  body       String
  createdAt  DateTime                         @default(now())

  request     PlatformRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  attachments PlatformRequestAttachment[]

  @@index([storeId, requestId, createdAt])
  @@index([requestId, visibility, createdAt])
}

// Ek (SupportTicketAttachment deseni). media PRIVATE; mediaAsset Restrict (MEDIA_IN_USE guard).
// Görünürlük mesajınkiyle tutarlı olmalıdır (INTERNAL ek store'a asla servis edilmez).
model PlatformRequestAttachment {
  id           String                           @id @default(cuid())
  storeId      String
  requestId    String
  messageId    String?
  mediaAssetId String
  visibility   PlatformRequestMessageVisibility @default(STORE_VISIBLE)
  type         String                           @default("PHOTO")
  createdAt    DateTime                         @default(now())

  request    PlatformRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  message    PlatformRequestMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  mediaAsset MediaAsset              @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([requestId, visibility])
  @@index([mediaAssetId])
}

// Append-only history/audit (ReturnStatusHistory deseni). eventType exact-queryable discriminator;
// actorId scalar (FK yok; aktör silinse bile korunur). status/assignment/priority/category/reply olayları.
model PlatformRequestHistory {
  id         String                   @id @default(cuid())
  storeId    String
  requestId  String
  eventType  String
  fromStatus PlatformRequestStatus?
  toStatus   PlatformRequestStatus?
  actorType  PlatformRequestActorType
  actorId    String?
  note       String?
  metadata   Json?
  createdAt  DateTime                 @default(now())

  request PlatformRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([storeId, requestId, createdAt])
  @@index([eventType, createdAt])
}

// SLA döngü snapshot'ı. cycle=1 (açılış); reopen → cycle+1. CANLI SLA = en yüksek cycle. categoryKey +
// priority + policyLabel snapshot (audit). Breach persist EDİLMEZ — read-time türetilir (sla helpers).
model PlatformRequestSlaSnapshot {
  id                 String                  @id @default(cuid())
  storeId            String
  requestId          String
  cycle              Int
  categoryKey        String
  priority           PlatformRequestPriority
  firstResponseDueAt DateTime
  resolutionDueAt    DateTime
  firstResponseMetAt DateTime?
  resolvedAt         DateTime?
  policyLabel        String?
  createdAt          DateTime                @default(now())

  request PlatformRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, cycle])
  @@index([storeId, requestId, cycle])
}
