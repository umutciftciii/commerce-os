// Faz 2C-3 (ADR-072) — Bir ProductVariant'in KAYNAGI. MANUAL: kullanici/legacy elle olusturdu
// (mevcut TUM varyantlar migration default'u ile MANUAL). ATTRIBUTE_COMBINATION: Combination Engine
// recetesinden uretildi. Sistem YALNIZ ATTRIBUTE_COMBINATION varyantlari archive/restore eder;
// MANUAL varyantlara DOKUNMAZ (izolasyon). String magic value DEGIL — guclu tip.
enum VariantGenerationSource {
  MANUAL
  ATTRIBUTE_COMBINATION
}

// TODO-160A (ADR-110) — SKU'nun NASIL elde edildigi (governance kaynagi). generationSource'tan
// (varyant SATIRININ nasil olustugu) AYRIDIR: bir ATTRIBUTE_COMBINATION varyantinin SKU'su AUTO
// uretilmis olabilir; manuel bir varyantin SKU'su MANUAL girilmis olabilir. Default MANUAL: mevcut
// satirlar icin EN GUVENLI (otomatik regenerate onlari EZMEZ — manuel korumasi devrede sayilir).
//   AUTO     = deterministik generator uretti (regenerate serbest).
//   MANUAL   = kullanici acikca girdi/override etti (regenerate SESSIZCE degistirmez; force ister).
//   IMPORTED = disaridan (import) geldi; mevcut gecerli deger korunur.
enum SkuSource {
  AUTO
  MANUAL
  IMPORTED
}

