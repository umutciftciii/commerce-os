// TODO-174 (ADR-278) — Platform-tanımlı iptal nedeni taksonomisi (KATEGORİ). Store Admin DEĞİŞTİREMEZ.
// TR/EN etiketleri i18n katmanındadır; enum stable/dildir. Kaldırma = registry'de INACTIVE (enum değeri
// KALICI — geçmiş raporlar korunur). Not: "Teslimat adresini yanlış girdim" operasyonel düzeltilebilir
// olduğu için EKLENMEZ (ADR-278).
enum OrderCancellationReasonCategory {
  ORDER_MISTAKE
  PRICE_PROMOTION
  DELIVERY
  PAYMENT
  PRODUCT_DECISION
  OTHER
}

// TODO-174 (ADR-278) — Platform-tanımlı iptal nedeni taksonomisi (KOD). Kategori registry'de kod→kategori
// eşlemesiyle türetilir (packages/contracts CANCELLATION_REASON_TAXONOMY). OTHER seçiminde açıklama zorunlu.
enum OrderCancellationReason {
  // ORDER_MISTAKE
  WRONG_PRODUCT
  WRONG_VARIANT_SIZE_COLOR
  WRONG_QUANTITY
  DUPLICATE_ORDER
  ACCIDENTAL_ORDER
  // PRICE_PROMOTION
  FOUND_CHEAPER_ELSEWHERE
  COUPON_DISCOUNT_NOT_AS_EXPECTED
  TOTAL_PRICE_TOO_HIGH
  // DELIVERY
  DELIVERY_ESTIMATE_TOO_LONG
  SHIPPING_FEE_TOO_HIGH
  WILL_NOT_ARRIVE_IN_TIME
  // PAYMENT
  WRONG_PAYMENT_METHOD
  INSTALLMENT_OR_PAYMENT_OPTION_UNSUITABLE
  PAYMENT_CONCERN
  // PRODUCT_DECISION
  NO_LONGER_NEEDED
  CHANGED_MIND
  PREFER_DIFFERENT_PRODUCT
  // OTHER
  OTHER
}

// H-3 (ADR-189) — Rezervasyon lifecycle state machine. ACTIVE → {CONSUMED | RELEASED | EXPIRED}.
// Üç hedef terminal + immutable (terminal → ACTIVE imkânsız). CONSUMED: ödeme başarıyla satışa
// commit edildi. RELEASED: iptal/ödeme-iptali ile geri verildi. EXPIRED: TTL doldu, süpürücü bıraktı.
enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

// TODO-159E (ADR-094) — Ürün yorumu moderasyon durumu.
// PENDING: yeni/onaylı-iken-düzenlenen (public'te görünmez, aggregate dışı).
// APPROVED: yayında (public + aggregate). REJECTED: hiç yayınlanmadı.
// HIDDEN: onaylıydı, admin gizledi (aggregate dışı). Yorum SİLİNMEZ, durum değişir.
enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

