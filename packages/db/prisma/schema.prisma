// F3C.3 — DHL yanit netlestirmesi (ADR-045): DHL statusCode 0-7 normalize durumlari.
// createOrder = "DHL gonderi kaydi" (fiziksel teslim DEGIL). LABEL_PENDING = createbarcode
// HTTP 200 ama bos payload (shipmentId/barcodes yok). OUT_FOR_DELIVERY/DELIVERY_FAILED
// DHL kod 4/6. 6 (teslim edilemedi) FINAL DEGIL; takip gerektirir → ACTIVE sayilir.
enum ShipmentStatus {
  DRAFT
  ORDER_CREATED
  LABEL_PENDING
  LABEL_CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
  FAILED
}

// TODO-173 (ADR-274) — Kargo yönü. Mevcut tüm gönderiler (implicit outbound) default ile
// OUTBOUND_TO_CUSTOMER'a düşer (geri uyumlu). CUSTOMER_RETURN_TO_STORE bu fazda RESERVED
// domain value'dur (müşteri→mağaza iade kargosu bugün ReturnRequest string alanlarındadır;
// Shipment kaydı üretilmez — bkz. ADR-274 §FUTURE). STORE_RETURN_TO_CUSTOMER = incelemede
// reddedilen ürünün mağazadan müşteriye geri gönderimi (bu PR'ın gerçek akışı). Genel/belirsiz
// "OUTBOUND"/"RETURN" KULLANILMAZ; tüm shipment projeksiyon/guard'ları direction-aware'dir.
